# API Base URLs for Microservices
# Copy this file to .env and update the values for your environment

# Authentication Microservice (handles login, register, users, companies, tokens)
VITE_AUTH_API_BASE_URL=http://localhost:5000/api

# Basic Module Microservice (handles employees, positions, customers, suppliers, products, inventory, orders)
VITE_BASIC_API_BASE_URL=http://localhost:5083/api

# Projects Module Microservice
VITE_PROJECTS_API_BASE_URL=http://localhost:5144/api

# Accounting Module Microservice
VITE_ACCOUNTING_API_BASE_URL=http://localhost:5010/api

# Contracts Module Microservice
VITE_CONTRACTS_API_BASE_URL=http://localhost:5012/api

# Customer Support Module Microservice
VITE_CUSTOMER_SUPPORT_API_BASE_URL=http://localhost:5014/api

# Ecommerce Module Microservice
VITE_ECOMMERCE_API_BASE_URL=http://localhost:5016/api

# HR Module Microservice
VITE_HR_API_BASE_URL=http://localhost:5018/api

# Performance Evaluation Module Microservice
VITE_PERFORMANCE_EVALUATION_API_BASE_URL=http://localhost:5020/api

# POS Module Microservice
VITE_POS_API_BASE_URL=http://localhost:5022/api

# Plus Module Microservice
VITE_PLUS_API_BASE_URL=http://localhost:5024/api

# Social Network Module Microservice
VITE_SOCIAL_NETWORK_API_BASE_URL=http://localhost:5026/api

# Default Company ID for anonymous requests (used during login before company selection)
# Format: UUID (GUID)
VITE_DEFAULT_COMPANY_ID=00000000-0000-0000-0000-000000000000
