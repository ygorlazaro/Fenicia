    private async Task LoadFollowStateAsync()
    {
        if (isOwnProfileCheck || currentProfileId == Guid.Empty) return;
        try
        {
            var client = await CreateSocialClientAsync();
            var response = await client.GetAsync($"/friendship/isfollowing/{currentProfileId}/{Id}");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                if (bool.TryParse(json, out var following))
                {
                    isFollowing = following;
                }
            }
        }
        catch
        {
        }
    }

    private async Task LoadFollowCountsAsync()
    {
        try
        {
            var client = await CreateSocialClientAsync();
            var followersTask = client.GetAsync($"/friendship/followers/{Id}?page=1&perPage=1");
            var followingTask = client.GetAsync($"/friendship/following/{Id}?page=1&perPage=1");
            await Task.WhenAll(followersTask, followingTask);
            var followersResp = await followersTask;
            var followingResp = await followingTask;
            followerCount = ExtractTotal(followersResp);
            followingCount = ExtractTotal(followingResp);
        }
        catch
        {
        }
    }

    private static int ExtractTotal(HttpResponseMessage response)
    {
        if (!response.IsSuccessStatusCode) return 0;
        var json = response.Content.ReadAsStringAsync().Result;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.TryGetProperty("total", out var total))
            {
                return total.GetInt32();
            }
        }
        catch
        {
        }
        return 0;
    }

    private async Task ToggleFollowAsync()
    {
        if (isOwnProfileCheck || currentProfileId == Guid.Empty || followBusy) return;
        try
        {
            followBusy = true;
            var client = await CreateSocialClientAsync();
            if (isFollowing)
            {
                var response = await client.DeleteAsync($"/friendship/unfollow/{Id}");
                if (response.IsSuccessStatusCode)
                {
                    isFollowing = false;
                    followerCount = Math.Max(0, followerCount - 1);
                    Snackbar.Add("Deixou de seguir.", Severity.Success);
                }
                else
                {
                    var body = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Falha: {(int)response.StatusCode} {body}", Severity.Error);
                }
            }
            else
            {
                var command = new { TargetProfileId = Id };
                var json = System.Text.Json.JsonSerializer.Serialize(command);
                var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
                var response = await client.PostAsync("/friendship/follow", content);
                if (response.IsSuccessStatusCode)
                {
                    isFollowing = true;
                    followerCount++;
                    Snackbar.Add("Seguindo!", Severity.Success);
                }
                else
                {
                    var body = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Falha: {(int)response.StatusCode} {body}", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
        }
        finally
        {
            followBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string? ParseUserRole(string token)
    {
        try
        {
            var parts = token.Split('.');
            if (parts.Length < 2) return null;
            var payload = parts[1].Replace('-', '+').Replace('_', '/');
            switch (payload.Length % 4)
            {
                case 2: payload += "=="; break;
                case 3: payload += "="; break;
            }
            using var doc =
                System.Text.Json.JsonDocument.Parse(System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(payload)));
            if (doc.RootElement.TryGetProperty("role", out var roleElement))
            {
                var roleJson = roleElement.GetString();
                if (!string.IsNullOrEmpty(roleJson))
                {
                    if (roleJson.StartsWith("["))
                    {
                        var roles = System.Text.Json.JsonSerializer.Deserialize<List<string>>(roleJson);
                        return roles is { Count: > 0 } ? roles[0] : null;
                    }
                    return roleJson;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Profile] Parse role error: {ex.GetType().Name}: {ex.Message}");
        }
        return null;
    }

    private static Color GetStatusColor(string status)
    {
        return status.ToLower() switch
        {
            "active" => Color.Success,
            "pending" => Color.Warning,
            "cancelled" => Color.Error,
            _ => Color.Default
        };
    }

