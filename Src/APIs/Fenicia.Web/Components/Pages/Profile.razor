@page "/profile"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IAuthStateService AuthState
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext

<PageTitle>My Profile - Fenicia</PageTitle>

<MainLayout>
    <div style="max-width: 900px; margin: 50px auto; padding: 0 20px;">
        @if (isLoading)
        {
            <div style="padding: 20px; border: 1px solid #e0e0e0; border-radius: 4px; background: white; text-align: center;">
                <p>Loading profile...</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div style="padding: 20px; border: 1px solid #f8d7da; border-radius: 4px; background: #f8d7da; color: #721c24;">
                <p>@errorMessage</p>
            </div>
        }
        else if (profile != null)
        {
            <div style="padding: 30px; border: 1px solid #e0e0e0; border-radius: 4px; background: white; margin-bottom: 20px;">
                <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 30px;">
                    <div style="width: 80px; height: 80px; border-radius: 50%; background: #4f46e5; color: white; display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: bold;">
                        @profile.Name.Substring(0, 1).ToUpper()
                    </div>
                    <div>
                        <h2 style="margin: 0; font-size: 1.5rem;">@profile.Name</h2>
                        <p style="margin: 5px 0 0; color: #666;">@profile.Email</p>
                        <p style="margin: 5px 0 0; color: #999; font-size: 0.85rem;">ID: @profile.Id</p>
                    </div>
                </div>
            </div>

            @if (profile.Subscriptions != null && profile.Subscriptions.Any())
            {
                <h3 style="font-size: 1.2rem; color: #333; margin-bottom: 15px;">My Subscriptions</h3>
                @foreach (var subscription in profile.Subscriptions)
                {
                    <div style="padding: 20px; border: 1px solid #e0e0e0; border-radius: 4px; background: white; margin-bottom: 15px;">
                        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 12px;">
                            <div>
                                <h4 style="margin: 0; color: #333;">@subscription.CompanyName</h4>
                                <p style="margin: 4px 0 0; color: #666; font-size: 0.9rem;">
                                    Status: <span style="font-weight: 600; color: @GetStatusColor(subscription.Status);">@subscription.Status</span>
                                </p>
                            </div>
                            <span style="font-size: 0.85rem; color: #999;">
                                @subscription.StartDate.ToString("yyyy-MM-dd")
                                @if (subscription.EndDate.HasValue)
                                {
                                    <span> - @subscription.EndDate.Value.ToString("yyyy-MM-dd")</span>
                                }
                            </span>
                        </div>
                        @if (subscription.Modules != null && subscription.Modules.Any())
                        {
                            <div style="border-top: 1px solid #e0e0e0; padding-top: 12px;">
                                <p style="margin: 0 0 8px; font-size: 0.9rem; color: #666; font-weight: 600;">Modules:</p>
                                <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                                    @foreach (var module in subscription.Modules)
                                    {
                                        <span style="padding: 4px 12px; background: #eef2ff; color: #4f46e5; border-radius: 12px; font-size: 0.85rem;">
                                            @module.Name
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div style="padding: 20px; border: 1px solid #e0e0e0; border-radius: 4px; background: white; text-align: center;">
                    <p style="color: #666;">No subscriptions yet.</p>
                    <a href="/shop" style="color: #4f46e5; text-decoration: none; margin-top: 10px; display: inline-block;">Browse modules in the shop</a>
                </div>
            }
        }
    </div>
</MainLayout>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private ProfileDto? profile;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var isAuthenticated = await AuthState.IsAuthenticatedAsync();
            if (!isAuthenticated)
            {
                NavigationManager.NavigateTo("/login");
                return;
            }

            await LoadProfileAsync();
        }
    }

    private async Task LoadProfileAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            var token = await CompanyContext.GetTokenAsync();
            var client = HttpClientFactory.CreateClient("FeniciaAuth");

            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var selectedCompanyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (selectedCompanyId.HasValue)
            {
                client.DefaultRequestHeaders.Remove("CompanyId");
                client.DefaultRequestHeaders.Add("CompanyId", selectedCompanyId.Value.ToString());
                Console.WriteLine($"[Profile] Added CompanyId header: {selectedCompanyId.Value}");
            }
            else
            {
                Console.WriteLine("[Profile] No company selected, CompanyId header not set");
            }

            var response = await client.GetAsync("/subscription");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"[Profile] Subscription response: {json}");
                profile = System.Text.Json.JsonSerializer.Deserialize<ProfileDto>(json,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            }
            else
            {
                errorMessage = $"Failed to load profile: {(int)response.StatusCode} {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            Console.WriteLine($"[Profile] Load error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string GetStatusColor(string status)
    {
        return status.ToLower() switch
        {
            "active" => "#155724",
            "pending" => "#856404",
            "cancelled" => "#721c24",
            _ => "#333"
        };
    }

    private class ProfileDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public List<UserCompanyDto> Companies { get; set; } = [];
        public List<UserSubscriptionDto> Subscriptions { get; set; } = [];
    }

    private class UserCompanyDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Cnpj { get; set; } = string.Empty;
    }

    private class UserSubscriptionDto
    {
        public Guid Id { get; set; }
        public Guid CompanyId { get; set; }
        public string CompanyName { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public DateTime StartDate { get; set; }
        public DateTime? EndDate { get; set; }
        public List<UserModuleDto> Modules { get; set; } = [];
    }

    private class UserModuleDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
    }
}