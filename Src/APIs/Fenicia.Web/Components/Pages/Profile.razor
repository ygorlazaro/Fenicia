@page "/profile"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IAuthStateService AuthState
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext

<PageTitle>Meu Perfil - Fenicia</PageTitle>

<MainLayout>
    <section class="section">
        <div class="container">
            @if (isLoading)
            {
                <div class="notification is-info is-light">
                    <p>Carregando perfil...</p>
                </div>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="notification is-danger">
                    <p>@errorMessage</p>
                </div>
            }
            else if (profile != null)
            {
                <div class="card">
                    <div class="card-content">
                        <div class="level">
                            <div class="level-left">
                                <div class="level-item">
                                    <div class="avatar">
                                        @profile.Name.Substring(0, 1).ToUpper()
                                    </div>
                                    <div class="ml-4">
                                        <h2 class="title is-4">@profile.Name</h2>
                                        <p class="subtitle is-6">@profile.Email</p>
                                        <p class="is-size-7 has-text-grey">ID: @profile.Id</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mt-5">
                    <div class="card-content">
                        <h3 class="title is-4">Minhas Assinaturas</h3>

                        @if (profile.Subscriptions != null && profile.Subscriptions.Any())
                        {
                            @foreach (var subscription in profile.Subscriptions)
                            {
                                <div class="box mb-4">
                                    <div class="level">
                                        <div class="level-left">
                                            <div>
                                                <h4 class="title is-5">@subscription.CompanyName</h4>
                                                <p class="subtitle is-7">
                                                    Status: <span class="tag @GetStatusTagClass(subscription.Status)">@subscription.Status</span>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="level-right">
                                            <div class="is-size-7 has-text-grey">
                                                @subscription.StartDate.ToString("yyyy-MM-dd")
                                                @if (subscription.EndDate.HasValue)
                                                {
                                                    <span> - @subscription.EndDate.Value.ToString("yyyy-MM-dd")</span>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    @if (subscription.Modules != null && subscription.Modules.Any())
                                    {
                                        <div class="tags mt-3">
                                            @foreach (var module in subscription.Modules)
                                            {
                                                <span class="tag is-info is-light">@module.Name</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="notification is-warning is-light">
                                <p>Nenhuma assinatura ainda.</p>
                                <a href="/shop" class="has-text-link"><strong>Ver módulos na loja</strong></a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </section>
</MainLayout>

<style>
    .avatar {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #3f51b5;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        font-weight: bold;
    }
</style>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private ProfileDto? profile;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var isAuthenticated = await AuthState.IsAuthenticatedAsync();
            if (!isAuthenticated)
            {
                NavigationManager.NavigateTo("/login");
                return;
            }

            await LoadProfileAsync();
        }
    }

    private async Task LoadProfileAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            var token = await CompanyContext.GetTokenAsync();
            var client = HttpClientFactory.CreateClient("FeniciaAuth");

            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var selectedCompanyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (selectedCompanyId.HasValue)
            {
                client.DefaultRequestHeaders.Remove("CompanyId");
                client.DefaultRequestHeaders.Add("CompanyId", selectedCompanyId.Value.ToString());
            }

            var response = await client.GetAsync("/subscription");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                profile = System.Text.Json.JsonSerializer.Deserialize<ProfileDto>(json,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            }
            else
            {
                errorMessage = $"Falha ao carregar perfil: {(int)response.StatusCode} {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string GetStatusTagClass(string status)
    {
        return status.ToLower() switch
        {
            "active" => "is-success",
            "pending" => "is-warning",
            "cancelled" => "is-danger",
            _ => "is-light"
        };
    }

    private class ProfileDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public List<UserCompanyDto> Companies { get; set; } = [];
        public List<UserSubscriptionDto> Subscriptions { get; set; } = [];
    }

    private class UserCompanyDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Cnpj { get; set; } = string.Empty;
    }

    private class UserSubscriptionDto
    {
        public Guid Id { get; set; }
        public Guid CompanyId { get; set; }
        public string CompanyName { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public DateTime StartDate { get; set; }
        public DateTime? EndDate { get; set; }
        public List<UserModuleDto> Modules { get; set; } = [];
    }

    private class UserModuleDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
    }
}
