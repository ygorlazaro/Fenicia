    private async Task SaveProfileAsync()
    {
        if (socialProfile is null) return;
        try
        {
            isSaving = true;

            var client = await CreateSocialClientAsync();
            var updateCommand = new
            {
                Id = socialProfile.Id,
                UserName = editModel.UserName,
                Bio = editModel.Bio,
                ImageUrl = editModel.ImageUrl,
                Website = editModel.Website,
                Location = editModel.Location,
                Phone = editModel.Phone,
                BirthDate = editModel.BirthDateValue,
            };

            var json = System.Text.Json.JsonSerializer.Serialize(updateCommand);
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
            var response = await client.PatchAsync($"/socialProfile/{socialProfile.Id}", content);

            if (response.IsSuccessStatusCode)
            {
                var responseJson = await response.Content.ReadAsStringAsync();
                socialProfile = System.Text.Json.JsonSerializer.Deserialize<SocialProfileDto>(responseJson,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                editDialogVisible = false;
                Snackbar.Add("Perfil atualizado com sucesso!", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Falha ao atualizar: {(int)response.StatusCode}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

