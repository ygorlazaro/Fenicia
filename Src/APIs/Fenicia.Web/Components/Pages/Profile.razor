    private static string FormatRelativeTime(DateTime date)
    {
        var diff = DateTime.UtcNow - date.ToUniversalTime();
        if (diff.TotalSeconds < 60) return "agora";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}min";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d";
        return date.ToString("dd MMM yyyy");
    }

    private async Task LoadPostsAsync()
    {
        try
        {
            isLoadingPosts = true;
            var client = await CreateSocialClientAsync();
            var response = await client.GetAsync($"/feed/socialProfile/{Id}?page=1&perPage=20");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var items = System.Text.Json.JsonSerializer.Deserialize<List<PostDto>>(json,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                posts = items ?? [];

                if (currentProfileId != Guid.Empty)
                {
                    foreach (var post in posts)
                    {
                        try
                        {
                            var likeResponse = await client.GetAsync($"/like/isfollowed/{currentProfileId}/{post.Id}");
                            if (likeResponse.IsSuccessStatusCode)
                            {
                                var likeJson = await likeResponse.Content.ReadAsStringAsync();
                                if (bool.TryParse(likeJson, out var liked))
                                {
                                    post.IsLikedByMe = liked;
                                }
                            }
                        }
                        catch
                        {
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar posts: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoadingPosts = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleLikeAsync(PostDto post)
    {
        if (likingFeedId == post.Id || currentProfileId == Guid.Empty) return;
        try
        {
            likingFeedId = post.Id;
            var client = await CreateSocialClientAsync();

            if (post.IsLikedByMe)
            {
                var response = await client.DeleteAsync($"/like/{post.Id}");
                if (response.IsSuccessStatusCode)
                {
                    post.IsLikedByMe = false;
                    post.TotalLikes = Math.Max(0, post.TotalLikes - 1);
                }
                else
                {
                    Snackbar.Add($"Falha ao descurtir: {(int)response.StatusCode}", Severity.Error);
                }
            }
            else
            {
                var command = new { FeedId = post.Id };
                var json = System.Text.Json.JsonSerializer.Serialize(command);
                var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
                var response = await client.PostAsync("/like", content);
                if (response.IsSuccessStatusCode)
                {
                    post.IsLikedByMe = true;
                    post.TotalLikes++;
                }
                else
                {
                    var body = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Falha ao curtir: {(int)response.StatusCode} {body}", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
        }
        finally
        {
            likingFeedId = null;
            await InvokeAsync(StateHasChanged);
        }
    }

