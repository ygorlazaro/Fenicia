@page "/profile"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IAuthStateService AuthState
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext

<PageTitle>Meu Perfil - Fenicia</PageTitle>

<MainLayout>
    <MudGrid>
        <MudItem xs="12">
            @if (isLoading)
            {
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="ma-16" Size="Size.Large" />
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
            }
            else if (profile != null)
            {
                <MudPaper Elevation="2" Class="pa-6 mb-6">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                        <MudAvatar Color="Color.Primary" Size="Size.Large">@profile.Name.Substring(0, 1).ToUpper()</MudAvatar>
                        <div>
                            <MudText Typo="Typo.h5">@profile.Name</MudText>
                            <MudText Typo="Typo.body1" Color="Color.Default">@profile.Email</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Default">ID: @profile.Id</MudText>
                        </div>
                    </MudStack>
                </MudPaper>

                <MudPaper Elevation="2" Class="pa-6">
                    <MudText Typo="Typo.h5" Class="mb-4">Minhas Assinaturas</MudText>

                    @if (profile.Subscriptions != null && profile.Subscriptions.Any())
                    {
                        @foreach (var subscription in profile.Subscriptions)
                        {
                            <MudPaper Elevation="1" Class="pa-4 mb-4">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                                    <div>
                                        <MudText Typo="Typo.h6">@subscription.CompanyName</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Default">
                                            Status: <MudBadge Color="@GetStatusColor(subscription.Status)" Class="pa-2">@subscription.Status</MudBadge>
                                        </MudText>
                                    </div>
                                    <MudText Typo="Typo.caption" Color="Color.Default">
                                        @subscription.StartDate.ToString("yyyy-MM-dd")
                                        @if (subscription.EndDate.HasValue)
                                        {
                                            <span> - @subscription.EndDate.Value.ToString("yyyy-MM-dd")</span>
                                        }
                                    </MudText>
                                </MudStack>

                                @if (subscription.Modules != null && subscription.Modules.Any())
                                {
                                    <MudStack Row="true" Spacing="1" Class="mt-3" Wrap="Wrap.Wrap">
                                        @foreach (var module in subscription.Modules)
                                        {
                                            <MudBadge Color="Color.Info" Class="pa-2">@module.Name</MudBadge>
                                        }
                                    </MudStack>
                                }
                            </MudPaper>
                        }
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Warning">
                            Nenhuma assinatura ainda. <MudLink Href="/shop" Color="Color.Primary">Ver módulos na loja</MudLink>
                        </MudAlert>
                    }
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
</MainLayout>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private ProfileDto? profile;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var isAuthenticated = await AuthState.IsAuthenticatedAsync();
            if (!isAuthenticated)
            {
                NavigationManager.NavigateTo("/login");
                return;
            }

            await LoadProfileAsync();
        }
    }

    private async Task LoadProfileAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            var token = await CompanyContext.GetTokenAsync();
            var client = HttpClientFactory.CreateClient("FeniciaAuth");

            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var selectedCompanyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (selectedCompanyId.HasValue)
            {
                client.DefaultRequestHeaders.Remove("CompanyId");
                client.DefaultRequestHeaders.Add("CompanyId", selectedCompanyId.Value.ToString());
            }

            var response = await client.GetAsync("/subscription");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                profile = System.Text.Json.JsonSerializer.Deserialize<ProfileDto>(json,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            }
            else
            {
                errorMessage = $"Falha ao carregar perfil: {(int)response.StatusCode} {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static Color GetStatusColor(string status)
    {
        return status.ToLower() switch
        {
            "active" => Color.Success,
            "pending" => Color.Warning,
            "cancelled" => Color.Error,
            _ => Color.Default
        };
    }

    private class ProfileDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public List<UserCompanyDto> Companies { get; set; } = [];
        public List<UserSubscriptionDto> Subscriptions { get; set; } = [];
    }

    private class UserCompanyDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Cnpj { get; set; } = string.Empty;
    }

    private class UserSubscriptionDto
    {
        public Guid Id { get; set; }
        public Guid CompanyId { get; set; }
        public string CompanyName { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public DateTime StartDate { get; set; }
        public DateTime? EndDate { get; set; }
        public List<UserModuleDto> Modules { get; set; } = [];
    }

    private class UserModuleDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
    }
}
