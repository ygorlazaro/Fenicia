@page "/productcategories"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext
@inject IAuthStateService AuthState
@inject NavigationManager NavigationManager

<PageTitle>Categorias de Produtos - Fenicia</PageTitle>

<MainLayout>
    <section class="section">
        <div class="container">
            @if (!isLoggedIn)
            {
                <div class="notification is-danger">
                    <p>Faça login para gerenciar categorias de produtos.</p>
                </div>
            }
            else if (isLoading)
            {
                <div class="notification is-info is-light">
                    <p>Carregando categorias...</p>
                </div>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="notification is-danger">
                    <p>@errorMessage</p>
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-content">
                        <div class="level">
                            <div class="level-left">
                                <div>
                                    <h2 class="title is-4">Categorias de Produtos</h2>
                                    <p class="subtitle is-6">Gerencie suas categorias de produtos</p>
                                </div>
                            </div>
                            <div class="level-right">
                                <button class="button is-primary" @onclick="OpenAddModal">
                                    <span class="icon is-small">
                                        <i class="fas fa-plus"></i>
                                    </span>
                                    <span>Adicionar Categoria</span>
                                </button>
                            </div>
                        </div>

                        @if (categories == null || categories.Count == 0)
                        {
                            <div class="notification is-warning is-light">
                                <p>Nenhuma categoria encontrada. Crie sua primeira categoria!</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-container">
                                <table class="table is-fullwidth is-hoverable">
                                    <thead>
                                        <tr>
                                            <th>Nome</th>
                                            <th class="has-text-right">Ações</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var category in categories)
                                        {
                                            <tr>
                                                <td>@category.Name</td>
                                                <td class="has-text-right">
                                                    <button class="button is-small is-info is-light" @onclick="() => EditCategory(category)">
                                                        <span class="icon is-small">
                                                            <i class="fas fa-edit"></i>
                                                        </span>
                                                        <span>Editar</span>
                                                    </button>
                                                    <button class="button is-small is-danger is-light" @onclick="() => DeleteCategory(category)">
                                                        <span class="icon is-small">
                                                            <i class="fas fa-trash"></i>
                                                        </span>
                                                        <span>Excluir</span>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </section>

    @if (showModal)
    {
        <div class="modal is-active">
            <div class="modal-background" @onclick="CloseModal"></div>
            <div class="modal-card" @onclick:stopPropagation="true">
<header class="modal-card-head">
                        <p class="modal-card-title">@(isEditing ? "Editar Categoria" : "Adicionar Categoria")</p>
                        <button class="delete" aria-label="close" @onclick="CloseModal"></button>
                    </header>
                    <section class="modal-card-body">
                        @if (!string.IsNullOrEmpty(modalError))
                        {
                            <div class="notification is-danger is-light">
                                @modalError
                            </div>
                        }

                        <div class="field">
                            <label class="label">Nome da Categoria</label>
                            <div class="control">
                                <input class="input" type="text" @bind="categoryName" placeholder="Digite o nome da categoria" />
                            </div>
                        </div>
                    </section>
                    <footer class="modal-card-foot">
                        <div class="buttons">
                            <button class="button" @onclick="CloseModal">Cancelar</button>
                            <button class="button is-primary" @onclick="SaveCategory" disabled="@isSaving">
                                @if (isSaving)
                                {
                                    <span class="icon is-small">
                                        <i class="fas fa-spinner fa-spin"></i>
                                    </span>
                                    <span>Salvando...</span>
                                }
                                else
                                {
                                    <span>@(isEditing ? "Atualizar" : "Criar")</span>
                                }
                            </button>
                        </div>
                    </footer>
            </div>
        </div>
    }

    @if (showDeleteConfirm)
    {
        <div class="modal is-active">
            <div class="modal-background" @onclick="CloseDeleteModal"></div>
            <div class="modal-card" @onclick:stopPropagation="true" style="max-width: 400px;">
<header class="modal-card-head">
                        <p class="modal-card-title">Excluir Categoria</p>
                        <button class="delete" aria-label="close" @onclick="CloseDeleteModal"></button>
                    </header>
                    <section class="modal-card-body">
                        <p>Tem certeza que deseja excluir <strong>@categoryToDelete?.Name</strong>?</p>
                    </section>
                    <footer class="modal-card-foot">
                        <div class="buttons">
                            <button class="button" @onclick="CloseDeleteModal">Cancelar</button>
                            <button class="button is-danger" @onclick="ConfirmDelete" disabled="@isDeleting">
                                @if (isDeleting)
                                {
                                    <span class="icon is-small">
                                        <i class="fas fa-spinner fa-spin"></i>
                                    </span>
                                    <span>Excluindo...</span>
                                }
                                else
                                {
                                    <span>Excluir</span>
                                }
                            </button>
                        </div>
                    </footer>
            </div>
        </div>
    }
</MainLayout>

@code {
    private bool isLoggedIn = false;
    private bool isLoading = true;
    private bool isSaving;
    private bool isDeleting;
    private string? errorMessage;
    private string? modalError;
    private List<CategoryDto>? categories;
    private CategoryDto? categoryToDelete;

    private bool showModal;
    private bool isEditing;
    private Guid? editingId;
    private string categoryName = string.Empty;

    private bool showDeleteConfirm;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoggedIn = await AuthState.IsAuthenticatedAsync();
        }
        catch
        {
            isLoggedIn = false;
        }

        if (isLoggedIn)
        {
            await LoadCategoriesAsync();
        }
        else
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadCategoriesAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            var token = await CompanyContext.GetTokenAsync();
            var client = HttpClientFactory.CreateClient("FeniciaBasic");

            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var selectedCompanyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (selectedCompanyId.HasValue)
            {
                client.DefaultRequestHeaders.Remove("CompanyId");
                client.DefaultRequestHeaders.Add("CompanyId", selectedCompanyId.Value.ToString());
            }

            var response = await client.GetAsync("productcategory?page=1&perPage=100");
            var body = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var json = body;
                var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var paginated = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(json, options);

                if (paginated.TryGetProperty("data", out var dataElement) && dataElement.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    categories = System.Text.Json.JsonSerializer.Deserialize<List<CategoryDto>>(dataElement.GetRawText(), options);
                }
                else if (paginated.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    categories = System.Text.Json.JsonSerializer.Deserialize<List<CategoryDto>>(json, options);
                }
                else
                {
                    categories = [];
                }
            }
            else
            {
                errorMessage = $"Falha ao carregar categorias: {(int)response.StatusCode} {response.StatusCode} - {body}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OpenAddModal()
    {
        isEditing = false;
        editingId = null;
        categoryName = string.Empty;
        modalError = null;
        showModal = true;
        StateHasChanged();
    }

    private void EditCategory(CategoryDto category)
    {
        isEditing = true;
        editingId = category.Id;
        categoryName = category.Name;
        modalError = null;
        showModal = true;
        StateHasChanged();
    }

    private void CloseModal()
    {
        showModal = false;
        StateHasChanged();
    }

    private async Task SaveCategory()
    {
        if (string.IsNullOrWhiteSpace(categoryName))
        {
            modalError = "Nome da categoria é obrigatório.";
            return;
        }

        try
        {
            isSaving = true;
            modalError = null;
            StateHasChanged();

            var token = await CompanyContext.GetTokenAsync();
            var client = HttpClientFactory.CreateClient("FeniciaBasic");

            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var selectedCompanyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (selectedCompanyId.HasValue)
            {
                client.DefaultRequestHeaders.Remove("CompanyId");
                client.DefaultRequestHeaders.Add("CompanyId", selectedCompanyId.Value.ToString());
            }

            if (isEditing && editingId.HasValue)
            {
                var command = new { Id = editingId.Value, Name = categoryName };
                var json = System.Text.Json.JsonSerializer.Serialize(command);
                var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
                var request = new HttpRequestMessage(HttpMethod.Patch, $"productcategory/{editingId.Value}") { Content = content };
                var response = await client.SendAsync(request);
                if (!response.IsSuccessStatusCode)
                {
                    var body = await response.Content.ReadAsStringAsync();
                    modalError = $"Falha ao atualizar: {(int)response.StatusCode} {response.StatusCode} - {body}";
                    return;
                }
            }
            else
            {
                var command = new { Id = Guid.NewGuid(), Name = categoryName };
                var response = await client.PostAsJsonAsync("productcategory", command);
                if (!response.IsSuccessStatusCode)
                {
                    var body = await response.Content.ReadAsStringAsync();
                    modalError = $"Falha ao criar: {(int)response.StatusCode} {response.StatusCode} - {body}";
                    return;
                }
            }

            CloseModal();
            await LoadCategoriesAsync();
        }
        catch (Exception ex)
        {
            modalError = $"Erro: {ex.Message}";
        }
        finally
        {
            isSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void DeleteCategory(CategoryDto category)
    {
        categoryToDelete = category;
        showDeleteConfirm = true;
        StateHasChanged();
    }

    private void CloseDeleteModal()
    {
        showDeleteConfirm = false;
        categoryToDelete = null;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (categoryToDelete == null) return;

        try
        {
            isDeleting = true;
            StateHasChanged();

            var token = await CompanyContext.GetTokenAsync();
            var client = HttpClientFactory.CreateClient("FeniciaBasic");

            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var selectedCompanyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (selectedCompanyId.HasValue)
            {
                client.DefaultRequestHeaders.Remove("CompanyId");
                client.DefaultRequestHeaders.Add("CompanyId", selectedCompanyId.Value.ToString());
            }

            var response = await client.DeleteAsync($"productcategory/{categoryToDelete.Id}");
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                errorMessage = $"Falha ao excluir: {(int)response.StatusCode} {response.StatusCode} - {body}";
            }

            CloseDeleteModal();
            await LoadCategoriesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro: {ex.Message}";
        }
        finally
        {
            isDeleting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private class CategoryDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }
}
