@page "/productcategories"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext
@inject NavigationManager NavigationManager

<PageTitle>Product Categories - Fenicia</PageTitle>

<MainLayout>
    <div style="max-width: 1000px; margin: 50px auto; padding: 0 20px;">
        @if (!isLoggedIn)
        {
            <div style="padding: 20px; border: 1px solid #f8d7da; border-radius: 4px; background: #f8d7da; color: #721c24;">
                <p>Please log in to manage product categories.</p>
            </div>
        }
        else if (isLoading)
        {
            <div style="padding: 20px; border: 1px solid #e0e0e0; border-radius: 4px; background: white; text-align: center;">
                <p>Loading product categories...</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div style="padding: 20px; border: 1px solid #f8d7da; border-radius: 4px; background: #f8d7da; color: #721c24;">
                <p>@errorMessage</p>
            </div>
        }
        else
        {
            <div style="padding: 20px; border: 1px solid #e0e0e0; border-radius: 4px; background: white;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                    <h2 style="margin: 0; font-size: 1.3rem; color: #333;">Product Categories</h2>
                    <button class="btn btn-primary" @onclick="OpenAddModal" style="width: auto; padding: 8px 20px;">
                        + Add Category
                    </button>
                </div>

                @if (categories == null || categories.Count == 0)
                {
                    <p style="color: #666; text-align: center; padding: 40px 0;">No categories found. Create your first category!</p>
                }
                else
                {
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="border-bottom: 2px solid #e0e0e0;">
                                <th style="text-align: left; padding: 12px 8px; color: #666; font-weight: 600; font-size: 0.9rem;">Name</th>
                                <th style="text-align: right; padding: 12px 8px; color: #666; font-weight: 600; font-size: 0.9rem;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in categories)
                            {
                                <tr style="border-bottom: 1px solid #f0f0f0;">
                                    <td style="padding: 12px 8px; color: #333;">@category.Name</td>
                                    <td style="padding: 12px 8px; text-align: right;">
                                        <button @onclick="() => EditCategory(category)" style="background: none; border: none; color: #4f46e5; cursor: pointer; font-size: 0.9rem; margin-right: 12px;">Edit</button>
                                        <button @onclick="() => DeleteCategory(category)" style="background: none; border: none; color: #dc3545; cursor: pointer; font-size: 0.9rem;">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
    </div>

    @if (showModal)
    {
        <div class="company-modal-overlay" @onclick="CloseModal">
            <div class="company-modal" @onclick:stopPropagation="true">
                <div class="company-modal-header">
                    <h3>@(isEditing ? "Edit Category" : "Add Category")</h3>
                    <button class="close-btn" @onclick="CloseModal">✕</button>
                </div>
                <div class="company-modal-body">
                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <div style="padding: 10px; border-radius: 4px; background: #f8d7da; color: #721c24; margin-bottom: 15px;">
                            @modalError
                        </div>
                    }

                    <div style="margin-bottom: 15px;">
                        <label style="display: block; font-weight: 600; color: #333; margin-bottom: 6px;">Category Name</label>
                        <input type="text" @bind="categoryName" placeholder="Enter category name" style="width: 100%; padding: 10px; border: 1px solid #e0e0e0; border-radius: 4px; font-size: 1rem;" />
                    </div>

                    <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
                        <button @onclick="CloseModal" style="padding: 8px 20px; border: 1px solid #e0e0e0; background: white; border-radius: 4px; cursor: pointer;">Cancel</button>
                        <button @onclick="SaveCategory" disabled="@isSaving" style="padding: 8px 20px; background: #4f46e5; color: white; border: none; border-radius: 4px; cursor: pointer;">
                            @if (isSaving)
                            {
                                <text>Saving...</text>
                            }
                            else
                            {
                                <text>@(isEditing ? "Update" : "Create")</text>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (showDeleteConfirm)
    {
        <div class="company-modal-overlay" @onclick="CloseDeleteModal">
            <div class="company-modal" @onclick:stopPropagation="true" style="max-width: 400px;">
                <div class="company-modal-header">
                    <h3>Delete Category</h3>
                    <button class="close-btn" @onclick="CloseDeleteModal">✕</button>
                </div>
                <div class="company-modal-body">
                    <p style="margin-bottom: 20px; color: #333;">Are you sure you want to delete <strong>@categoryToDelete?.Name</strong>?</p>
                    <div style="display: flex; justify-content: flex-end; gap: 10px;">
                        <button @onclick="CloseDeleteModal" style="padding: 8px 20px; border: 1px solid #e0e0e0; background: white; border-radius: 4px; cursor: pointer;">Cancel</button>
                        <button @onclick="ConfirmDelete" disabled="@isDeleting" style="padding: 8px 20px; background: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer;">
                            @if (isDeleting)
                            {
                                <text>Deleting...</text>
                            }
                            else
                            {
                                <text>Delete</text>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</MainLayout>

@code {
    private bool isLoggedIn = false;
    private bool isLoading = true;
    private bool isSaving;
    private bool isDeleting;
    private string? errorMessage;
    private string? modalError;
    private List<CategoryDto>? categories;
    private CategoryDto? categoryToDelete;

    private bool showModal;
    private bool isEditing;
    private Guid? editingId;
    private string categoryName = string.Empty;

    private bool showDeleteConfirm;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                isLoggedIn = await CompanyContext.IsAuthenticatedAsync();
            }
            catch
            {
                isLoggedIn = false;
            }

            await InvokeAsync(StateHasChanged);

            if (isLoggedIn)
            {
                await LoadCategoriesAsync();
            }
            else
            {
                isLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task LoadCategoriesAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            var token = await CompanyContext.GetTokenAsync();
            var client = HttpClientFactory.CreateClient("FeniciaBasic");
            Console.WriteLine($"[ProductCategories] Client base address: {client.BaseAddress}");

            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var response = await client.GetAsync("/productcategory?page=1&perPage=100");
            Console.WriteLine($"[ProductCategories] GET {client.BaseAddress}/productcategory?page=1&perPage=100 -> {(int)response.StatusCode} {response.StatusCode}");
            var body = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"[ProductCategories] Response body: {body}");

            if (response.IsSuccessStatusCode)
            {
                var json = body;
                var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var paginated = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(json, options);

                if (paginated.TryGetProperty("data", out var dataElement) && dataElement.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    categories = System.Text.Json.JsonSerializer.Deserialize<List<CategoryDto>>(dataElement.GetRawText(), options);
                }
                else if (paginated.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    categories = System.Text.Json.JsonSerializer.Deserialize<List<CategoryDto>>(json, options);
                }
                else
                {
                    categories = [];
                }
            }
            else
            {
                errorMessage = $"Failed to load categories: {(int)response.StatusCode} {response.StatusCode} - {body}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            Console.WriteLine($"[ProductCategories] Load error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OpenAddModal()
    {
        isEditing = false;
        editingId = null;
        categoryName = string.Empty;
        modalError = null;
        showModal = true;
        StateHasChanged();
    }

    private void EditCategory(CategoryDto category)
    {
        isEditing = true;
        editingId = category.Id;
        categoryName = category.Name;
        modalError = null;
        showModal = true;
        StateHasChanged();
    }

    private void CloseModal()
    {
        showModal = false;
        StateHasChanged();
    }

    private async Task SaveCategory()
    {
        if (string.IsNullOrWhiteSpace(categoryName))
        {
            modalError = "Category name is required.";
            return;
        }

        try
        {
            isSaving = true;
            modalError = null;
            StateHasChanged();

            var token = await CompanyContext.GetTokenAsync();
            var client = HttpClientFactory.CreateClient("FeniciaBasic");

            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            if (isEditing && editingId.HasValue)
            {
                var command = new { Id = editingId.Value, Name = categoryName };
                var response = await client.PatchAsJsonAsync($"/productcategory/{editingId.Value}", command);
                if (!response.IsSuccessStatusCode)
                {
                    var body = await response.Content.ReadAsStringAsync();
                    modalError = $"Failed to update: {(int)response.StatusCode} {response.StatusCode} - {body}";
                    return;
                }
            }
            else
            {
                var command = new { Id = Guid.NewGuid(), Name = categoryName };
                var response = await client.PostAsJsonAsync("/productcategory", command);
                if (!response.IsSuccessStatusCode)
                {
                    var body = await response.Content.ReadAsStringAsync();
                    modalError = $"Failed to create: {(int)response.StatusCode} {response.StatusCode} - {body}";
                    return;
                }
            }

            CloseModal();
            await LoadCategoriesAsync();
        }
        catch (Exception ex)
        {
            modalError = $"Error: {ex.Message}";
            Console.WriteLine($"[ProductCategories] Save error: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void DeleteCategory(CategoryDto category)
    {
        categoryToDelete = category;
        showDeleteConfirm = true;
        StateHasChanged();
    }

    private void CloseDeleteModal()
    {
        showDeleteConfirm = false;
        categoryToDelete = null;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (categoryToDelete == null) return;

        try
        {
            isDeleting = true;
            StateHasChanged();

            var token = await CompanyContext.GetTokenAsync();
            var client = HttpClientFactory.CreateClient("FeniciaBasic");

            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var response = await client.DeleteAsync($"/productcategory/{categoryToDelete.Id}");
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                errorMessage = $"Failed to delete: {(int)response.StatusCode} {response.StatusCode} - {body}";
            }

            CloseDeleteModal();
            await LoadCategoriesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            Console.WriteLine($"[ProductCategories] Delete error: {ex.Message}");
        }
        finally
        {
            isDeleting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private class CategoryDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }
}
