@page "/productcategories"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext
@inject IAuthStateService AuthState
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService

<PageTitle>Categorias de Produtos - Fenicia</PageTitle>

<MainLayout>
    <MudGrid>
        <MudItem xs="12">
            @if (!isLoggedIn)
            {
                <MudAlert Severity="Severity.Error">Faça login para gerenciar categorias de produtos.</MudAlert>
            }
            else if (isLoading)
            {
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="ma-16" Size="Size.Large" />
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
            }
            else
            {
                <MudPaper Elevation="2" Class="pa-6">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
                        <div>
                            <MudText Typo="Typo.h5">Categorias de Produtos</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Default">Gerencie suas categorias de produtos</MudText>
                        </div>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddModal">
                            Adicionar Categoria
                        </MudButton>
                    </MudStack>

                    @if (categories == null || categories.Count == 0)
                    {
                        <MudAlert Severity="Severity.Warning">Nenhuma categoria encontrada. Crie sua primeira categoria!</MudAlert>
                    }
                    else
                    {
                        <MudTable T="CategoryDto" Items="categories" Dense="true" Hover="true" Bordered="true" Striped="true">
                            <HeaderContent>
                                <MudTr>
                                    <MudTd><MudText Typo="Typo.subtitle2">Nome</MudText></MudTd>
                                    <MudTd Class="text-right"><MudText Typo="Typo.subtitle2">Ações</MudText></MudTd>
                                </MudTr>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTr>
                                    <MudTd>@context.Name</MudTd>
                                    <MudTd Class="text-right">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="@(() => EditCategory(context))" Disabled="@isSaving" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteCategory(context))" Disabled="@isDeleting" />
                                    </MudTd>
                                </MudTr>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
</MainLayout>

@if (showModal)
{
    <MudDialog @bind-Visible="showModal" Options="dialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6">@(isEditing ? "Editar Categoria" : "Adicionar Categoria")</MudText>
        </TitleContent>
        <DialogContent>
            @if (!string.IsNullOrEmpty(modalError))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">@modalError</MudAlert>
            }
            <MudTextField @bind-Value="categoryName" Label="Nome da Categoria" Variant="Variant.Outlined" Required="true" RequiredError="Nome da categoria é obrigatório!" />
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseModal">Cancelar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveCategory" Disabled="@isSaving">
                @if (isSaving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Default" Class="mr-2" />
                }
                @(isEditing ? "Atualizar" : "Criar")
            </MudButton>
        </DialogActions>
    </MudDialog>
}

@if (showDeleteConfirm)
{
    <MudDialog @bind-Visible="showDeleteConfirm" Options="dialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6">Excluir Categoria</MudText>
        </TitleContent>
        <DialogContent>
            <MudText>Tem certeza que deseja excluir <strong>@categoryToDelete?.Name</strong>?</MudText>
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseDeleteModal">Cancelar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmDelete" Disabled="@isDeleting">
                @if (isDeleting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Default" Class="mr-2" />
                }
                Excluir
            </MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    private bool isLoggedIn = false;
    private bool isLoading = true;
    private bool isSaving;
    private bool isDeleting;
    private string? errorMessage;
    private string? modalError;
    private List<CategoryDto>? categories;
    private CategoryDto? categoryToDelete;

    private bool showModal;
    private bool isEditing;
    private Guid? editingId;
    private string categoryName = string.Empty;

    private bool showDeleteConfirm;

    private DialogOptions dialogOptions = new() { FullWidth = true, MaxWidth = MaxWidth.Small };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoggedIn = await AuthState.IsAuthenticatedAsync();
        }
        catch
        {
            isLoggedIn = false;
        }

        if (isLoggedIn)
        {
            await LoadCategoriesAsync();
        }
        else
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadCategoriesAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            var token = await CompanyContext.GetTokenAsync();
            var client = HttpClientFactory.CreateClient("FeniciaBasic");

            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var selectedCompanyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (selectedCompanyId.HasValue)
            {
                client.DefaultRequestHeaders.Remove("CompanyId");
                client.DefaultRequestHeaders.Add("CompanyId", selectedCompanyId.Value.ToString());
            }

            var response = await client.GetAsync("productcategory?page=1&perPage=100");
            var body = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var json = body;
                var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var paginated = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(json, options);

                if (paginated.TryGetProperty("data", out var dataElement) && dataElement.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    categories = System.Text.Json.JsonSerializer.Deserialize<List<CategoryDto>>(dataElement.GetRawText(), options);
                }
                else if (paginated.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    categories = System.Text.Json.JsonSerializer.Deserialize<List<CategoryDto>>(json, options);
                }
                else
                {
                    categories = [];
                }
            }
            else
            {
                errorMessage = $"Falha ao carregar categorias: {(int)response.StatusCode} {response.StatusCode} - {body}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OpenAddModal()
    {
        isEditing = false;
        editingId = null;
        categoryName = string.Empty;
        modalError = null;
        showModal = true;
        StateHasChanged();
    }

    private void EditCategory(CategoryDto category)
    {
        isEditing = true;
        editingId = category.Id;
        categoryName = category.Name;
        modalError = null;
        showModal = true;
        StateHasChanged();
    }

    private void CloseModal()
    {
        showModal = false;
        StateHasChanged();
    }

    private async Task SaveCategory()
    {
        if (string.IsNullOrWhiteSpace(categoryName))
        {
            modalError = "Nome da categoria é obrigatório.";
            return;
        }

        try
        {
            isSaving = true;
            modalError = null;
            StateHasChanged();

            var token = await CompanyContext.GetTokenAsync();
            var client = HttpClientFactory.CreateClient("FeniciaBasic");

            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var selectedCompanyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (selectedCompanyId.HasValue)
            {
                client.DefaultRequestHeaders.Remove("CompanyId");
                client.DefaultRequestHeaders.Add("CompanyId", selectedCompanyId.Value.ToString());
            }

            if (isEditing && editingId.HasValue)
            {
                var command = new { Id = editingId.Value, Name = categoryName };
                var json = System.Text.Json.JsonSerializer.Serialize(command);
                var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
                var request = new HttpRequestMessage(HttpMethod.Patch, $"productcategory/{editingId.Value}") { Content = content };
                var response = await client.SendAsync(request);
                if (!response.IsSuccessStatusCode)
                {
                    var body = await response.Content.ReadAsStringAsync();
                    modalError = $"Falha ao atualizar: {(int)response.StatusCode} {response.StatusCode} - {body}";
                    NotificationService.Show("Falha ao atualizar categoria.", Severity.Error);
                    StateHasChanged();
                    return;
                }

                NotificationService.Show("Categoria atualizada com sucesso!", Severity.Success);
            }
            else
            {
                var command = new { Id = Guid.NewGuid(), Name = categoryName };
                var response = await client.PostAsJsonAsync("productcategory", command);
                if (!response.IsSuccessStatusCode)
                {
                    var body = await response.Content.ReadAsStringAsync();
                    modalError = $"Falha ao criar: {(int)response.StatusCode} {response.StatusCode} - {body}";
                    NotificationService.Show("Falha ao criar categoria.", Severity.Error);
                    StateHasChanged();
                    return;
                }

                NotificationService.Show("Categoria criada com sucesso!", Severity.Success);
            }

            CloseModal();
            await LoadCategoriesAsync();
        }
        catch (Exception ex)
        {
            modalError = $"Erro: {ex.Message}";
        }
        finally
        {
            isSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void DeleteCategory(CategoryDto category)
    {
        categoryToDelete = category;
        showDeleteConfirm = true;
        StateHasChanged();
    }

    private void CloseDeleteModal()
    {
        showDeleteConfirm = false;
        categoryToDelete = null;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (categoryToDelete == null) return;

        try
        {
            isDeleting = true;
            StateHasChanged();

            var token = await CompanyContext.GetTokenAsync();
            var client = HttpClientFactory.CreateClient("FeniciaBasic");

            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var selectedCompanyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (selectedCompanyId.HasValue)
            {
                client.DefaultRequestHeaders.Remove("CompanyId");
                client.DefaultRequestHeaders.Add("CompanyId", selectedCompanyId.Value.ToString());
            }

            var response = await client.DeleteAsync($"productcategory/{categoryToDelete.Id}");
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                errorMessage = $"Falha ao excluir: {(int)response.StatusCode} {response.StatusCode} - {body}";
                NotificationService.Show("Falha ao excluir categoria.", Severity.Error);
            }
            else
            {
                NotificationService.Show("Categoria excluída com sucesso!", Severity.Success);
            }

            CloseDeleteModal();
            await LoadCategoriesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro: {ex.Message}";
        }
        finally
        {
            isDeleting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private class CategoryDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }
}
