@page "/productcategories"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext
@inject IAuthStateService AuthState
@inject NavigationManager NavigationManager

<PageTitle>Product Categories - Fenicia</PageTitle>

<MainLayout>
    <section class="section">
        <div class="container">
            @if (!isLoggedIn)
            {
                <div class="notification is-danger">
                    <p>Please log in to manage product categories.</p>
                </div>
            }
            else if (isLoading)
            {
                <div class="notification is-info is-light">
                    <p>Loading product categories...</p>
                </div>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="notification is-danger">
                    <p>@errorMessage</p>
                </div>
            }
            else
            {
                <div class="box">
                    <div class="level">
                        <div class="level-left">
                            <h2 class="title is-4 mb-0">Product Categories</h2>
                        </div>
                        <div class="level-right">
                            <button class="button is-primary" @onclick="OpenAddModal">
                                <span class="icon is-small">
                                    <i class="fas fa-plus"></i>
                                </span>
                                <span>Add Category</span>
                            </button>
                        </div>
                    </div>

                    @if (categories == null || categories.Count == 0)
                    {
                        <div class="notification is-warning is-light">
                            <p>No categories found. Create your first category!</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-container">
                            <table class="table is-fullwidth is-hoverable">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th class="has-text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var category in categories)
                                    {
                                        <tr>
                                            <td>@category.Name</td>
                                            <td class="has-text-right">
                                                <button class="button is-small is-info is-light" @onclick="() => EditCategory(category)">
                                                    <span class="icon is-small">
                                                        <i class="fas fa-edit"></i>
                                                    </span>
                                                    <span>Edit</span>
                                                </button>
                                                <button class="button is-small is-danger is-light" @onclick="() => DeleteCategory(category)">
                                                    <span class="icon is-small">
                                                        <i class="fas fa-trash"></i>
                                                    </span>
                                                    <span>Delete</span>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    @if (showModal)
    {
        <div class="modal is-active">
            <div class="modal-background" @onclick="CloseModal"></div>
            <div class="modal-card">
                <header class="modal-card-head">
                    <p class="modal-card-title">@(isEditing ? "Edit Category" : "Add Category")</p>
                    <button class="delete" aria-label="close" @onclick="CloseModal"></button>
                </header>
                <section class="modal-card-body">
                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <div class="notification is-danger is-light">
                            @modalError
                        </div>
                    }

                    <div class="field">
                        <label class="label">Category Name</label>
                        <div class="control">
                            <input class="input" type="text" @bind="categoryName" placeholder="Enter category name" />
                        </div>
                    </div>
                </section>
                <footer class="modal-card-foot">
                    <div class="buttons">
                        <button class="button" @onclick="CloseModal">Cancel</button>
                        <button class="button is-primary" @onclick="SaveCategory" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="icon is-small">
                                    <i class="fas fa-spinner fa-spin"></i>
                                </span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span>@(isEditing ? "Update" : "Create")</span>
                            }
                        </button>
                    </div>
                </footer>
            </div>
        </div>
    }

    @if (showDeleteConfirm)
    {
        <div class="modal is-active">
            <div class="modal-background" @onclick="CloseDeleteModal"></div>
            <div class="modal-card" style="max-width: 400px;">
                <header class="modal-card-head">
                    <p class="modal-card-title">Delete Category</p>
                    <button class="delete" aria-label="close" @onclick="CloseDeleteModal"></button>
                </header>
                <section class="modal-card-body">
                    <p>Are you sure you want to delete <strong>@categoryToDelete?.Name</strong>?</p>
                </section>
                <footer class="modal-card-foot">
                    <div class="buttons">
                        <button class="button" @onclick="CloseDeleteModal">Cancel</button>
                        <button class="button is-danger" @onclick="ConfirmDelete" disabled="@isDeleting">
                            @if (isDeleting)
                            {
                                <span class="icon is-small">
                                    <i class="fas fa-spinner fa-spin"></i>
                                </span>
                                <span>Deleting...</span>
                            }
                            else
                            {
                                <span>Delete</span>
                            }
                        </button>
                    </div>
                </footer>
            </div>
        </div>
    }
</MainLayout>

@code {
    private bool isLoggedIn = false;
    private bool isLoading = true;
    private bool isSaving;
    private bool isDeleting;
    private string? errorMessage;
    private string? modalError;
    private List<CategoryDto>? categories;
    private CategoryDto? categoryToDelete;

    private bool showModal;
    private bool isEditing;
    private Guid? editingId;
    private string categoryName = string.Empty;

    private bool showDeleteConfirm;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoggedIn = await AuthState.IsAuthenticatedAsync();
        }
        catch
        {
            isLoggedIn = false;
        }

        if (isLoggedIn)
        {
            await LoadCategoriesAsync();
        }
        else
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadCategoriesAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            var token = await CompanyContext.GetTokenAsync();
            var client = HttpClientFactory.CreateClient("FeniciaBasic");

            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var selectedCompanyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (selectedCompanyId.HasValue)
            {
                client.DefaultRequestHeaders.Remove("CompanyId");
                client.DefaultRequestHeaders.Add("CompanyId", selectedCompanyId.Value.ToString());
                Console.WriteLine($"[ProductCategories] Added CompanyId header: {selectedCompanyId.Value}");
            }
            else
            {
                Console.WriteLine("[ProductCategories] No company selected, CompanyId header not set");
            }

            var response = await client.GetAsync("productcategory?page=1&perPage=100");
            var body = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var json = body;
                var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var paginated = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(json, options);

                if (paginated.TryGetProperty("data", out var dataElement) && dataElement.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    categories = System.Text.Json.JsonSerializer.Deserialize<List<CategoryDto>>(dataElement.GetRawText(), options);
                }
                else if (paginated.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    categories = System.Text.Json.JsonSerializer.Deserialize<List<CategoryDto>>(json, options);
                }
                else
                {
                    categories = [];
                }
            }
            else
            {
                errorMessage = $"Failed to load categories: {(int)response.StatusCode} {response.StatusCode} - {body}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            Console.WriteLine($"[ProductCategories] Load error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OpenAddModal()
    {
        isEditing = false;
        editingId = null;
        categoryName = string.Empty;
        modalError = null;
        showModal = true;
        StateHasChanged();
    }

    private void EditCategory(CategoryDto category)
    {
        isEditing = true;
        editingId = category.Id;
        categoryName = category.Name;
        modalError = null;
        showModal = true;
        StateHasChanged();
    }

    private void CloseModal()
    {
        showModal = false;
        StateHasChanged();
    }

    private async Task SaveCategory()
    {
        Console.WriteLine($"[ProductCategories] SaveCategory START editing={isEditing} editingId={editingId} name={categoryName}");
        if (string.IsNullOrWhiteSpace(categoryName))
        {
            modalError = "Category name is required.";
            return;
        }

        try
        {
            isSaving = true;
            modalError = null;
            StateHasChanged();

            var token = await CompanyContext.GetTokenAsync();
            var client = HttpClientFactory.CreateClient("FeniciaBasic");

            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var selectedCompanyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (selectedCompanyId.HasValue)
            {
                client.DefaultRequestHeaders.Remove("CompanyId");
                client.DefaultRequestHeaders.Add("CompanyId", selectedCompanyId.Value.ToString());
                Console.WriteLine($"[ProductCategories] SaveCategory Added CompanyId header: {selectedCompanyId.Value}");
            }

            if (isEditing && editingId.HasValue)
            {
                var command = new { Id = editingId.Value, Name = categoryName };
                var json = System.Text.Json.JsonSerializer.Serialize(command);
                var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
                var request = new HttpRequestMessage(HttpMethod.Patch, $"productcategory/{editingId.Value}") { Content = content };
                var response = await client.SendAsync(request);
                if (!response.IsSuccessStatusCode)
                {
                    var body = await response.Content.ReadAsStringAsync();
                    modalError = $"Failed to update: {(int)response.StatusCode} {response.StatusCode} - {body}";
                    Console.WriteLine($"[ProductCategories] SaveCategory PATCH failed: {(int)response.StatusCode} {response.StatusCode} {body}");
                    return;
                }

                Console.WriteLine($"[ProductCategories] SaveCategory PATCH success");
            }
            else
            {
                var command = new { Id = Guid.NewGuid(), Name = categoryName };
                var response = await client.PostAsJsonAsync("productcategory", command);
                if (!response.IsSuccessStatusCode)
                {
                    var body = await response.Content.ReadAsStringAsync();
                    modalError = $"Failed to create: {(int)response.StatusCode} {response.StatusCode} - {body}";
                    Console.WriteLine($"[ProductCategories] SaveCategory POST failed: {(int)response.StatusCode} {response.StatusCode} {body}");
                    return;
                }

                Console.WriteLine($"[ProductCategories] SaveCategory POST success");
            }

            CloseModal();
            await LoadCategoriesAsync();
        }
        catch (Exception ex)
        {
            modalError = $"Error: {ex.Message}";
            Console.WriteLine($"[ProductCategories] Save error: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void DeleteCategory(CategoryDto category)
    {
        categoryToDelete = category;
        showDeleteConfirm = true;
        StateHasChanged();
    }

    private void CloseDeleteModal()
    {
        showDeleteConfirm = false;
        categoryToDelete = null;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (categoryToDelete == null) return;

        try
        {
            isDeleting = true;
            StateHasChanged();

            var token = await CompanyContext.GetTokenAsync();
            var client = HttpClientFactory.CreateClient("FeniciaBasic");

            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var selectedCompanyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (selectedCompanyId.HasValue)
            {
                client.DefaultRequestHeaders.Remove("CompanyId");
                client.DefaultRequestHeaders.Add("CompanyId", selectedCompanyId.Value.ToString());
                Console.WriteLine($"[ProductCategories] ConfirmDelete Added CompanyId header: {selectedCompanyId.Value}");
            }

            Console.WriteLine($"[ProductCategories] ConfirmDelete START id={categoryToDelete.Id}");
            var response = await client.DeleteAsync($"productcategory/{categoryToDelete.Id}");
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                errorMessage = $"Failed to delete: {(int)response.StatusCode} {response.StatusCode} - {body}";
                Console.WriteLine($"[ProductCategories] ConfirmDelete DELETE failed: {(int)response.StatusCode} {response.StatusCode} {body}");
            }
            else
            {
                Console.WriteLine($"[ProductCategories] ConfirmDelete DELETE success");
            }

            CloseDeleteModal();
            await LoadCategoriesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            Console.WriteLine($"[ProductCategories] Delete error: {ex.Message}");
        }
        finally
        {
            isDeleting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private class CategoryDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }
}
