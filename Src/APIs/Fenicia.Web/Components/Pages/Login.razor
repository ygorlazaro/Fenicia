@page "/login"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject IAuthStateService AuthState
@inject NotificationService NotificationService

<PageTitle>Login - Fenicia</PageTitle>

<nav class="navbar is-link" role="navigation" aria-label="main navigation">
    <div class="container">
        <div class="navbar-brand">
            <a class="navbar-item" href="/">
                <img src="/images/logo.svg" alt="Fenicia" class="logo-img" />
            </a>
        </div>
    </div>
</nav>

<section class="hero is-link is-small">
    <div class="hero-body">
        <div class="container has-text-centered">
            <h1 class="title is-3 has-text-white">Bem-vindo de volta</h1>
            <p class="subtitle is-6 has-text-white-ter">Acesse sua conta para continuar</p>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="columns is-centered">
            <div class="column is-half">
                <div class="card">
                    <div class="card-content">
                        <h3 class="title is-4 has-text-centered">Login</h3>

                        <EditForm Model="@model" OnValidSubmit="HandleSubmit" FormName="login-form">
                            <DataAnnotationsValidator />

                            <div class="field">
                                <label class="label">Email</label>
                                <div class="control has-icons-left">
                                    <input class="input" @bind="model.Email" placeholder="seu@email.com" type="email" />
                                    <span class="icon is-small is-left"><i class="fas fa-envelope"></i></span>
                                </div>
                                <ValidationMessage For="@(() => model.Email)" />
                            </div>

                            <div class="field">
                                <label class="label">Senha</label>
                                <div class="control has-icons-left">
                                    <input class="input" @bind="model.Password" placeholder="••••••••" type="password" />
                                    <span class="icon is-small is-left"><i class="fas fa-lock"></i></span>
                                </div>
                                <ValidationMessage For="@(() => model.Password)" />
                            </div>

                            <div class="field mt-5">
                                <div class="control">
                                    <button type="submit" class="button is-link is-fullwidth" disabled="@isLoading">
                                        @if (isLoading)
                                        {
                                            <text>Entrando...</text>
                                        }
                                        else
                                        {
                                            <text>Entrar</text>
                                        }
                                    </button>
                                </div>
                            </div>
                        </EditForm>

                        @if (!string.IsNullOrEmpty(message))
                        {
                            <Notification Color="@(isSuccess ? NotificationColor.Success : NotificationColor.Danger)" HideCloseButton="true">
                                @message
                            </Notification>
                        }

                        <p class="has-text-centered mt-5">
                            Ainda não tem conta? <a href="/signup" class="has-text-link"><strong>Criar minha conta</strong></a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<footer class="footer">
    <div class="content has-text-centered">
        <p><strong>Fenicia</strong> &copy; @DateTime.Now.Year — O Sistema Modular Open Source para sua Empresa.</p>
    </div>
</footer>

<style>
    .logo-img {
        height: 48px;
        width: auto;
    }
</style>

@code {
    private LoginModel model = new();
    private string? message;
    private bool isSuccess;
    private bool isLoading;

    private async Task HandleSubmit()
    {
        message = null;
        isLoading = true;
        StateHasChanged();

        try
        {
            var client = HttpClientFactory.CreateClient("FeniciaAuth");
            var request = new
            {
                email = model.Email,
                password = model.Password
            };

            var response = await client.PostAsJsonAsync("/token", request);
            var body = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var tokenData = System.Text.Json.JsonSerializer.Deserialize<TokenResponse>(body, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (tokenData != null && !string.IsNullOrEmpty(tokenData.AccessToken))
                {
                    await AuthState.SetTokenAsync(tokenData.AccessToken, 60 * 60 * 3);
                    isSuccess = true;
                    message = "Login realizado com sucesso! Redirecionando...";
                    NotificationService.Show("Login realizado com sucesso!", NotificationColor.Success);
                    await Task.Delay(500);
                    NavigationManager.NavigateTo("/dashboard");
                }
                else
                {
                    isSuccess = false;
                    message = "Resposta inválida do servidor.";
                    NotificationService.Show("Resposta inválida do servidor.", NotificationColor.Danger);
                }
            }
            else
            {
                isSuccess = false;
                message = $"Falha no login ({(int)response.StatusCode}): {body}";
                NotificationService.Show($"Falha no login ({(int)response.StatusCode})", NotificationColor.Danger);
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            message = $"Erro: {ex.Message}";
            NotificationService.Show($"Erro: {ex.Message}", NotificationColor.Danger);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private class LoginModel
    {
        [Required]
        [EmailAddress]
        [MaxLength(200)]
        public string Email { get; set; } = string.Empty;

        [Required]
        [MaxLength(200)]
        public string Password { get; set; } = string.Empty;
    }

    private class TokenResponse
    {
        public string AccessToken { get; set; } = string.Empty;
        public string RefreshToken { get; set; } = string.Empty;
        public UserResponse User { get; set; } = new();
    }

    private class UserResponse
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
    }
}