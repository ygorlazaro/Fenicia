@page "/"
@inject NavigationManager NavigationManager

<PageTitle>Fenicia - O Sistema que Cresce com Você</PageTitle>

<MudLayout>
    <MudAppBar Elevation="4" Color="Color.Primary" Dense="true">
        <MudLink Href="/" Underline="Underline.None" Color="Color.Inherit" Class="d-flex align-center">
            <img src="/images/logo.svg" alt="Fenicia" class="logo-img" />
        </MudLink>
        <MudSpacer />
        <MudHidden Breakpoint="Breakpoint.MdAndDown" Invert="true">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudLink Href="/login" Underline="Underline.None" Color="Color.Inherit">
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Login">Login</MudButton>
                </MudLink>
                <MudLink Href="/signup" Underline="Underline.None" Color="Color.Inherit">
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PersonAdd">Criar minha conta</MudButton>
                </MudLink>
            </MudStack>
        </MudHidden>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-0">
            <MudGrid Justify="Justify.Center" Class="hero-section">
                <MudItem xs="12" Class="d-flex flex-column align-center justify-center text-center pa-16" Style="background-color: #1a237e;">
                    <img src="/images/logo.svg" alt="Fenicia" class="hero-logo" />
                    <MudText Typo="Typo.h2" Color="Color.Default" Class="mb-4">Seu sistema, suas regras.</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Default" Class="mb-8">O ERP modular open source que cresce junto com sua empresa.</MudText>
                    <MudStack Row="true" Spacing="2" Justify="Justify.Center">
                        <MudLink Href="/signup" Underline="Underline.None">
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Large" StartIcon="@Icons.Material.Filled.Rocket">Criar minha conta</MudButton>
                        </MudLink>
                        <MudLink Href="#modulos" Underline="Underline.None">
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Large" StartIcon="@Icons.Material.Filled.Category">Conhecer todos os módulos</MudButton>
                        </MudLink>
                    </MudStack>
                </MudItem>
            </MudGrid>

            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-16">
                <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-4">Você já pagou por um ERP inteiro pra usar 20% dele?</MudText>
                <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Default" Class="mb-6">
                    A maioria dos sistemas de gestão empresarial chega pronto — inchado, com módulos que você nunca vai abrir, telas que confundem sua equipe, e uma mensalidade calculada como se sua empresa precisasse de tudo aquilo. Você não precisa. Nenhuma empresa precisa.
                </MudText>
                <MudText Typo="Typo.h5" Align="Align.Center" Color="Color.Primary" Class="mb-2">O Fenicia nasceu de uma pergunta simples:</MudText>
                <MudText Typo="Typo.h6" Align="Align.Center" Color="Color.Default">
                    <em>E se você pudesse montar o seu próprio sistema, peça por peça, do jeito que sua operação realmente funciona?</em>
                </MudText>
            </MudContainer>

            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-16">
                <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-2">Modular de verdade, não modular no papel</MudText>
                <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Default" Class="mb-8">
                    Esqueça pacotes fechados. No Fenicia, cada área da sua empresa é um bloco independente — você escolhe quais ativar, quando ativar, e paga (ou nem paga, se for o caso) só pelo que está realmente usando.
                </MudText>

                <MudGrid Spacing="4" Justify="Justify.Center">
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Elevation="2" Class="h-100 module-card">
                            <MudCardContent Class="d-flex flex-column align-center text-center">
                                <MudIcon Icon="@Icons.Material.Filled.Calculate" Color="Color.Success" Size="Size.Large" Class="mb-2" />
                                <MudText Typo="Typo.h6">Financeiro & Contábil</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Default">controle total do seu caixa</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Elevation="2" Class="h-100 module-card">
                            <MudCardContent Class="d-flex flex-column align-center text-center">
                                <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Info" Size="Size.Large" Class="mb-2" />
                                <MudText Typo="Typo.h6">Contratos</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Default">gestão de vigência, renovação e cláusulas sem planilha</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Elevation="2" Class="h-100 module-card">
                            <MudCardContent Class="d-flex flex-column align-center text-center">
                                <MudIcon Icon="@Icons.Material.Filled.HeadsetMic" Color="Color.Warning" Size="Size.Large" Class="mb-2" />
                                <MudText Typo="Typo.h6">Atendimento ao Cliente</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Default">cada ticket, cada cliente, no lugar certo</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Elevation="2" Class="h-100 module-card">
                            <MudCardContent Class="d-flex flex-column align-center text-center">
                                <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Color="Color.Error" Size="Size.Large" Class="mb-2" />
                                <MudText Typo="Typo.h6">E-commerce</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Default">sua loja conectada ao resto do seu negócio</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Elevation="2" Class="h-100 module-card">
                            <MudCardContent Class="d-flex flex-column align-center text-center">
                                <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
                                <MudText Typo="Typo.h6">RH</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Default">da admissão à folha, sem sistemas soltos</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Elevation="2" Class="h-100 module-card">
                            <MudCardContent Class="d-flex flex-column align-center text-center">
                                <MudIcon Icon="@Icons.Material.Filled.PointOfSale" Color="Color.Dark" Size="Size.Large" Class="mb-2" />
                                <MudText Typo="Typo.h6">PDV</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Default">ponto de venda que fala com seu estoque em tempo real</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Elevation="2" Class="h-100 module-card">
                            <MudCardContent Class="d-flex flex-column align-center text-center">
                                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Dark" Size="Size.Large" Class="mb-2" />
                                <MudText Typo="Typo.h6">Avaliação de Desempenho</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Default">sua equipe crescendo com metas claras</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Elevation="2" Class="h-100 module-card">
                            <MudCardContent Class="d-flex flex-column align-center text-center">
                                <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Dark" Size="Size.Large" Class="mb-2" />
                                <MudText Typo="Typo.h6">Projetos</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Default">prazos, entregas e times organizados</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudCard Elevation="2" Class="h-100 module-card">
                            <MudCardContent Class="d-flex flex-column align-center text-center">
                                <MudIcon Icon="@Icons.Material.Filled.Chat" Color="Color.Dark" Size="Size.Large" Class="mb-2" />
                                <MudText Typo="Typo.h6">Rede Social Corporativa</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Default">comunicação interna sem depender de grupo de WhatsApp</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                </MudGrid>

                <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Default" Class="mt-8">
                    <em>E o que vier depois — porque o Fenicia foi construído pra crescer junto com você, não pra te prender no que ele era no dia da compra.</em>
                </MudText>
            </MudContainer>

            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-16">
                <MudGrid Spacing="6">
                    <MudItem xs="12" md="5">
                        <MudText Typo="Typo.h4" Class="mb-4">Uma conta, várias empresas</MudText>
                        <MudText Typo="Typo.body1" Color="Color.Default">
                            Administra mais de um negócio? Contador com vários clientes? Grupo com holdings diferentes? O Fenicia deixa você transitar entre empresas com a mesma conta, sem precisar logar e deslogar o dia inteiro — cada empresa com seus próprios dados, seu próprio time, isolados e seguros.
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" md="7">
                        <MudPaper Elevation="2" Class="pa-8 d-flex flex-column align-center text-center">
                            <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Primary" Size="Size.Large" Class="mb-4" />
                            <MudText Typo="Typo.h5">Multi-empresa nativo</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Default">Troque de empresa em um clique. Dados isolados. Segurança total.</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudContainer>

            <MudPaper Elevation="0" Class="pa-16" Style="background-color: #263238;">
                <MudContainer MaxWidth="MaxWidth.ExtraLarge">
                    <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Default" Class="mb-4">Código aberto. Confiança de verdade.</MudText>
                    <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Default" Class="mb-8">
                        Diferente da maioria dos ERPs do mercado, o Fenicia é <strong>open source</strong>. Isso não é só um detalhe técnico — é uma promessa: você pode auditar cada linha do que gerencia os dados da sua empresa, ninguém prende seus dados atrás de uma licença fechada, e a comunidade que usa o sistema ajuda a construir o sistema.
                    </MudText>
                    <MudStack Row="true" Spacing="2" Justify="Justify.Center" Wrap="Wrap.Wrap">
                        <MudPaper Elevation="1" Class="pa-4 d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Code" Class="mr-2" />Auditável
                        </MudPaper>
                        <MudPaper Elevation="1" Class="pa-4 d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.LockOpen" Class="mr-2" />Sem vendor lock-in
                        </MudPaper>
                        <MudPaper Elevation="1" Class="pa-4 d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.People" Class="mr-2" />Comunidade
                        </MudPaper>
                        <MudPaper Elevation="1" Class="pa-4 d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Article" Class="mr-2" />Sem letra miúda
                        </MudPaper>
                    </MudStack>
                </MudContainer>
            </MudPaper>

            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-16">
                <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-4">Pague pelo que usa. Cresça no seu ritmo.</MudText>
                <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Default" Class="mb-6">
                    Empresa pequena não deveria pagar preço de multinacional só pra ter acesso a um sistema decente. Com o Fenicia, você ativa módulo por módulo, conforme sua operação pede — sem contrato engessado, sem "pacote completo" empurrado goela abaixo.
                </MudText>
                <MudText Typo="Typo.h5" Align="Align.Center" Color="Color.Primary">
                    Comece pequeno. Cresça do seu jeito. O Fenicia acompanha.
                </MudText>
            </MudContainer>

            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pb-16">
                <MudPaper Elevation="2" Class="pa-16 d-flex flex-column align-center text-center" Style="background-color: #1976d2;">
                    <MudText Typo="Typo.h4" Color="Color.Default" Class="mb-6">Pronto pra montar o sistema que sua empresa merece?</MudText>
                    <MudStack Row="true" Spacing="2" Justify="Justify.Center" Wrap="Wrap.Wrap">
                        <MudLink Href="/login" Underline="Underline.None">
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Large" StartIcon="@Icons.Material.Filled.Login">Login</MudButton>
                        </MudLink>
                        <MudLink Href="/signup" Underline="Underline.None">
                            <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Large" StartIcon="@Icons.Material.Filled.PersonAdd">Criar minha conta</MudButton>
                        </MudLink>
                    </MudStack>
                </MudPaper>
            </MudContainer>
        </MudContainer>
    </MudMainContent>

    <MudPaper Class="pa-3" Elevation="4">
        <MudText Typo="Typo.caption" Align="Align.Center">
            <strong>Fenicia</strong> &copy; @DateTime.Now.Year — O Sistema Modular Open Source para sua Empresa.
        </MudText>
    </MudPaper>
</MudLayout>

<style>
    .logo-img {
        height: 40px;
        width: auto;
    }

    .hero-logo {
        height: 140px;
        width: auto;
        margin-bottom: 1.5rem;
        filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.3));
    }

    .module-card {
        height: 100%;
        transition: all 0.3s ease;
        border: 1px solid rgba(94, 53, 177, 0.08) !important;
    }

    .module-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 32px rgba(94, 53, 177, 0.15) !important;
        border-color: rgba(94, 53, 177, 0.2) !important;
    }

    .hero-section {
        background: linear-gradient(135deg, #1a237e 0%, #311b92 50%, #4527a0 100%);
        color: white;
        position: relative;
        overflow: hidden;
    }

        .hero-section::before {
            content: '';
            position: absolute;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(255, 111, 0, 0.3) 0%, transparent 70%);
            top: -100px;
            right: -100px;
            border-radius: 50%;
        }

        .hero-section::after {
            content: '';
            position: absolute;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(0, 191, 165, 0.25) 0%, transparent 70%);
            bottom: -50px;
            left: -50px;
            border-radius: 50%;
        }

        .hero-section > * {
            position: relative;
            z-index: 1;
        }
</style>
