@page "/forgotpassword"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>Esqueci minha senha - Fenicia</PageTitle>

<div class="auth-page">
    <MudPaper Class="auth-card" Elevation="0">
        <div class="d-flex flex-column align-center">
            <img src="/images/logo.svg" alt="Fenicia" class="auth-logo" />
        </div>
        <MudText Typo="Typo.h4" Align="Align.Center" Class="auth-title">Esqueci minha senha</MudText>
        <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="auth-subtitle">Informe seu e-mail para receber um código de recuperação</MudText>

        <EditForm Model="model" OnSubmit="HandleSubmit" OnValidSubmit="OnValidSubmit" OnInvalidSubmit="OnInvalidSubmit">
            <DataAnnotationsValidator />
            <MudTextField @bind-Value="model.Email" Label="Email" Variant="Variant.Outlined" Class="mb-4" Required="true" RequiredError="Email é obrigatório!" InputType="InputType.Email" autocomplete="username" Immediate="true" @ref="emailField" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Disabled="@(isLoading || !formIsValid)" Type="Submit" Class="mt-2">
                @if (isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Inherit" Class="mr-2" />
                    <span>Enviando...</span>
                }
                else
                {
                    <span>Enviar código</span>
                }
            </MudButton>
        </EditForm>

        @if (!string.IsNullOrEmpty(message))
        {
            <MudAlert Severity="@(isSuccess ? Severity.Success : Severity.Error)" Class="mt-4" Dense="true" Variant="Variant.Filled">@message</MudAlert>
        }

        <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-6">
            Lembrou a senha? <MudLink Href="/login" Color="Color.Primary" Underline="Underline.Always">Entrar</MudLink>
        </MudText>
    </MudPaper>
</div>

@code {
    private ForgotPasswordModel model = new();
    private string? message;
    private bool isSuccess;
    private bool isLoading;
    private bool formIsValid;
    private MudTextField<string>? emailField;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && emailField != null)
        {
            await emailField.FocusAsync();
        }
    }

    private async Task HandleSubmit()
    {
        if (isLoading)
        {
            return;
        }

        message = null;
        isLoading = true;
        StateHasChanged();

        try
        {
            var client = HttpClientFactory.CreateClient("FeniciaAuth");

            var request = new
            {
                email = model.Email
            };

            var response = await client.PostAsJsonAsync("/forgotpassword", request);
            var body = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                isSuccess = true;
                message = "Código enviado para o seu e-mail!";
                Snackbar.Add("Código enviado!", Severity.Success);
            }
            else
            {
                isSuccess = false;
                message = $"Falha ao enviar código ({(int)response.StatusCode}): {body}";
                Snackbar.Add($"Falha ao enviar código ({(int)response.StatusCode})", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            message = $"Erro: {ex.Message}";
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void OnValidSubmit()
    {
        formIsValid = true;
        StateHasChanged();
    }

    private void OnInvalidSubmit()
    {
        formIsValid = false;
        StateHasChanged();
    }

    private class ForgotPasswordModel
    {
        [Required]
        [EmailAddress]
        [MaxLength(200)]
        public string Email { get; set; } = string.Empty;
    }
}
