@page "/project/{Id:guid}"
@rendermode InteractiveServer
@using MudBlazor.Utilities
@inject NavigationManager NavigationManager
@inject IAuthStateService AuthState
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext
@inject ISnackbar Snackbar

<PageTitle>@(project?.Title ?? "Projeto") - Fenicia</PageTitle>

<MainLayout>
    @if (isLoading)
    {
        <div class="d-flex justify-content-center pa-8">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
    }
    else if (project is null)
    {
        <MudAlert Severity="Severity.Warning">Projeto não encontrado.</MudAlert>
    }
    else
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => NavigationManager.NavigateTo("/project"))" />
                <MudText Typo="Typo.h4">@project.Title</MudText>
                <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(project.Status)">@project.Status</MudChip>
            </MudStack>
            <MudStack Row="true" Spacing="2">
                @if (isCurrentUserProjectAdmin)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenStatusModal">
                        Nova Coluna
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.GroupAdd"
                               OnClick="OpenTeamModal">
                        Nova Equipe
                    </MudButton>
                }
            </MudStack>
        </MudStack>

        @if (!string.IsNullOrEmpty(project.Description))
        {
            <MudPaper Elevation="0" Class="pa-3 mb-4" Style="background-color: rgba(0,0,0,0.02); border-radius: 8px;">
                <MudText Typo="Typo.body2" Color="Color.Default">@project.Description</MudText>
            </MudPaper>
        }

        @if (orderedStatuses.Count == 0)
        {
            <MudPaper Elevation="0" Class="pa-6 text-center" Style="border: 2px dashed rgba(0,0,0,0.1); border-radius: 12px; min-width: 300px;">
                <MudIcon Icon="@Icons.Material.Filled.ViewColumn" Size="Size.Large" Color="Color.Default" />
                <MudText Typo="Typo.h6" Class="mt-2">Nenhuma coluna ainda</MudText>
                <MudText Typo="Typo.body2" Color="Color.Default" Class="mb-3">Crie a primeira coluna do seu kanban.</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenStatusModal">
                    Nova Coluna
                </MudButton>
            </MudPaper>
        }
        else
        {
            <MudDropContainer @ref="_dropContainer" T="TaskDto" Items="@tasks" ItemsSelector="@((TaskDto t, string zone) => t.StatusId.ToString() == zone)" ItemDropped="OnTaskDroppedAsync" Class="kanban-board">
                <ChildContent>
                    @foreach (var status in orderedStatuses)
                    {
                        <MudPaper Elevation="1" Class="kanban-column">
                            <div class="kanban-column-header" style="background-color: @status.Color;">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudText Typo="Typo.subtitle2" Style="color:white;"><b>@status.Name</b></MudText>
                                        <MudChip T="string" Size="Size.Small" Style="background-color: rgba(255,255,255,0.25); color: white;">@GetTasksByStatus(status.Id).Count</MudChip>
                                    </MudStack>
                                    @if (isCurrentUserProjectAdmin)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Size="Size.Small"
                                                       Style="color:white;"
                                                       OnClick="@(() => OpenStatusEditModal(status))" />
                                    }
                                </MudStack>
                            </div>
                            <MudDropZone T="TaskDto" Identifier="@status.Id.ToString()" Class="kanban-column-body" CanDrop="@((TaskDto t) => !t.IsFinal)" />
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       FullWidth="true"
                                       Class="kanban-column-add"
                                       OnClick="@(() => OpenTaskCreateModal(status.Id))">
                                Adicionar Tarefa
                            </MudButton>
                        </MudPaper>
                    }
                </ChildContent>
                <ItemRenderer>
                    @{
                        var task = context;
                        var status = orderedStatuses.FirstOrDefault(s => s.Id == task.StatusId);
                    }
                    <MudPaper Elevation="1" Class="@GetTaskCardClass(task, status ?? new StatusDto { Id = task.StatusId, Name = string.Empty, Color = "#6366f1", Order = 0, IsFinal = false })" @onclick="@(() => OpenTaskModal(task))">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudChip T="string" Size="Size.Small" Color="@GetPriorityColor(task.Priority)">@task.Priority</MudChip>
                            @if (task.DueDate.HasValue)
                            {
                                <MudText Typo="Typo.caption" Color="@(task.DueDate.Value < DateTime.UtcNow ? Color.Error : Color.Default)">
                                    @task.DueDate.Value.ToString("dd/MM")
                                </MudText>
                            }
                        </MudStack>
                        <MudText Typo="Typo.subtitle2" Class="mb-1" Style="@((status?.IsFinal ?? false) ? "text-decoration: line-through; opacity:0.6;" : "")">@task.Title</MudText>
                        @if (!string.IsNullOrEmpty(task.Description))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Default" Class="mb-1" Style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                                @task.Description
                            </MudText>
                        }
                        @if (task.EstimatePoints.HasValue)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@task.EstimatePoints pts</MudChip>
                        }
                        @if (task.Assignees.Count > 0)
                        {
                            <MudStack Row="true" Spacing="-1" AlignItems="AlignItems.Center" Class="ml-auto">
                                @foreach (var a in task.Assignees.Take(3))
                                {
                                    <MudTooltip Text="@($"{a.UserName} ({a.UserEmail})")">
                                        <MudAvatar Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Class="assignee-avatar">@GetInitials(a.UserName)</MudAvatar>
                                    </MudTooltip>
                                }
                                @if (task.Assignees.Count > 3)
                                {
                                    <MudAvatar Size="Size.Small" Color="Color.Default" Variant="Variant.Filled" Class="assignee-avatar">+@(task.Assignees.Count - 3)</MudAvatar>
                                }
                            </MudStack>
                        }
                    </MudPaper>
                </ItemRenderer>
            </MudDropContainer>
        }

        <MudPaper Elevation="1" Class="pa-4 mt-6">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudText Typo="Typo.h6">Equipes</MudText>
            </MudStack>
            @if (teams.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Default">Nenhuma equipe cadastrada. @if (isCurrentUserProjectAdmin) { <text>Clique em "Nova Equipe" para começar.</text> }</MudText>
            }
            else
            {
                <MudGrid>
                    @foreach (var team in teams)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudPaper Elevation="1" Class="pa-3" Style="@($"border-left: 6px solid {team.Color}; border-radius: 8px;")">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudText Typo="Typo.subtitle1"><b>@team.Name</b></MudText>
                                        <MudChip T="string" Size="Size.Small">@team.MemberCount membros</MudChip>
                                    </MudStack>
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Outlined"
                                               StartIcon="@Icons.Material.Filled.People"
                                               OnClick="@(() => OpenMembersModalAsync(team))">
                                        Membros
                                    </MudButton>
                                </MudStack>
                                @if (!string.IsNullOrEmpty(team.Description))
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Default" Class="mt-1 mb-2">@team.Description</MudText>
                                }
                                @if (team.Members.Count > 0)
                                {
                                    <MudStack Row="true" Spacing="-1" AlignItems="AlignItems.Center" Class="mt-2">
                                        @foreach (var m in team.Members.Take(5))
                                        {
                                            <MudTooltip Text="@($"{m.UserName} ({m.Email}) - {m.Role}")">
                                                <MudAvatar Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Class="assignee-avatar">@GetInitials(m.UserName)</MudAvatar>
                                            </MudTooltip>
                                        }
                                        @if (team.Members.Count > 5)
                                        {
                                            <MudAvatar Size="Size.Small" Color="Color.Default" Variant="Variant.Filled" Class="assignee-avatar">+@(team.Members.Count - 5)</MudAvatar>
                                        }
                                    </MudStack>
                                }
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudPaper>
    }
</MainLayout>

<MudDialog @bind-Visible="statusDialogVisible" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(statusEditModel.Id == Guid.Empty ? "Nova Coluna" : "Editar Coluna")</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudTextField @bind-Value="statusEditModel.Name" Label="Nome" Variant="Variant.Outlined" MaxLength="100" Required="true" RequiredError="Nome é obrigatório!" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudPaper Elevation="0" Style="@($"width:36px;height:36px;border-radius:8px;background-color:{statusEditModel.Color};border:1px solid rgba(0,0,0,0.1);cursor:pointer;")"
                             @onclick="@(() => colorPickerOpen = !colorPickerOpen)" />
                    <MudTextField @bind-Value="statusEditModel.Color" Label="Cor" Variant="Variant.Outlined" MaxLength="20" Placeholder="#6366f1" Style="flex-grow:1" />
                </MudStack>
                @if (colorPickerOpen)
                {
                    <MudPaper Elevation="4" Class="pa-3 mt-2" Style="position:relative; z-index:10;">
                        <MudColorPicker Value="@statusEditModel.Color" ValueChanged="@(v => OnColorPicked(v))" ShowAlpha="false" ShowInputs="true" PickerVariant="PickerVariant.Inline" />
                    </MudPaper>
                }
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="int" @bind-Value="statusEditModel.Order" Label="Ordem" Variant="Variant.Outlined" Min="0" />
            </MudItem>
            <MudItem xs="12">
                <MudSwitch T="bool" @bind-Value="statusEditModel.IsFinal" Label="Coluna final (concluída)" Color="Color.Success" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        @if (statusEditModel.Id != Guid.Empty)
        {
            <MudButton OnClick="DeleteStatusAsync" Variant="Variant.Text" Color="Color.Error" Disabled="@statusSaving">Excluir</MudButton>
        }
        <MudButton OnClick="CloseStatusModal" Variant="Variant.Text">Cancelar</MudButton>
        <MudButton OnClick="SaveStatusAsync" Variant="Variant.Filled" Color="Color.Primary" Disabled="@statusSaving">
            @if (statusSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Default" Class="mr-2" />
            }
            Salvar
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="taskDialogVisible" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(taskEditModel.Id == Guid.Empty ? "Nova Tarefa" : "Editar Tarefa")</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudTextField @bind-Value="taskEditModel.Title" Label="Título" Variant="Variant.Outlined" MaxLength="200" Required="true" RequiredError="Título é obrigatório!" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="taskEditModel.Description" Label="Descrição" Variant="Variant.Outlined" Lines="3" MaxLength="2000" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" @bind-Value="taskEditModel.Priority" Label="Prioridade" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Low")">Baixa</MudSelectItem>
                    <MudSelectItem Value="@("Medium")">Média</MudSelectItem>
                    <MudSelectItem Value="@("High")">Alta</MudSelectItem>
                    <MudSelectItem Value="@("Critical")">Crítica</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" @bind-Value="taskEditModel.Type" Label="Tipo" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Task")">Tarefa</MudSelectItem>
                    <MudSelectItem Value="@("Bug")">Bug</MudSelectItem>
                    <MudSelectItem Value="@("Feature")">Feature</MudSelectItem>
                    <MudSelectItem Value="@("Improvement")">Melhoria</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid" @bind-Value="taskEditModel.StatusId" Label="Coluna" Variant="Variant.Outlined" Required="true">
                    @foreach (var s in orderedStatuses)
                    {
                        <MudSelectItem T="Guid" Value="@s.Id">@s.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="int?" @bind-Value="taskEditModel.EstimatePoints" Label="Pontos Estimados" Variant="Variant.Outlined" Min="0" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="taskEditModel.DueDateValue" Label="Data de Entrega" Variant="Variant.Outlined" />
            </MudItem>
            @if (taskEditModel.Id != Guid.Empty)
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">Responsáveis</MudText>
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                        @if (taskEditModel.Assignees.Count == 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Default">Ninguém atribuído ainda.</MudText>
                        }
                        @foreach (var a in taskEditModel.Assignees)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" OnClose="@(() => RemoveAssigneeAsync(a))" CloseIcon="@Icons.Material.Filled.Close">@a.UserName</MudChip>
                        }
                    </MudStack>
                    <MudAutocomplete T="UserSummaryDto" Label="Adicionar responsável" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Class="mt-2"
                                     SearchFunc="@(async (string value, CancellationToken ct) => { await SearchUsersAsync(value); return userSearchResults.AsEnumerable(); })" ToStringFunc="@(u => u is null ? string.Empty : u.Name)" ValueChanged="@(async (UserSummaryDto? u) => await AddAssigneeAsync(u))"
                                     ResetValueOnEmptyText="true" Clearable="true" MaxItems="10" />
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Subtarefas (@taskEditModel.Subtasks.Count(s => s.IsCompleted)/@taskEditModel.Subtasks.Count)</MudText>
                    <MudStack Spacing="1">
                        @foreach (var s in taskEditModel.Subtasks.OrderBy(x => x.Order))
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudCheckBox T="bool" Value="@s.IsCompleted" ValueChanged="@(async (bool v) => await ToggleSubtaskAsync(s, v))" Dense="true" />
                                <MudText Typo="Typo.body2" Style="@(s.IsCompleted ? "text-decoration: line-through; opacity:0.6; flex-grow:1;" : "flex-grow:1;")">@s.Title</MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Default" OnClick="@(() => RemoveSubtaskAsync(s))" />
                            </MudStack>
                        }
                    </MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-1">
                        <MudTextField @bind-Value="newSubtaskTitle" Label="Nova subtarefa" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" MaxLength="200" Style="flex-grow:1;"
                                      OnKeyDown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") { await AddSubtaskAsync(); } })" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddSubtaskAsync" Disabled="@(string.IsNullOrWhiteSpace(newSubtaskTitle) || isAddingSubtask)">Adicionar</MudButton>
                    </MudStack>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Comentários (@taskEditModel.Comments.Count)</MudText>
                    <MudPaper Elevation="0" Class="pa-2" Style="max-height: 240px; overflow-y: auto; background-color: rgba(0,0,0,0.02); border-radius: 8px;">
                        @if (taskEditModel.Comments.Count == 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Default">Nenhum comentário ainda.</MudText>
                        }
                        @foreach (var c in taskEditModel.Comments.OrderBy(x => x.Created))
                        {
                            <MudStack Row="false" Spacing="0" Class="mb-2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudAvatar Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled" Class="assignee-avatar">@GetInitials(c.UserName)</MudAvatar>
                                    <MudText Typo="Typo.caption"><b>@(string.IsNullOrWhiteSpace(c.UserName) ? "Usuário" : c.UserName)</b></MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Default">· @c.Created.ToLocalTime().ToString("dd/MM HH:mm")</MudText>
                                    @if (c.UserId == currentUserId)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Default" OnClick="@(() => RemoveCommentAsync(c))" />
                                    }
                                </MudStack>
                                <MudText Typo="Typo.body2" Class="ml-7" Style="white-space: pre-wrap;">@c.Content</MudText>
                            </MudStack>
                        }
                    </MudPaper>
                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="1" Class="mt-1">
                        <MudTextField @bind-Value="newCommentContent" Label="Escrever comentário" Variant="Variant.Outlined" Lines="2" MaxLength="4096" Style="flex-grow:1;"
                                      OnKeyDown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter" && !e.ShiftKey) { await AddCommentAsync(); } })" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send" OnClick="AddCommentAsync" Disabled="@(string.IsNullOrWhiteSpace(newCommentContent) || isAddingComment)">Enviar</MudButton>
                    </MudStack>
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        @if (taskEditModel.Id != Guid.Empty)
        {
            <MudButton OnClick="DeleteTaskAsync" Variant="Variant.Text" Color="Color.Error" Disabled="@taskSaving">Excluir</MudButton>
        }
        <MudButton OnClick="CloseTaskModal" Variant="Variant.Text">Cancelar</MudButton>
        <MudButton OnClick="SaveTaskAsync" Variant="Variant.Filled" Color="Color.Primary" Disabled="@taskSaving">
            @if (taskSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Default" Class="mr-2" />
            }
            Salvar
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="teamDialogVisible" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Nova Equipe</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudTextField @bind-Value="teamEditModel.Name" Label="Nome" Variant="Variant.Outlined" MaxLength="128" Required="true" RequiredError="Nome é obrigatório!" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="teamEditModel.Description" Label="Descrição" Variant="Variant.Outlined" Lines="2" MaxLength="2000" />
            </MudItem>
            <MudItem xs="12">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudPaper Elevation="0" Style="@($"width:36px;height:36px;border-radius:8px;background-color:{teamEditModel.Color};border:1px solid rgba(0,0,0,0.1);cursor:pointer;")" @onclick="@(() => colorPickerOpen = !colorPickerOpen)" />
                    <MudTextField @bind-Value="teamEditModel.Color" Label="Cor" Variant="Variant.Outlined" MaxLength="30" Placeholder="#6366f1" Style="flex-grow:1" />
                </MudStack>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseTeamModal" Variant="Variant.Text">Cancelar</MudButton>
        <MudButton OnClick="SaveTeamAsync" Variant="Variant.Filled" Color="Color.Primary" Disabled="@teamSaving">
            @if (teamSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Default" Class="mr-2" />
            }
            Salvar
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="teamMembersDialogVisible" Options="teamMembersDialogOptions">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudPaper Elevation="0" Style="@($"width:14px;height:14px;border-radius:50%;background-color:{membersTarget?.Color};")" />
            <MudText Typo="Typo.h6">@(membersTarget?.Name ?? "Equipe")</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle2" Class="mb-2">Membros</MudText>
        @if (teamMembers.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Default" Class="mb-3">Nenhum membro ainda.</MudText>
        }
        else
        {
            <MudList T="TeamMemberDto" Dense="true" Class="mb-3">
                @foreach (var member in teamMembers)
                {
                    <MudListItem T="TeamMemberDto" Icon="@Icons.Material.Filled.Person">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="width:100%">
                            <div>
                                <MudText Typo="Typo.body2"><b>@member.UserName</b></MudText>
                                <MudText Typo="Typo.caption" Color="Color.Default">@member.Email</MudText>
                            </div>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudChip T="string" Size="Size.Small" Color="@(member.Role == "Admin" ? Color.Primary : Color.Default)">@member.Role</MudChip>
                                <MudIconButton Size="Size.Small"
                                               Icon="@Icons.Material.Outlined.PersonRemove"
                                               Color="Color.Error"
                                               Disabled="@(!isCurrentUserProjectAdmin && member.UserId != currentUserId)"
                                               OnClick="@(() => RemoveTeamMemberAsync(member))" />
                            </MudStack>
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        }

        @if (isCurrentUserProjectAdmin)
        {
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2" Class="mb-2">Adicionar membro</MudText>
            <MudAutocomplete T="UserSummaryDto"
                             Label="Buscar usuário por nome ou e-mail"
                             Variant="Variant.Outlined"
                             SearchFunc="@(async (string value, CancellationToken ct) => { await SearchUsersAsync(value); return userSearchResults; })"
                             ToStringFunc="@(u => u is null ? string.Empty : $"{u.Name} ({u.Email})")"
