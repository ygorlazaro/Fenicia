    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpperInvariant();
    }

    private async Task AddAssigneeAsync(UserSummaryDto? user)
    {
        if (user is null || user.Id == Guid.Empty) return;
        if (taskEditModel.Assignees.Any(a => a.UserId == user.Id)) return;
        try
        {
            var client = await CreateClientAsync();
            var payload = new
            {
                Id = Guid.NewGuid(),
                TaskId = taskEditModel.Id,
                UserId = user.Id,
                Role = "Owner",
                AssignedAt = DateTime.UtcNow,
            };
            var json = System.Text.Json.JsonSerializer.Serialize(payload);
            var response = await client.PostAsync("/projecttaskassignee", new StringContent(json, System.Text.Encoding.UTF8, "application/json"));
            if (response.IsSuccessStatusCode)
            {
                var respJson = await response.Content.ReadAsStringAsync();
                var created = System.Text.Json.JsonSerializer.Deserialize<AddProjectTaskAssigneeResponse>(respJson,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (created is not null)
                {
                    taskEditModel.Assignees.Add(new AssigneeFormModel
                    {
                        Id = created.Id,
                        UserId = created.UserId,
                        UserName = user.Name,
                        UserEmail = user.Email,
                    });
                    var t = tasks.FirstOrDefault(x => x.Id == taskEditModel.Id);
                    if (t is not null)
                    {
                        t.Assignees.Add(new AssigneeDto
                        {
                            Id = created.Id,
                            UserId = created.UserId,
                            UserName = user.Name,
                            UserEmail = user.Email,
                        });
                    }
                    Snackbar.Add($"{user.Name} atribuído à tarefa.", Severity.Success);
                }
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Falha ao atribuir: {(int)response.StatusCode} {body}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
        }
    }

