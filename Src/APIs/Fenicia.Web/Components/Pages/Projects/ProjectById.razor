    private async Task PromoteFirstToAdmin()
    {
        if (membersTarget is null) return;
        var first = teamMembers.FirstOrDefault();
        if (first is null) return;
        try
        {
            var client = await CreateClientAsync();
            var payload = new { Role = "Admin" };
            var json = System.Text.Json.JsonSerializer.Serialize(payload);
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
            var response = await client.PatchAsync($"/team/{membersTarget.Id}/members/{first.UserId}/role", content);
            if (response.IsSuccessStatusCode)
            {
                first.Role = "Admin";
                isCurrentUserProjectAdmin = true;
                Snackbar.Add($"{first.UserName} agora é Admin.", Severity.Success);
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Falha: {(int)response.StatusCode} {body}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
        }
    }

    private List<StatusDto> orderedStatuses => statuses.Where(s => s.ProjectId == Id).OrderBy(s => s.Order).ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var isAuthenticated = await AuthState.IsAuthenticatedAsync();
            if (!isAuthenticated)
            {
                NavigationManager.NavigateTo("/login");
                return;
            }
            currentUserId = await CompanyContext.GetUserIdAsync();
            await LoadAllAsync();
        }
    }

    private async Task<HttpClient> CreateClientAsync()
    {
        var client = HttpClientFactory.CreateClient("FeniciaProjects");
        var token = await CompanyContext.GetTokenAsync();
        if (!string.IsNullOrEmpty(token))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }
        var companyId = await CompanyContext.GetSelectedCompanyIdAsync();
        if (companyId.HasValue)
        {
            client.DefaultRequestHeaders.Remove("CompanyId");
            client.DefaultRequestHeaders.Add("CompanyId", companyId.Value.ToString());
        }
        return client;
    }

    private async Task LoadAllAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();
            var client = await CreateClientAsync();
            var projectTask = client.GetAsync($"/project/{Id}");
            var statusesTask = client.GetAsync("/projectstatus?page=1&perPage=200");
            var tasksTask = client.GetAsync("/projecttask?page=1&perPage=500");
            var teamsTask = client.GetAsync($"/team/project/{Id}");
            await Task.WhenAll(projectTask, statusesTask, tasksTask, teamsTask);

            if (projectTask.Result.IsSuccessStatusCode)
            {
                var json = await projectTask.Result.Content.ReadAsStringAsync();
                project = System.Text.Json.JsonSerializer.Deserialize<ProjectDto>(json,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            }
            else if (projectTask.Result.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                errorMessage = "Projeto não encontrado.";
                return;
            }

            if (statusesTask.Result.IsSuccessStatusCode)
            {
                var json = await statusesTask.Result.Content.ReadAsStringAsync();
                statuses = System.Text.Json.JsonSerializer.Deserialize<List<StatusDto>>(json,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? [];
            }
            if (tasksTask.Result.IsSuccessStatusCode)
            {
                var json = await tasksTask.Result.Content.ReadAsStringAsync();
                tasks = System.Text.Json.JsonSerializer.Deserialize<List<TaskDto>>(json,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? [];
                foreach (var t in tasks)
                {
                    t.IsFinal = statuses.Any(s => s.Id == t.StatusId && s.IsFinal);
                }
            }
            if (teamsTask.Result.IsSuccessStatusCode)
            {
                var json = await teamsTask.Result.Content.ReadAsStringAsync();
                teams = System.Text.Json.JsonSerializer.Deserialize<List<TeamDto>>(json,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? [];
            }
            else
            {
                teams = [];
            }

            var isOwner = project is not null && project.Owner == currentUserId;
            isCurrentUserProjectAdmin = currentUserId != Guid.Empty &&
                (isOwner || teams.Any(t => t.Members.Any(m => m.UserId == currentUserId && m.Role == "Admin")));
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private List<TaskDto> GetTasksByStatus(Guid statusId) => tasks
        .Where(t => t.StatusId == statusId && t.ProjectId == Id)
        .OrderBy(t => t.Order)
        .ToList();

    private string GetTaskCardClass(TaskDto task, StatusDto status)
    {
        var classes = new List<string> { "pa-3", "mb-2", "kanban-task" };
        if (task.DueDate.HasValue)
        {
            var daysLeft = (task.DueDate.Value.Date - DateTime.UtcNow.Date).TotalDays;
            if (daysLeft < 0)
            {
                classes.Add("task-overdue");
            }
            else if (daysLeft <= 3)
            {
                classes.Add("task-due-soon");
            }
            else
            {
                classes.Add("task-on-track");
            }
        }

        if (status.IsFinal)
        {
            classes.Add("task-final");
        }

        return string.Join(" ", classes);
    }

    private async Task OnTaskDroppedAsync(MudItemDropInfo<TaskDto> drop)
    {
        if (drop.Item is null || drop.DropzoneIdentifier is null) return;
        if (!Guid.TryParse(drop.DropzoneIdentifier, out var newStatusId)) return;
        if (drop.Item.StatusId == newStatusId) return;

        var targetStatus = orderedStatuses.FirstOrDefault(s => s.Id == newStatusId);
        if (targetStatus is null || targetStatus.IsFinal) return;

        var oldStatusId = drop.Item.StatusId;
        drop.Item.StatusId = newStatusId;
        var newOrder = GetTasksByStatus(newStatusId).Count;
        drop.Item.Order = newOrder;
        drop.Item.IsFinal = targetStatus.IsFinal;
        await InvokeAsync(StateHasChanged);

        try
        {
            var client = await CreateClientAsync();
            var payload = new
            {
                Id = drop.Item.Id,
                ProjectId = drop.Item.ProjectId,
                StatusId = newStatusId,
                Title = drop.Item.Title,
                Description = drop.Item.Description,
                Priority = drop.Item.Priority,
                Type = drop.Item.Type,
                Order = newOrder,
                EstimatePoints = drop.Item.EstimatePoints,
                DueDate = drop.Item.DueDate,
                CreatedBy = drop.Item.CreatedBy,
            };
            var json = System.Text.Json.JsonSerializer.Serialize(payload);
            var response = await client.PatchAsync($"/projecttask/{drop.Item.Id}", new StringContent(json, System.Text.Encoding.UTF8, "application/json"));
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Falha ao mover tarefa: {(int)response.StatusCode} {body}", Severity.Error);
                drop.Item.StatusId = oldStatusId;
                drop.Item.IsFinal = statuses.Any(s => s.Id == oldStatusId && s.IsFinal);
            }
            else
            {
                Snackbar.Add($"Tarefa movida para \"{targetStatus.Name}\".", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
            drop.Item.StatusId = oldStatusId;
            drop.Item.IsFinal = statuses.Any(s => s.Id == oldStatusId && s.IsFinal);
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

