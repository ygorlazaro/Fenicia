                {
                    if (string.IsNullOrWhiteSpace(created.UserName))
                    {
                        created.UserName = "Você";
                    }
                    taskEditModel.Comments.Add(created);
                    var t = tasks.FirstOrDefault(x => x.Id == taskEditModel.Id);
                    t?.Comments.Add(created);
                    newCommentContent = string.Empty;
                    Snackbar.Add("Comentário enviado.", Severity.Success);
                }
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Falha: {(int)response.StatusCode} {body}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
        }
        finally
        {
            isAddingComment = false;
        }
    }

    private async Task RemoveCommentAsync(CommentDto comment)
    {
        try
        {
            var client = await CreateClientAsync();
            var response = await client.DeleteAsync($"/projectcomment/{comment.Id}");
            if (response.IsSuccessStatusCode || response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                taskEditModel.Comments.RemoveAll(c => c.Id == comment.Id);
                var t = tasks.FirstOrDefault(x => x.Id == taskEditModel.Id);
                t?.Comments.RemoveAll(c => c.Id == comment.Id);
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Falha: {(int)response.StatusCode} {body}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
        }
    }

