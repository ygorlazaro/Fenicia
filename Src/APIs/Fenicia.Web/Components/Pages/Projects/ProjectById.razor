                    Title = taskEditModel.Title,
                    Description = taskEditModel.Description,
                    Priority = taskEditModel.Priority,
                    Type = taskEditModel.Type,
                    Order = taskEditModel.Order,
                    EstimatePoints = taskEditModel.EstimatePoints,
                    DueDate = taskEditModel.DueDateValue,
                    CreatedBy = currentUserId,
                };
                var json = System.Text.Json.JsonSerializer.Serialize(payload);
                response = await client.PostAsync("/projecttask", new StringContent(json, System.Text.Encoding.UTF8, "application/json"));
            }
            else
            {
                var payload = new
                {
                    Id = taskEditModel.Id,
                    ProjectId = taskEditModel.ProjectId,
                    StatusId = taskEditModel.StatusId,
                    Title = taskEditModel.Title,
                    Description = taskEditModel.Description,
                    Priority = taskEditModel.Priority,
                    Type = taskEditModel.Type,
                    Order = taskEditModel.Order,
                    EstimatePoints = taskEditModel.EstimatePoints,
                    DueDate = taskEditModel.DueDateValue,
                    CreatedBy = taskEditModel.CreatedBy,
                };
                var json = System.Text.Json.JsonSerializer.Serialize(payload);
                response = await client.PatchAsync($"/projecttask/{taskEditModel.Id}", new StringContent(json, System.Text.Encoding.UTF8, "application/json"));
            }
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Tarefa salva!", Severity.Success);
