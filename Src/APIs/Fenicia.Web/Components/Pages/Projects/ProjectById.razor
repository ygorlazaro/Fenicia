            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
            var response = await client.PostAsync("/team", content);
            if (response.IsSuccessStatusCode)
            {
                var created = System.Text.Json.JsonSerializer.Deserialize<TeamDto>(await response.Content.ReadAsStringAsync(),
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (created is not null)
                {
                    var adminPayload = new
                    {
                        Id = Guid.NewGuid(),
                        TeamId = created.Id,
                        UserId = currentUserId,
                        Role = "Admin",
                    };
                    var adminJson = System.Text.Json.JsonSerializer.Serialize(adminPayload);
                    var adminContent = new StringContent(adminJson, System.Text.Encoding.UTF8, "application/json");
                    await client.PostAsync("/team/members", adminContent);
                }
                Snackbar.Add("Equipe criada!", Severity.Success);
                teamDialogVisible = false;
                await LoadAllAsync();
