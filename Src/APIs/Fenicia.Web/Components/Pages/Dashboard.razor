@page "/dashboard"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IAuthStateService AuthState
@inject ICompanyContextService CompanyContext
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar

@using System.Net.Http.Json
@using System.Text.Json

<PageTitle>Painel Financeiro - Fenicia</PageTitle>

<MainLayout>
    @if (isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="my-16">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.body2" Color="Color.Default" Class="mt-2">Carregando painel financeiro...</MudText>
        </MudStack>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@errorMessage</MudAlert>
    }
    else
    {
        <MudGrid Spacing="3">
            <MudItem xs="12">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap">
                        <div>
                            <MudText Typo="Typo.h5">Painel Financeiro</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Default">
                                Visão consolidada dos últimos @_days dias
                            </MudText>
                        </div>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudSelect T="int" @bind-Value="_days" Label="Período" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 160px">
                                <MudSelectItem T="int" Value="7">7 dias</MudSelectItem>
                                <MudSelectItem T="int" Value="30">30 dias</MudSelectItem>
                                <MudSelectItem T="int" Value="60">60 dias</MudSelectItem>
                                <MudSelectItem T="int" Value="90">90 dias</MudSelectItem>
                                <MudSelectItem T="int" Value="180">180 dias</MudSelectItem>
                                <MudSelectItem T="int" Value="365">1 ano</MudSelectItem>
                            </MudSelect>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAllAsync">
                                Atualizar
                            </MudButton>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="2" Class="pa-4 kpi-card kpi-success">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                        <div>
                            <MudText Typo="Typo.overline" Color="Color.Default">Receita Total</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Success">@_financial.Kpi.TotalRevenue.ToString("C")</MudText>
                        </div>
                        <MudAvatar Color="Color.Success" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Filled.AttachMoney" />
                        </MudAvatar>
                    </MudStack>
                    <MudText Typo="Typo.caption" Color="Color.Default" Class="mt-2">
                        @_financial.Kpi.TotalOrders pedido(s) · Ticket médio: @_financial.Kpi.AverageOrderValue.ToString("C")
                    </MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="2" Class="pa-4 kpi-card kpi-error">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                        <div>
                            <MudText Typo="Typo.overline" Color="Color.Default">Custo Total</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Error">@_financial.Kpi.TotalCost.ToString("C")</MudText>
                        </div>
                        <MudAvatar Color="Color.Error" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Filled.MoneyOff" />
                        </MudAvatar>
                    </MudStack>
                    <MudText Typo="Typo.caption" Color="Color.Default" Class="mt-2">
                        Custo de mercadoria no período
                    </MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="2" Class="pa-4 kpi-card">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                        <div>
                            <MudText Typo="Typo.overline" Color="Color.Default">Lucro Bruto</MudText>
                            <MudText Typo="Typo.h5" Color="@ProfitColor">@_financial.Kpi.GrossProfit.ToString("C")</MudText>
                        </div>
                        <MudAvatar Color="@ProfitColor" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Filled.Savings" />
                        </MudAvatar>
                    </MudStack>
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-2">
                        <MudText Typo="Typo.caption" Color="Color.Default">Margem:</MudText>
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="@ProfitColor"
                                 Variant="Variant.Filled">
                            @_financial.Kpi.ProfitMargin.ToString("N1")%
                        </MudChip>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="2" Class="pa-4 kpi-card kpi-info">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                        <div>
                            <MudText Typo="Typo.overline" Color="Color.Default">Estoque</MudText>
                            <MudText Typo="Typo.h5">@_financial.Kpi.TotalProducts produto(s)</MudText>
                        </div>
                        <MudAvatar Color="Color.Info" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory2" />
                        </MudAvatar>
                    </MudStack>
                    <MudText Typo="Typo.caption" Color="Color.Default" Class="mt-2">
                        <MudLink Href="/basic/inventory" Underline="Underline.Hover">Ver inventário</MudLink>
                    </MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="8">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudText Typo="Typo.h6">Receita vs Custo</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                            @_revenueChartLabels.Length período(s)
                        </MudChip>
                    </MudStack>
                    @if (_revenueChartLabels.Length == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Sem dados no período.</MudAlert>
                    }
                    else
                    {
                        <div class="chart-wrap">
                            <MudChart T="double" ChartType="ChartType.Line"
                                      ChartSeries="@_revenueChartSeries"
                                      ChartLabels="@_revenueChartLabels"
                                      ChartOptions="@_lineOptions"
                                      Width="100%"
                                      Height="320px" />
                        </div>
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-3">Pedidos por Status</MudText>
                    @if (_statusLabels.Length == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Sem pedidos.</MudAlert>
                    }
                    else
                    {
                        <div class="chart-wrap">
                            <MudChart T="double" ChartType="ChartType.Donut"
                                      ChartSeries="@_statusSeries"
                                      ChartLabels="@_statusLabels"
                                      ChartOptions="@_donutOptions"
                                      Width="100%"
                                      Height="280px" />
                        </div>
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudText Typo="Typo.h6">Vendas Recentes</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                            Hoje / Semana / Mês
                        </MudChip>
                    </MudStack>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="4">
                            <div class="period-card">
                                <MudText Typo="Typo.caption" Color="Color.Default">Hoje</MudText>
                                <MudText Typo="Typo.h6">@_financial.DailySales.TodayRevenue.ToString("C")</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Default">@_financial.DailySales.TodayOrders pedido(s)</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <div class="period-card">
                                <MudText Typo="Typo.caption" Color="Color.Default">Esta semana</MudText>
                                <MudText Typo="Typo.h6">@_financial.DailySales.WeekRevenue.ToString("C")</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Default">@_financial.DailySales.WeekOrders pedido(s)</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <div class="period-card">
                                <MudText Typo="Typo.caption" Color="Color.Default">Este mês</MudText>
                                <MudText Typo="Typo.h6">@_financial.DailySales.MonthRevenue.ToString("C")</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Default">@_financial.DailySales.MonthOrders pedido(s)</MudText>
                            </div>
                        </MudItem>
                    </MudGrid>

                    <MudDivider Class="my-3" />

                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Default">Crescimento vs mês anterior</MudText>
                            <MudText Typo="Typo.subtitle2">Mês anterior: @_financial.DailySales.PreviousMonthRevenue.ToString("C")</MudText>
                        </div>
                        <MudChip T="string"
                                 Size="Size.Medium"
                                 Color="@GrowthColor"
                                 Variant="Variant.Filled"
                                 Icon="@GrowthIcon">
                            @GrowthLabel
                        </MudChip>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-3">Contas a Receber</MudText>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <div class="period-card">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Color="Color.Warning" Size="Size.Small" />
                                    <MudText Typo="Typo.caption" Color="Color.Default">Pendentes</MudText>
                                </MudStack>
                                <MudText Typo="Typo.h6" Color="Color.Warning">@_financial.AccountsReceivable.TotalPending.ToString("C")</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Default">@_financial.AccountsReceivable.PendingOrdersCount pedido(s)</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <div class="period-card">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                    <MudText Typo="Typo.caption" Color="Color.Default">Aprovados</MudText>
                                </MudStack>
                                <MudText Typo="Typo.h6" Color="Color.Success">@_financial.AccountsReceivable.TotalApproved.ToString("C")</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Default">@_financial.AccountsReceivable.ApprovedOrdersCount pedido(s)</MudText>
                            </div>
                        </MudItem>
                    </MudGrid>

                    <MudDivider Class="my-3" />

                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Default">Total a receber</MudText>
                            <MudText Typo="Typo.h5">@(_financial.AccountsReceivable.TotalPending + _financial.AccountsReceivable.TotalApproved).ToString("C")</MudText>
                        </div>
                        <MudLink Href="/basic/order" Underline="Underline.Hover">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.ReceiptLong">
                                Ver pedidos
                            </MudButton>
                        </MudLink>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-3">Top Clientes</MudText>
                    @if (_orderAnalytics.TopCustomers.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Sem pedidos no período.</MudAlert>
                    }
                    else
                    {
                        <MudSimpleTable Hover="true" Dense="true" Bordered="false">
                            <thead>
                                <tr>
                                    <th>Cliente</th>
                                    <th style="text-align:right">Pedidos</th>
                                    <th style="text-align:right">Itens</th>
                                    <th style="text-align:right">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in _orderAnalytics.TopCustomers.Take(5))
                                {
                                    <tr>
                                        <td>
                                            <MudLink Href="@($"/basic/customer?edit={c.CustomerId}")" Underline="Underline.Hover">
                                                @c.CustomerName
                                            </MudLink>
                                        </td>
                                        <td style="text-align:right">@c.OrderCount</td>
                                        <td style="text-align:right">@c.TotalItems.ToString("N0")</td>
                                        <td style="text-align:right"><strong>@c.TotalSpent.ToString("C")</strong></td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-3">Ticket Médio</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <div class="period-card">
                                <MudText Typo="Typo.caption" Color="Color.Default">Médio</MudText>
                                <MudText Typo="Typo.h6">@_orderAnalytics.AverageOrderValue.AverageValue.ToString("C")</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <div class="period-card">
                                <MudText Typo="Typo.caption" Color="Color.Default">Mediano</MudText>
                                <MudText Typo="Typo.h6">@_orderAnalytics.AverageOrderValue.MedianValue.ToString("C")</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <div class="period-card">
                                <MudText Typo="Typo.caption" Color="Color.Default">Mínimo</MudText>
                                <MudText Typo="Typo.h6" Color="Color.Warning">@_orderAnalytics.AverageOrderValue.MinValue.ToString("C")</MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <div class="period-card">
                                <MudText Typo="Typo.caption" Color="Color.Default">Máximo</MudText>
                                <MudText Typo="Typo.h6" Color="Color.Success">@_orderAnalytics.AverageOrderValue.MaxValue.ToString("C")</MudText>
                            </div>
                        </MudItem>
                    </MudGrid>
                    <MudDivider Class="my-2" />
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2" Color="Color.Default">Total de pedidos:</MudText>
                        <MudText><strong>@_orderAnalytics.AverageOrderValue.TotalOrders</strong></MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudText Typo="Typo.h6">Produtos Mais Vendidos</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                            Top @_productPerformance.BestSellingProducts.Count
                        </MudChip>
                    </MudStack>
                    @if (_productPerformance.BestSellingProducts.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Sem vendas no período.</MudAlert>
                    }
                    else
                    {
                        <MudSimpleTable Hover="true" Dense="true" Bordered="false">
                            <thead>
                                <tr>
                                    <th>Produto</th>
                                    <th>Categoria</th>
                                    <th style="text-align:right">Qtd.</th>
                                    <th style="text-align:right">Receita</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in _productPerformance.BestSellingProducts.Take(5))
                                {
                                    <tr>
                                        <td>
                                            <MudLink Href="@($"/basic/product?edit={p.ProductId}")" Underline="Underline.Hover">
                                                @p.ProductName
                                            </MudLink>
                                        </td>
                                        <td>
                                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@p.CategoryName</MudChip>
                                        </td>
                                        <td style="text-align:right">@p.TotalQuantitySold.ToString("N0")</td>
                                        <td style="text-align:right"><strong>@p.TotalRevenue.ToString("C")</strong></td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudText Typo="Typo.h6">Margem de Lucro por Produto</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                            @_productPerformance.ProfitMargins.Count produto(s)
                        </MudChip>
                    </MudStack>
                    @if (_productPerformance.ProfitMargins.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Sem dados.</MudAlert>
                    }
                    else
                    {
                        <MudSimpleTable Hover="true" Dense="true" Bordered="false">
                            <thead>
                                <tr>
                                    <th>Produto</th>
                                    <th style="text-align:right">Custo</th>
                                    <th style="text-align:right">Venda</th>
                                    <th style="text-align:right">Margem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in _productPerformance.ProfitMargins.Take(5))
                                {
                                    <tr>
                                        <td>
                                            <MudLink Href="@($"/basic/product?edit={p.ProductId}")" Underline="Underline.Hover">
                                                @p.ProductName
                                            </MudLink>
                                        </td>
                                        <td style="text-align:right">@p.CostPrice.ToString("C")</td>
                                        <td style="text-align:right">@p.SalesPrice.ToString("C")</td>
                                        <td style="text-align:right">
                                            <MudChip T="string"
                                                     Size="Size.Small"
                                                     Color="@MarginColor(p.MarginClassification)"
                                                     Variant="Variant.Filled">
                                                @p.ProfitMargin.ToString("N1")%
                                            </MudChip>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </MudPaper>
            </MudItem>

            @if (_inventoryDashboard.LowStockItems.Count > 0)
            {
                <MudItem xs="12">
                    <MudPaper Elevation="2" Class="pa-4">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" />
                                <MudText Typo="Typo.h6">Alerta de Estoque Baixo</MudText>
                            </MudStack>
                            <MudLink Href="/basic/inventory" Underline="Underline.Hover">
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small">
                                    Ver inventário
                                </MudButton>
                            </MudLink>
                        </MudStack>
                        <MudSimpleTable Hover="true" Dense="true" Bordered="false">
                            <thead>
                                <tr>
                                    <th>Produto</th>
                                    <th>Categoria</th>
                                    <th style="text-align:right">Qtd.</th>
                                    <th style="text-align:right">Custo</th>
                                    <th style="text-align:right">Venda</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _inventoryDashboard.LowStockItems.Take(5))
                                {
                                    <tr>
                                        <td>
                                            <MudLink Href="@($"/basic/product?edit={item.Id}")" Underline="Underline.Hover">
                                                @item.Name
                                            </MudLink>
                                        </td>
                                        <td>
                                            <MudLink Href="@($"/basic/productcategory?edit={item.CategoryId}")" Underline="Underline.Hover">
                                                @item.CategoryName
                                            </MudLink>
                                        </td>
                                        <td style="text-align:right">
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">@item.Quantity</MudChip>
                                        </td>
                                        <td style="text-align:right">@((item.CostPrice ?? 0).ToString("C"))</td>
                                        <td style="text-align:right">@item.SalesPrice.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
</MainLayout>

<style>
    .kpi-card {
        height: 100%;
        border-left: 4px solid transparent;
    }

    .kpi-success {
        border-left-color: var(--mud-palette-success);
    }

    .kpi-error {
        border-left-color: var(--mud-palette-error);
    }

    .kpi-info {
        border-left-color: var(--mud-palette-info);
    }

    .period-card {
        background-color: rgba(94, 53, 177, 0.04);
        border-radius: 8px;
        padding: 12px;
        height: 100%;
        border: 1px solid rgba(94, 53, 177, 0.1);
    }

    .chart-wrap {
        width: 100%;
        overflow: hidden;
    }

    .chart-wrap .mud-chart {
        width: 100% !important;
        max-width: 100%;
    }

    .chart-wrap .mud-chart svg {
        max-width: 100%;
        height: auto;
    }
</style>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true,
        Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() }
    };

    private bool isLoading = true;
    private string? errorMessage;

    private int _days = 90;

    private FinancialDashboardData _financial = new();
    private OrderAnalyticsData _orderAnalytics = new();
    private InventoryDashboardData _inventoryDashboard = new();
    private ProductPerformanceData _productPerformance = new();

    private LineChartOptions _lineOptions = new()
    {
        ChartPalette = new[] { "#5e35b1", "#e57373", "#81c784" }
    };

    private DonutChartOptions _donutOptions = new()
    {
        ShowValues = false,
        ShowLegend = true
    };

    private string[] _revenueChartLabels = [];
    private List<ChartSeries<double>> _revenueChartSeries = [];

    private string[] _statusLabels = [];
    private List<ChartSeries<double>> _statusSeries = [];

    private Color ProfitColor => _financial.Kpi.GrossProfit >= 0 ? Color.Success : Color.Error;

    private Color GrowthColor
    {
        get
        {
            var g = _financial.DailySales.GrowthPercentage;
            if (g > 0.01m) return Color.Success;
            if (g < -0.01m) return Color.Error;
            return Color.Default;
        }
    }

    private string GrowthIcon
    {
        get
        {
            var g = _financial.DailySales.GrowthPercentage;
            if (g > 0.01m) return Icons.Material.Filled.TrendingUp;
            if (g < -0.01m) return Icons.Material.Filled.TrendingDown;
            return Icons.Material.Filled.TrendingFlat;
        }
    }

    private string GrowthLabel
    {
        get
        {
            var g = _financial.DailySales.GrowthPercentage;
            var sign = g > 0 ? "+" : string.Empty;
            return $"{sign}{g:N1}% vs mês anterior";
        }
    }

    private static Color MarginColor(string classification) => classification switch
    {
        "Excellent" => Color.Success,
        "Good" => Color.Info,
        "Average" => Color.Default,
        "Low" => Color.Warning,
        _ => Color.Error
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var isAuthenticated = await AuthState.IsAuthenticatedAsync();
        if (!isAuthenticated)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        await LoadAllAsync();
    }

    private async Task LoadAllAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            var client = await BuildClientAsync();

            var financialTask = client.GetAsync($"dashboard/financial?days={_days}");
            var orderAnalyticsTask = client.GetAsync($"order/analytics?days={_days}&topCustomersLimit=10");
            var inventoryTask = client.GetAsync($"inventory/dashboard");
            var productPerformanceTask = client.GetAsync($"product/performance?days={_days}&topLimit=10");

            await Task.WhenAll(financialTask, orderAnalyticsTask, inventoryTask, productPerformanceTask);

            _financial = await ParseAsync<FinancialDashboardData>(financialTask.Result, "painel financeiro")
                         ?? new FinancialDashboardData();
            _orderAnalytics = await ParseAsync<OrderAnalyticsData>(orderAnalyticsTask.Result, "analytics de pedidos")
                              ?? new OrderAnalyticsData();
            _inventoryDashboard = await ParseAsync<InventoryDashboardData>(inventoryTask.Result, "inventário")
                                  ?? new InventoryDashboardData();
            _productPerformance = await ParseAsync<ProductPerformanceData>(productPerformanceTask.Result, "performance de produtos")
                                  ?? new ProductPerformanceData();

            BuildRevenueChart();
            BuildStatusChart();
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro: {ex.Message}";
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void BuildRevenueChart()
    {
        var data = _financial.RevenueVsCost.OrderBy(r => r.Date).ToList();
        _revenueChartLabels = data.Select(r => r.Date.ToString("dd/MM")).ToArray();
        _revenueChartSeries = new List<ChartSeries<double>>
        {
            new() { Name = "Receita", Data = data.Select(r => (double)r.Revenue).ToArray() },
            new() { Name = "Custo",   Data = data.Select(r => (double)r.Cost).ToArray() },
            new() { Name = "Lucro",   Data = data.Select(r => (double)r.Profit).ToArray() }
        };
    }

    private void BuildStatusChart()
    {
        var data = _orderAnalytics.OrdersByStatus;
        _statusLabels = data.Select(s => $"{s.Status} ({s.Count})").ToArray();
        _statusSeries = new List<ChartSeries<double>>
        {
            new() { Name = "Pedidos", Data = data.Select(s => (double)s.Count).ToArray() }
        };
    }

    private async Task<T?> ParseAsync<T>(HttpResponseMessage response, string label) where T : class
    {
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add($"Falha ao carregar {label}: {(int)response.StatusCode}", Severity.Warning);
            return null;
        }

        try
        {
            var body = await response.Content.ReadAsStringAsync();
            return JsonSerializer.Deserialize<T>(body, JsonOptions);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao interpretar {label}: {ex.Message}", Severity.Error);
            return null;
        }
    }

    private async Task<HttpClient> BuildClientAsync()
    {
        var client = HttpClientFactory.CreateClient("FeniciaBasic");

        var token = await CompanyContext.GetTokenAsync();
        if (!string.IsNullOrEmpty(token))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }

        var companyId = await CompanyContext.GetSelectedCompanyIdAsync();
        if (companyId.HasValue)
        {
            client.DefaultRequestHeaders.Remove("CompanyId");
            client.DefaultRequestHeaders.Add("CompanyId", companyId.Value.ToString());
        }

        return client;
    }

