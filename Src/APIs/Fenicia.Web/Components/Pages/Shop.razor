@page "/shop"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext
@inject IAuthStateService AuthState
@inject NotificationService NotificationService

<PageTitle>Loja - Fenicia</PageTitle>

<MainLayout>
    <MudGrid>
        <MudItem xs="12">
            @if (!isLoggedIn)
            {
                <MudAlert Severity="Severity.Error">Faça login para assinar módulos.</MudAlert>
            }
            else if (isLoading)
            {
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="ma-16" Size="Size.Large" />
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
            }
            else if (modules == null || modules.Count == 0)
            {
                <MudAlert Severity="Severity.Warning">Nenhum módulo disponível no momento.</MudAlert>
            }
            else
            {
                <MudPaper Elevation="2" Class="pa-6">
                    <MudText Typo="Typo.h5" Class="mb-2">Módulos Disponíveis</MudText>
                    <MudText Typo="Typo.body1" Color="Color.Default" Class="mb-6">Selecione um ou mais módulos para assinar.</MudText>

                    <MudGrid Spacing="4">
                        @foreach (var module in modules)
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudCard Elevation="2" Class="h-100">
                                    <MudCardContent>
                                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                                            <MudStack Spacing="1">
                                                <MudText Typo="Typo.h6">@module.Name</MudText>
                                                @if (!string.IsNullOrEmpty(module.Description))
                                                {
                                                    <MudText Typo="Typo.body2" Color="Color.Default">@module.Description</MudText>
                                                }
                                            </MudStack>
                                            <MudCheckBox T="bool" Checked="@selectedModules.Contains(module.Id)" CheckedChanged="@((bool checkedVal) => ToggleModule(module.Id))" Color="Color.Primary" />
                                        </MudStack>
                                        <MudStack Row="true" Spacing="1" Class="mt-4">
                                            <MudBadge Color="Color.Info" Class="pa-2">Tipo: @module.Type</MudBadge>
                                            @if (module.Price.HasValue)
                                            {
                                                <MudBadge Color="Color.Success" Class="pa-2">Preço: $@module.Price.Value.ToString("F2")</MudBadge>
                                            }
                                        </MudStack>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>

                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-6">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubscribeAsync" Disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Default" Class="mr-2" />
                                <span>Assinando...</span>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Class="mr-2" />
                                <span>Assinar (@selectedModules.Count selecionados)</span>
                            }
                        </MudButton>
                    </MudStack>
                </MudPaper>

                @if (!string.IsNullOrEmpty(resultMessage))
                {
                    <MudAlert Severity="@(isSuccess ? Severity.Success : Severity.Error)" Class="mt-4" Dense="true">@resultMessage</MudAlert>
                }
            }
        </MudItem>
    </MudGrid>
</MainLayout>

@code {
    private bool isLoggedIn = false;
    private bool isLoading = true;
    private bool isSubmitting;
    private string? errorMessage;
    private string? resultMessage;
    private bool isSuccess;
    private List<ModuleDto>? modules;
    private HashSet<Guid> selectedModules = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                isLoggedIn = await AuthState.IsAuthenticatedAsync();
            }
            catch
            {
                isLoggedIn = false;
            }

            await InvokeAsync(StateHasChanged);

            if (isLoggedIn)
            {
                await LoadModulesAsync();
            }
            else
            {
                isLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task LoadModulesAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            var client = HttpClientFactory.CreateClient("FeniciaAuth");
            var token = await CompanyContext.GetTokenAsync();
            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var selectedCompanyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (selectedCompanyId.HasValue)
            {
                client.DefaultRequestHeaders.Remove("CompanyId");
                client.DefaultRequestHeaders.Add("CompanyId", selectedCompanyId.Value.ToString());
            }

            var response = await client.GetAsync("/module?page=1&perPage=100");

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                options.Converters.Add(new System.Text.Json.Serialization.JsonStringEnumConverter());
                var paginated = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(json, options);

                if (paginated.TryGetProperty("data", out var dataElement) && dataElement.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    modules = System.Text.Json.JsonSerializer.Deserialize<List<ModuleDto>>(dataElement.GetRawText(), options);
                }
                else if (paginated.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    modules = System.Text.Json.JsonSerializer.Deserialize<List<ModuleDto>>(json, options);
                }
            }
            else
            {
                errorMessage = $"Falha ao carregar módulos: {(int)response.StatusCode} {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ToggleModule(Guid moduleId)
    {
        if (selectedModules.Contains(moduleId))
        {
            selectedModules.Remove(moduleId);
        }
        else
        {
            selectedModules.Add(moduleId);
        }
        StateHasChanged();
    }

    private async Task SubscribeAsync()
    {
        if (selectedModules.Count == 0)
        {
            resultMessage = "Selecione pelo menos um módulo.";
            isSuccess = false;
            NotificationService.Show("Selecione pelo menos um módulo.", Severity.Warning);
            return;
        }

        try
        {
            isSubmitting = true;
            resultMessage = null;
            StateHasChanged();

            var userId = await CompanyContext.GetUserIdAsync();
            var companyId = await CompanyContext.GetSelectedCompanyIdAsync();

            if (!companyId.HasValue)
            {
                resultMessage = "Selecione uma empresa antes de assinar.";
                isSuccess = false;
                NotificationService.Show("Selecione uma empresa antes de assinar.", Severity.Warning);
                return;
            }

            var token = await CompanyContext.GetTokenAsync();
            var client = HttpClientFactory.CreateClient("FeniciaAuth");

            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            client.DefaultRequestHeaders.Remove("CompanyId");
            client.DefaultRequestHeaders.Add("CompanyId", companyId.Value.ToString());

            var command = new
            {
                UserId = userId,
                CompanyId = companyId.Value,
                Modules = selectedModules.ToList()
            };

            var response = await client.PostAsJsonAsync("/order", command);

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                resultMessage = $"Falha ao assinar: {(int)response.StatusCode} {response.StatusCode} - {body}";
                isSuccess = false;
                NotificationService.Show("Falha ao assinar módulos.", Severity.Error);
            }
            else
            {
                resultMessage = "Assinatura criada com sucesso! Redirecionando para o perfil...";
                isSuccess = true;
                NotificationService.Show("Assinatura criada com sucesso!", Severity.Success);
                StateHasChanged();
                await Task.Delay(1500);
                NavigationManager.NavigateTo("/profile");
            }
        }
        catch (Exception ex)
        {
            resultMessage = $"Erro: {ex.Message}";
            isSuccess = false;
            NotificationService.Show($"Erro: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private class ModuleDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public string? Description { get; set; }
        public decimal? Price { get; set; }
        public bool IsActive { get; set; }
        public int SortOrder { get; set; }
    }
}
