@page "/shop"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext
@inject IAuthStateService AuthState
@inject NotificationService NotificationService

<PageTitle>Loja - Fenicia</PageTitle>

<MainLayout>
    <section class="section">
        <div class="container">
            @if (!isLoggedIn)
            {
                <div class="notification is-danger">
                    <p>Faça login para assinar módulos.</p>
                </div>
            }
            else if (isLoading)
            {
                <div class="notification is-info is-light">
                    <div class="level is-mobile">
                        <div class="level-left">
                            <div class="level-item">
                                <Spinner Size="SpinnerSize.Small" Label="Carregando módulos..." />
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="notification is-danger">
                    <p>@errorMessage</p>
                </div>
            }
            else if (modules == null || modules.Count == 0)
            {
                <div class="notification is-warning is-light">
                    <p>Nenhum módulo disponível no momento.</p>
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-content">
                        <h2 class="title is-4">Módulos Disponíveis</h2>
                        <p class="subtitle is-6">Selecione um ou mais módulos para assinar.</p>

                        <div class="columns is-multiline">
                            @foreach (var module in modules)
                            {
                                <div class="column is-4">
                                    <div class="box module-card">
                                        <div class="level">
                                            <div class="level-left">
                                                <div>
                                                    <p class="title is-5">@module.Name</p>
                                                    @if (!string.IsNullOrEmpty(module.Description))
                                                    {
                                                        <p class="subtitle is-7">@module.Description</p>
                                                    }
                                                </div>
                                            </div>
                                            <div class="level-right">
                                                <label class="checkbox">
                                                    <input type="checkbox" checked="@selectedModules.Contains(module.Id)" @onchange="() => ToggleModule(module.Id)" />
                                                </label>
                                            </div>
                                        </div>
                                        <div class="tags">
                                            <span class="tag is-info is-light">Type: @module.Type</span>
                                            @if (module.Price.HasValue)
                                            {
                                                <span class="tag is-success is-light">Price: $@module.Price.Value.ToString("F2")</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="field is-grouped is-justify-content-flex-end mt-5">
                            <div class="control">
                                <button class="button is-link" @onclick="SubscribeAsync" disabled="@isSubmitting">
                                    @if (isSubmitting)
                                    {
                                        <span class="icon is-small">
                                            <i class="fas fa-spinner fa-spin"></i>
                                        </span>
                                        <span>Assinando...</span>
                                    }
                                    else
                                    {
                                        <span class="icon is-small">
                                            <i class="fas fa-shopping-cart"></i>
                                        </span>
                                        <span>Assinar (@selectedModules.Count selecionados)</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(resultMessage))
                {
                    <Notification Color="@(isSuccess ? NotificationColor.Success : NotificationColor.Danger)" HideCloseButton="true">
                        @resultMessage
                    </Notification>
                }
            }
        </div>
    </section>
</MainLayout>

<style>
    .module-card {
        height: 100%;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .module-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.5em 1em -0.125em rgba(10, 10, 10, 0.1), 0 0px 0 1px rgba(10, 10, 10, 0.02);
    }
</style>

@code {
    private bool isLoggedIn = false;
    private bool isLoading = true;
    private bool isSubmitting;
    private string? errorMessage;
    private string? resultMessage;
    private bool isSuccess;
    private List<ModuleDto>? modules;
    private HashSet<Guid> selectedModules = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                isLoggedIn = await AuthState.IsAuthenticatedAsync();
            }
            catch
            {
                isLoggedIn = false;
            }

            await InvokeAsync(StateHasChanged);

            if (isLoggedIn)
            {
                await LoadModulesAsync();
            }
            else
            {
                isLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task LoadModulesAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            var client = HttpClientFactory.CreateClient("FeniciaAuth");
            var token = await CompanyContext.GetTokenAsync();
            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var selectedCompanyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (selectedCompanyId.HasValue)
            {
                client.DefaultRequestHeaders.Remove("CompanyId");
                client.DefaultRequestHeaders.Add("CompanyId", selectedCompanyId.Value.ToString());
            }

            var response = await client.GetAsync("/module?page=1&perPage=100");

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                options.Converters.Add(new System.Text.Json.Serialization.JsonStringEnumConverter());
                var paginated = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(json, options);

                if (paginated.TryGetProperty("data", out var dataElement) && dataElement.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    modules = System.Text.Json.JsonSerializer.Deserialize<List<ModuleDto>>(dataElement.GetRawText(), options);
                }
                else if (paginated.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    modules = System.Text.Json.JsonSerializer.Deserialize<List<ModuleDto>>(json, options);
                }
            }
            else
            {
                errorMessage = $"Falha ao carregar módulos: {(int)response.StatusCode} {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ToggleModule(Guid moduleId)
    {
        if (selectedModules.Contains(moduleId))
        {
            selectedModules.Remove(moduleId);
        }
        else
        {
            selectedModules.Add(moduleId);
        }
        StateHasChanged();
    }

    private async Task SubscribeAsync()
    {
        if (selectedModules.Count == 0)
        {
            resultMessage = "Selecione pelo menos um módulo.";
            isSuccess = false;
            NotificationService.Show("Selecione pelo menos um módulo.", NotificationColor.Warning);
            return;
        }

        try
        {
            isSubmitting = true;
            resultMessage = null;
            StateHasChanged();

            var userId = await CompanyContext.GetUserIdAsync();
            var companyId = await CompanyContext.GetSelectedCompanyIdAsync();

            if (!companyId.HasValue)
            {
                resultMessage = "Selecione uma empresa antes de assinar.";
                isSuccess = false;
                NotificationService.Show("Selecione uma empresa antes de assinar.", NotificationColor.Warning);
                return;
            }

            var token = await CompanyContext.GetTokenAsync();
            var client = HttpClientFactory.CreateClient("FeniciaAuth");

            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            client.DefaultRequestHeaders.Remove("CompanyId");
            client.DefaultRequestHeaders.Add("CompanyId", companyId.Value.ToString());

            var command = new
            {
                UserId = userId,
                CompanyId = companyId.Value,
                Modules = selectedModules.ToList()
            };

            var response = await client.PostAsJsonAsync("/order", command);

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                resultMessage = $"Falha ao assinar: {(int)response.StatusCode} {response.StatusCode} - {body}";
                isSuccess = false;
                NotificationService.Show("Falha ao assinar módulos.", NotificationColor.Danger);
            }
            else
            {
                resultMessage = "Assinatura criada com sucesso! Redirecionando para o perfil...";
                isSuccess = true;
                NotificationService.Show("Assinatura criada com sucesso!", NotificationColor.Success);
                StateHasChanged();
                await Task.Delay(1500);
                NavigationManager.NavigateTo("/profile");
            }
        }
        catch (Exception ex)
        {
            resultMessage = $"Erro: {ex.Message}";
            isSuccess = false;
            NotificationService.Show($"Erro: {ex.Message}", NotificationColor.Danger);
        }
        finally
        {
            isSubmitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private class ModuleDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public string? Description { get; set; }
        public decimal? Price { get; set; }
        public bool IsActive { get; set; }
        public int SortOrder { get; set; }
    }
}
