@using Fenicia.Web.Components.Pages.Basic.Models
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext

<MudGrid Spacing="2">
    <MudItem xs="12" sm="8">
        <MudTextField @bind-Value="Model.Name" Label="Nome" Variant="Variant.Outlined" Required="true" RequiredError="Nome é obrigatório!" />
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudTextField @bind-Value="Model.Document" Label="Documento (CPF/CNPJ)" Variant="Variant.Outlined" />
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudTextField @bind-Value="Model.Email" Label="Email" Variant="Variant.Outlined" InputType="InputType.Email" />
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudTextField @bind-Value="Model.PhoneNumber" Label="Telefone" Variant="Variant.Outlined" />
    </MudItem>

    <MudItem xs="12">
        <MudText Typo="Typo.subtitle2" Class="mt-2">Endereço</MudText>
    </MudItem>
    <MudItem xs="12" sm="8">
        <MudTextField @bind-Value="Model.Street" Label="Rua" Variant="Variant.Outlined" />
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudTextField @bind-Value="Model.Number" Label="Número" Variant="Variant.Outlined" />
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudTextField @bind-Value="Model.Complement" Label="Complemento" Variant="Variant.Outlined" />
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudTextField @bind-Value="Model.Neighborhood" Label="Bairro" Variant="Variant.Outlined" />
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudTextField @bind-Value="Model.ZipCode" Label="CEP" Variant="Variant.Outlined" />
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudTextField @bind-Value="Model.City" Label="Cidade" Variant="Variant.Outlined" />
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudSelect T="Guid?" @bind-Value="Model.StateId" Label="Estado" Variant="Variant.Outlined" Clearable="true">
            @foreach (var state in States)
            {
                <MudSelectItem T="Guid?" Value="@state.Id">@state.Uf — @state.Name</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12">
        <MudTextField @bind-Value="Model.Country" Label="País" Variant="Variant.Outlined" />
    </MudItem>
</MudGrid>

@code {
    [Parameter] public SupplierFormModel Model { get; set; } = new();
    [Parameter, EditorRequired] public List<StateOption> States { get; set; } = [];
}
