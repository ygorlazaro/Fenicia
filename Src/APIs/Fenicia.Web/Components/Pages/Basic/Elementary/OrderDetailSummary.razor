@using Fenicia.Common.Enums.Basic

<MudPaper Elevation="2" Class="pa-4 invoice-section">
    <MudText Typo="Typo.h6" Class="mb-3">Resumo</MudText>

    <MudStack Spacing="2">
        <div class="invoice-row">
            <MudText>Cliente:</MudText>
            <MudLink Href="@($"/basic/customer?edit={Order.CustomerId}")" Underline="Underline.Hover">
                <strong>@Order.CustomerName</strong>
            </MudLink>
        </div>
        <div class="invoice-row">
            <MudText>Pagamento:</MudText>
            <MudText>@PaymentLabel(Order.PaymentMethod)</MudText>
        </div>
        @if (Order.EmployeeId.HasValue)
        {
            <div class="invoice-row">
                <MudText>Vendedor:</MudText>
                <MudLink Href="@($"/basic/employee?edit={Order.EmployeeId}")" Underline="Underline.Hover">
                    @Order.EmployeeName
                </MudLink>
            </div>
        }
        <MudDivider Class="my-2" />
        <div class="invoice-row">
            <MudText>Itens:</MudText>
            <MudText>@Order.TotalQuantity.ToString("0.##")</MudText>
        </div>
        <div class="invoice-row">
            <MudText>Subtotal:</MudText>
            <MudText>@(Money.Format(Order.TotalAmount + Order.DiscountAmount))</MudText>
        </div>
        @if (Order.DiscountAmount > 0)
        {
            <div class="invoice-row">
                <MudText>Desconto:</MudText>
                <MudText Color="Color.Warning">- @Money.Format(Order.DiscountAmount)</MudText>
            </div>
        }
        <MudDivider Class="my-2" />
        <div class="invoice-row">
            <MudText Typo="Typo.h6">Total:</MudText>
            <MudText Typo="Typo.h6" Color="Color.Primary">@Money.Format(Order.TotalAmount)</MudText>
        </div>
    </MudStack>

    @if (!string.IsNullOrEmpty(Order.Notes))
    {
        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle2">Observações</MudText>
        <MudText Typo="Typo.body2" Color="Color.Default">@Order.Notes</MudText>
    }
</MudPaper>

@code {
    [Parameter][EditorRequired] public GetOrderByIdResponse Order { get; set; } = default!;

    private static string PaymentLabel(PaymentMethod method)
    {
        return method switch
        {
            PaymentMethod.Cash => "Dinheiro",
            PaymentMethod.CreditCard => "Cartão de Crédito",
            PaymentMethod.DebitCard => "Cartão de Débito",
            PaymentMethod.Pix => "PIX",
            PaymentMethod.Boleto => "Boleto",
            PaymentMethod.BankTransfer => "Transferência",
            _ => method.ToString()
        };
    }

}
