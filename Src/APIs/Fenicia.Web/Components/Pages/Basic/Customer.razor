@page "/basic/customer"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext
@using Fenicia.Web.Components.Shared
@using Fenicia.Web.Components.Pages.Basic.Models
@using Fenicia.Web.Components.Pages.Basic.Elementary
@using System.Text.Json

<CrudPage @ref="_crudPage" TItem="CustomerDto"
          PageTitle="Clientes"
          PageSubtitle="Gerencie os clientes da sua empresa"
          EntityNamePlural="clientes"
          EntityNameSingular="Cliente"
          Endpoint="customer"
          ColumnCount="7"
          AddButtonLabel="Adicionar Cliente"
          AddDialogTitle="Adicionar Cliente"
          EditDialogTitle="Editar Cliente"
          CreateButtonLabel="Criar"
          UpdateButtonLabel="Atualizar"
          DeleteDialogTitle="Excluir Cliente"
          CreatePayloadFactory="CreatePayload"
          OnAdd="ResetForm"
          OnEdit="LoadForm">
    <HeaderContent>
        <CustomerHeader />
    </HeaderContent>
    <RowTemplate>
        <CustomerRow Item="context.Item"
                     OnEdit="@(() => context.Page.OpenEditModal(context.Item))"
                     OnDelete="@(() => context.Page.RequestDelete(context.Item))" />
    </RowTemplate>
    <AddModalBody>
        <CustomerForm Model="_add" States="_states" />
    </AddModalBody>
    <EditModalBody>
        <CustomerForm Model="_edit" States="_states" />
    </EditModalBody>
</CrudPage>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    private List<StateOption> _states = new();
    private CustomerFormModel _add = new();
    private CustomerFormModel _edit = new();

    private CrudPage<CustomerDto> _crudPage = default!;

    protected override Task OnInitializedAsync()
    {
        return LoadStatesAsync();
    }

    private async Task LoadStatesAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("FeniciaBasic");

            var token = await CompanyContext.GetTokenAsync();
            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var companyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (companyId.HasValue)
            {
                client.DefaultRequestHeaders.Remove("CompanyId");
                client.DefaultRequestHeaders.Add("CompanyId", companyId.Value.ToString());
            }

            var response = await client.GetAsync("state");
            if (response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                var items = JsonSerializer.Deserialize<List<StateOption>>(body, JsonOptions);
                _states = items ?? new();
            }
        }
        catch
        {
            _states = new();
        }
    }

    private void ResetForm() => _add = new CustomerFormModel();

    private void LoadForm(CustomerDto item)
    {
        _edit = item is null
            ? new CustomerFormModel()
            : new CustomerFormModel
            {
                Name = item.Name,
                Email = item.Email,
                PhoneNumber = item.PhoneNumber,
                Document = item.Document,
                Street = item.Address?.Street,
                Number = item.Address?.Number,
                Complement = item.Address?.Complement,
                Neighborhood = item.Address?.Neighborhood,
                ZipCode = item.Address?.ZipCode,
                City = item.Address?.City,
                StateId = item.Address is { StateId: var sid } && sid != Guid.Empty ? sid : (Guid?)null,
                Country = item.Address?.Country
            };
    }

    private object CreatePayload(CrudModalContext<CustomerDto> ctx)
    {
        var model = ctx.IsAdd ? _add : _edit;
        return new
        {
            Id = ctx.IsAdd ? Guid.NewGuid() : ctx.Id,
            Name = model.Name ?? string.Empty,
            Email = model.Email,
            Document = model.Document,
            PhoneNumber = model.PhoneNumber,
            Address = BuildAddress(model)
        };
    }

    private static object? BuildAddress(CustomerFormModel model)
    {
        if (string.IsNullOrWhiteSpace(model.Street)
            || string.IsNullOrWhiteSpace(model.Number)
            || string.IsNullOrWhiteSpace(model.ZipCode)
            || string.IsNullOrWhiteSpace(model.City)
            || model.StateId is null)
        {
            return null;
        }

        return new
        {
            Street = model.Street,
            Number = model.Number,
            Complement = model.Complement,
            Neighborhood = model.Neighborhood,
            ZipCode = model.ZipCode,
            City = model.City,
            StateId = model.StateId.Value,
            Country = model.Country
        };
    }
}
