@page "/basic/inventory"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext
@inject ISnackbar Snackbar
@using Fenicia.Web.Components.Shared
@using Fenicia.Web.Components.Pages.Basic.Models
@using Fenicia.Web.Components.Pages.Basic.Elementary
@using System.Text.Json

<MainLayout>
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2">
        <InventoryHeader ZeroMovementDays="_zeroMovementDays"
                         ZeroMovementDaysChanged="OnZeroMovementDaysChanged"
                         Loading="_loading"
                         OnRefresh="LoadAsync" />

        @if (_loading)
        {
            <MudStack AlignItems="AlignItems.Center" Class="my-8">
                <MudProgressCircular Indeterminate="true" />
                <MudText Typo="Typo.body2">Carregando dados do inventário...</MudText>
            </MudStack>
        }
        else if (_dashboard is null)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                Não foi possível carregar os dados do inventário. Verifique a conexão e tente novamente.
            </MudAlert>
        }
        else
        {
            <InventoryKpiCards Dashboard="_dashboard" ProfitColor="ProfitColor" />

            <InventoryCharts Series="_categoryChartSeries"
                             Labels="_categoryChartLabels"
                             Options="_categoryChartOptions" />

            <InventoryLowStockTable Items="_dashboard.LowStockItems" />

            <InventoryHealth Health="_health"
                             ZeroMovementDays="_zeroMovementDays"
                             StockSeries="_stockValueByCategorySeries"
                             StockLabels="_stockValueByCategoryLabels"
                             StockOptions="_stockValueByCategoryOptions" />
        }
    </MudContainer>
</MainLayout>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    private int _zeroMovementDays = 90;
    private bool _loading = true;

    private DashboardData? _dashboard;
    private HealthData? _health;

    private List<ChartSeries<double>> _categoryChartSeries = [];
    private string[] _categoryChartLabels = [];
    private List<ChartSeries<double>> _supplierChartSeries = [];
    private string[] _supplierChartLabels = [];
    private List<ChartSeries<double>> _stockValueByCategorySeries = [];
    private string[] _stockValueByCategoryLabels = [];

    private readonly BarChartOptions _categoryChartOptions = new()
    {
        ShowLegend = false,
        ChartPalette = [Colors.Blue.Accent3]
    };

    private readonly BarChartOptions _supplierChartOptions = new()
    {
        ShowLegend = false,
        ChartPalette = [Colors.Green.Accent3]
    };

    private readonly BarChartOptions _stockValueByCategoryOptions = new()
    {
        ShowLegend = false,
        ChartPalette = [Colors.DeepOrange.Accent3]
    };

    private Color ProfitColor => _dashboard is null || _dashboard.ProfitPotential >= 0 ? Color.Success : Color.Error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var client = await BuildClientAsync();

            var dashboardTask = client.GetAsync("inventory/dashboard");
            var healthTask = client.GetAsync($"inventory/health?zeroMovementDays={_zeroMovementDays}");

            await Task.WhenAll(dashboardTask, healthTask);

            var dashboardResponse = await dashboardTask;
            if (dashboardResponse.IsSuccessStatusCode)
            {
                var body = await dashboardResponse.Content.ReadAsStringAsync();
                try
                {
                    _dashboard = JsonSerializer.Deserialize<DashboardData>(body, JsonOptions);
                    _categoryChartSeries =
                    [
                        new ChartSeries<double>
                        {
                            Name = "Quantidade em Estoque",
                            Data = BuildTop9WithOthers(_dashboard?.CategoryBreakdown, c => c.TotalQuantity).ToArray()
                        }
                    ];
                    _categoryChartLabels = [.. BuildTop9Labels(_dashboard?.CategoryBreakdown, c => c.CategoryName, "Outros")];
                    _supplierChartSeries =
                    [
                        new ChartSeries<double>
                        {
                            Name = "Quantidade em Estoque",
                            Data = BuildTop9WithOthers(_dashboard?.SupplierBreakdown, s => s.TotalQuantity).ToArray()
                        }
                    ];
                    _supplierChartLabels = [.. BuildTop9Labels(_dashboard?.SupplierBreakdown, s => s.SupplierName, "Outros")];
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Erro ao interpretar painel: {ex.Message}", Severity.Error);
                    _dashboard = null;
                }
            }
            else
            {
                _dashboard = null;
                Snackbar.Add($"Falha ao carregar painel: {(int)dashboardResponse.StatusCode}", Severity.Error);
            }

            var healthResponse = await healthTask;
            if (healthResponse.IsSuccessStatusCode)
            {
                var body = await healthResponse.Content.ReadAsStringAsync();
                try
                {
                    _health = JsonSerializer.Deserialize<HealthData>(body, JsonOptions);
                    _stockValueByCategorySeries =
                    [
                        new ChartSeries<double>
                        {
                            Name = "Valor em Estoque",
                                     Data = BuildTop9WithOthers(_health?.StockValueByCategory, c => (double)c.TotalStockValue).ToArray()
                        }
                    ];
                    _stockValueByCategoryLabels = [.. BuildTop9Labels(_health?.StockValueByCategory, c => c.CategoryName, "Outros")];
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Erro ao interpretar saúde: {ex.Message}", Severity.Error);
                    _health = null;
                }
            }
            else
            {
                _health = null;
                Snackbar.Add($"Falha ao carregar saúde do inventário: {(int)healthResponse.StatusCode}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar inventário: {ex.Message}", Severity.Error);
            _dashboard = null;
            _health = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<HttpClient> BuildClientAsync()
    {
        var client = HttpClientFactory.CreateClient("FeniciaBasic");

        var token = await CompanyContext.GetTokenAsync();
        if (!string.IsNullOrEmpty(token))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }

        var companyId = await CompanyContext.GetSelectedCompanyIdAsync();
        if (companyId.HasValue)
        {
            client.DefaultRequestHeaders.Remove("CompanyId");
            client.DefaultRequestHeaders.Add("CompanyId", companyId.Value.ToString());
        }

        return client;
    }

    private void OnZeroMovementDaysChanged(int value)
    {
        _zeroMovementDays = value;
    }

    private static List<double> BuildTop9WithOthers<T>(List<T>? items, Func<T, double> selector)
    {
        if (items is null || items.Count == 0)
        {
            return [];
        }

        var ordered = items.OrderByDescending(selector).ToList();
        var top = ordered.Take(9).Select(selector).ToList();
        if (ordered.Count > 9)
        {
            top.Add(ordered.Skip(9).Sum(selector));
        }
        return top;
    }

    private static List<string> BuildTop9Labels<T>(List<T>? items, Func<T, string> labelSelector, string otherLabel)
    {
        if (items is null || items.Count == 0)
        {
            return [];
        }

        var top = items.Take(9).Select(labelSelector).ToList();
        if (items.Count > 9)
        {
            top.Add(otherLabel);
        }
        return top;
    }
}
