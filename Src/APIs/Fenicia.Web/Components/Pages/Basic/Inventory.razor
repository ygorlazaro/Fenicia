@page "/basic/inventory"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext
@inject ISnackbar Snackbar
@using Fenicia.Web.Components.Pages.Basic.Elementary
@using System.Text.Json

<MainLayout>
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2">
        <InventoryHeader ZeroMovementDays="zeroMovementDays"
                         ZeroMovementDaysChanged="OnZeroMovementDaysChanged"
                         Loading="loading"
                         OnRefresh="LoadAsync" />

        @if (loading)
        {
            <MudStack AlignItems="AlignItems.Center" Class="my-8">
                <MudProgressCircular Indeterminate="true" />
                <MudText Typo="Typo.body2">Carregando dados do inventário...</MudText>
            </MudStack>
        }
        else if (dashboard is null)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                Não foi possível carregar os dados do inventário. Verifique a conexão e tente novamente.
            </MudAlert>
        }
        else
        {
            <InventoryKpiCards Dashboard="dashboard" ProfitColor="ProfitColor" />

            <InventoryCharts Series="categoryChartSeries"
                             Labels="categoryChartLabels"
                             Options="categoryChartOptions" />

            <InventoryLowStockTable Items="dashboard.LowStockItems" />

            <InventoryHealth Health="health"
                             ZeroMovementDays="zeroMovementDays"
                             StockSeries="stockValueByCategorySeries"
                             StockLabels="stockValueByCategoryLabels"
                             StockOptions="stockValueByCategoryOptions" />
        }
    </MudContainer>
</MainLayout>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    private int zeroMovementDays = 90;
    private bool loading = true;

    private DashboardData? dashboard;
    private HealthData? health;

    private List<ChartSeries<double>> categoryChartSeries = [];
    private string[] categoryChartLabels = [];
    private List<ChartSeries<double>> stockValueByCategorySeries = [];
    private string[] stockValueByCategoryLabels = [];

    private readonly BarChartOptions categoryChartOptions = new()
    {
        ShowLegend = false,
        ChartPalette = [Colors.Blue.Accent3]
    };

    private readonly BarChartOptions stockValueByCategoryOptions = new()
    {
        ShowLegend = false,
        ChartPalette = [Colors.DeepOrange.Accent3]
    };

    private Color ProfitColor => dashboard is null || dashboard.ProfitPotential >= 0 ? Color.Success : Color.Error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            var client = await BuildClientAsync();

            var dashboardTask = client.GetAsync("inventory/dashboard");
            var healthTask = client.GetAsync($"inventory/health?zeroMovementDays={zeroMovementDays}");

            await Task.WhenAll(dashboardTask, healthTask);

            var dashboardResponse = await dashboardTask;
            if (dashboardResponse.IsSuccessStatusCode)
            {
                var body = await dashboardResponse.Content.ReadAsStringAsync();
                try
                {
                    dashboard = JsonSerializer.Deserialize<DashboardData>(body, JsonOptions);
                    categoryChartSeries =
                    [
                        new ChartSeries<double>
                        {
                            Name = "Quantidade em Estoque",
                            Data = BuildTop9WithOthers(dashboard?.CategoryBreakdown, c => c.TotalQuantity).ToArray()
                        }
                    ];
                    categoryChartLabels = [.. BuildTop9Labels(dashboard?.CategoryBreakdown, c => c.CategoryName, "Outros")];
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Erro ao interpretar painel: {ex.Message}", Severity.Error);
                    dashboard = null;
                }
            }
            else
            {
                dashboard = null;
                Snackbar.Add($"Falha ao carregar painel: {(int)dashboardResponse.StatusCode}", Severity.Error);
            }

            var healthResponse = await healthTask;
            if (healthResponse.IsSuccessStatusCode)
            {
                var body = await healthResponse.Content.ReadAsStringAsync();
                try
                {
                    health = JsonSerializer.Deserialize<HealthData>(body, JsonOptions);
                    stockValueByCategorySeries =
                    [
                        new ChartSeries<double>
                        {
                            Name = "Valor em Estoque",
                                     Data = BuildTop9WithOthers(health?.StockValueByCategory, c => (double)c.TotalStockValue).ToArray()
                        }
                    ];
                    stockValueByCategoryLabels = [.. BuildTop9Labels(health?.StockValueByCategory, c => c.CategoryName, "Outros")];
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Erro ao interpretar saúde: {ex.Message}", Severity.Error);
                    health = null;
                }
            }
            else
            {
                health = null;
                Snackbar.Add($"Falha ao carregar saúde do inventário: {(int)healthResponse.StatusCode}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar inventário: {ex.Message}", Severity.Error);
            dashboard = null;
            health = null;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task<HttpClient> BuildClientAsync()
    {
        var client = HttpClientFactory.CreateClient("FeniciaBasic");

        var token = await CompanyContext.GetTokenAsync();
        if (!string.IsNullOrEmpty(token))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }

        var companyId = await CompanyContext.GetSelectedCompanyIdAsync();
        if (!companyId.HasValue)
        {
            return client;
        }

        client.DefaultRequestHeaders.Remove("CompanyId");
        client.DefaultRequestHeaders.Add("CompanyId", companyId.Value.ToString());

        return client;
    }

    private void OnZeroMovementDaysChanged(int value)
    {
        zeroMovementDays = value;
    }

    private static List<double> BuildTop9WithOthers<T>(List<T>? items, Func<T, double> selector)
    {
        if (items is null || items.Count == 0)
        {
            return [];
        }

        var ordered = items.OrderByDescending(selector).ToList();
        var top = ordered.Take(9).Select(selector).ToList();
        if (ordered.Count > 9)
        {
            top.Add(ordered.Skip(9).Sum(selector));
        }
        return top;
    }

    private static List<string> BuildTop9Labels<T>(List<T>? items, Func<T, string> labelSelector, string otherLabel)
    {
        if (items is null || items.Count == 0)
        {
            return [];
        }

        var top = items.Take(9).Select(labelSelector).ToList();
        if (items.Count > 9)
        {
            top.Add(otherLabel);
        }
        return top;
    }
}
