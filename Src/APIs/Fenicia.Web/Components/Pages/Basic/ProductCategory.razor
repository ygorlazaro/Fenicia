@page "/basic/productcategory"
@rendermode InteractiveServer
@using Fenicia.Web.Services
@using Fenicia.Web.Components.Shared

<CrudPage @ref="_crudPage" TItem="ProductCategoryDto"
          PageTitle="Categorias de Produtos"
          PageSubtitle="Gerencie suas categorias de produtos"
          EntityNamePlural="categorias de produtos"
          EntityNameSingular="Categoria"
          Endpoint="productcategory"
          ColumnCount="2"
          AddButtonLabel="Adicionar Categoria"
          AddTabText="Nova Categoria"
          EditTabText="Editar Categoria"
          AddDialogTitle="Adicionar Categoria"
          EditDialogTitle="Editar Categoria"
          CreateButtonLabel="Criar"
          UpdateButtonLabel="Atualizar"
          DeleteDialogTitle="Excluir Categoria"
           CreatePayloadFactory="CreatePayload"
            OnAdd="ResetAddName"
            OnEdit="LoadEditName">
    <HeaderContent>
        <MudTh Style="text-align: left; min-width: 120px; width: 120px">Ações</MudTh>
        <MudTh Sortable="true" SortLabel="Name">Nome</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Ações" Style="text-align: left; min-width: 120px; width: 120px">
            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                           Color="Color.Info"
                           Size="Size.Small"
                           OnClick="@(() => context.Page.OpenEditModal(context.Item))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           Color="Color.Error"
                           Size="Size.Small"
                           OnClick="@(() => context.Page.RequestDelete(context.Item))" />
        </MudTd>
        <MudTd DataLabel="Nome">@context.Item.Name</MudTd>
    </RowTemplate>
    <AddModalBody>
        <MudTextField @bind-Value="_addName" Label="Nome da Categoria" Variant="Variant.Outlined" Required="true" RequiredError="Nome da categoria é obrigatório!" />
    </AddModalBody>
    <EditModalBody>
        <MudTextField @bind-Value="_editName" Label="Nome da Categoria" Variant="Variant.Outlined" Required="true" RequiredError="Nome da categoria é obrigatório!" />
    </EditModalBody>
</CrudPage>

@code {
    private string _addName = string.Empty;
    private string _editName = string.Empty;

    private CrudPage<ProductCategoryDto> _crudPage = default!;

    private void ResetAddName() => _addName = string.Empty;

    private void LoadEditName(ProductCategoryDto item) => _editName = item?.Name ?? string.Empty;

    private object CreatePayload(CrudModalContext<ProductCategoryDto> ctx)
    {
        var name = ctx.IsAdd ? _addName : _editName;
        return new
        {
            Id = ctx.IsAdd ? Guid.NewGuid() : ctx.Id,
            Name = name
        };
    }

    public class ProductCategoryDto : IEquatable<ProductCategoryDto>, ICrudItem
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;

        public bool Equals(ProductCategoryDto? other)
        {
            if (other is null) return false;
            return Id == other.Id && Name == other.Name;
        }

        public override bool Equals(object? obj) => Equals(obj as ProductCategoryDto);

        public override int GetHashCode() => HashCode.Combine(Id, Name);
    }
}
