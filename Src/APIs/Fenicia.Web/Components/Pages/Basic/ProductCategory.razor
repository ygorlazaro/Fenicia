@page "/basic/productcategory"
@rendermode InteractiveServer
@using Fenicia.Web.Components.Shared
@using Fenicia.Web.Components.Pages.Basic.Models
@using Fenicia.Web.Components.Pages.Basic.Elementary

<CrudPage TItem="ProductCategoryDto"
          PageTitle="Categorias de Produtos"
          PageSubtitle="Gerencie suas categorias de produtos"
          EntityNamePlural="categorias de produtos"
          EntityNameSingular="Categoria"
          Endpoint="productcategory"
          ColumnCount="3"
          AddButtonLabel="Adicionar Categoria"
          AddTabText="Nova Categoria"
          EditTabText="Editar Categoria"
          AddDialogTitle="Adicionar Categoria"
          EditDialogTitle="Editar Categoria"
          CreateButtonLabel="Criar"
          UpdateButtonLabel="Atualizar"
          DeleteDialogTitle="Excluir Categoria"
          CreatePayloadFactory="CreatePayload"
          OnAdd="ResetAddName"
          OnEdit="LoadEditName">
    <HeaderContent>
        <ProductCategoryHeader />
    </HeaderContent>
    <RowTemplate>
        <ProductCategoryRow Item="context.Item" Page="context.Page" />
    </RowTemplate>
    <AddModalBody>
        <MudTextField @bind-Value="addName" Label="Nome da Categoria" Variant="Variant.Outlined" Required="true" RequiredError="Nome da categoria é obrigatório!" />
    </AddModalBody>
    <EditModalBody>
        <MudTextField @bind-Value="editName" Label="Nome da Categoria" Variant="Variant.Outlined" Required="true" RequiredError="Nome da categoria é obrigatório!" />
    </EditModalBody>
</CrudPage>

@code {
    private string addName = string.Empty;
    private string editName = string.Empty;

    private void ResetAddName() => addName = string.Empty;

    private void LoadEditName(ProductCategoryDto item) => editName = item?.Name ?? string.Empty;

    private object CreatePayload(CrudModalContext<ProductCategoryDto> ctx)
    {
        var name = ctx.IsAdd ? addName : editName;
        return new
        {
            Id = ctx.IsAdd ? Guid.NewGuid() : ctx.Id,
            Name = name
        };
    }
}
