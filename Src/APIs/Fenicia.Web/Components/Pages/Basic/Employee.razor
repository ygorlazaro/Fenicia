@page "/basic/employee"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext
@using Fenicia.Common
@using Fenicia.Web.Components.Shared
@using Fenicia.Web.Components.Pages.Basic.Models
@using Fenicia.Web.Components.Pages.Basic.Elementary
@using System.Text.Json

<CrudPage TItem="EmployeeDto"
          PageTitle="Funcionários"
          PageSubtitle="Gerencie os funcionários da sua empresa"
          EntityNamePlural="funcionários"
          EntityNameSingular="Funcionário"
          Endpoint="employee"
          ColumnCount="8"
          AddButtonLabel="Adicionar Funcionário"
          AddDialogTitle="Adicionar Funcionário"
          EditDialogTitle="Editar Funcionário"
          CreateButtonLabel="Criar"
          UpdateButtonLabel="Atualizar"
          DeleteDialogTitle="Excluir Funcionário"
          CreatePayloadFactory="CreatePayload"
          OnAdd="ResetForm"
          OnEdit="LoadForm">
    <HeaderContent>
        <EmployeeHeader />
    </HeaderContent>
    <RowTemplate>
        <EmployeeRow Item="context.Item"
                     OnEdit="@(() => context.Page.OpenEditModal(context.Item))"
                     OnDelete="@(() => context.Page.RequestDelete(context.Item))" />
    </RowTemplate>
    <AddModalBody>
        <EmployeeForm Model="add" States="states" Positions="positions" />
    </AddModalBody>
    <EditModalBody>
        <EmployeeForm Model="edit" States="states" Positions="positions" />
    </EditModalBody>
</CrudPage>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    private List<StateOption> states = [];
    private List<PositionOption> positions = [];
    private EmployeeFormModel add = new();
    private EmployeeFormModel edit = new();

    protected override Task OnInitializedAsync()
    {
        return LoadOptionsAsync();
    }

    private async Task LoadOptionsAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("FeniciaBasic");

            var token = await CompanyContext.GetTokenAsync();
            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var companyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (companyId.HasValue)
            {
                client.DefaultRequestHeaders.Remove("CompanyId");
                client.DefaultRequestHeaders.Add("CompanyId", companyId.Value.ToString());
            }

            var statesTask = client.GetAsync("state");
            var positionsTask = client.GetAsync("position?page=1&perPage=200");

            await Task.WhenAll(statesTask, positionsTask);

            var statesResponse = await statesTask;
            if (statesResponse.IsSuccessStatusCode)
            {
                var body = await statesResponse.Content.ReadAsStringAsync();
                var items = JsonSerializer.Deserialize<List<StateOption>>(body, JsonOptions);
                states = items ?? [];
            }

            var positionsResponse = await positionsTask;
            if (positionsResponse.IsSuccessStatusCode)
            {
                var body = await positionsResponse.Content.ReadAsStringAsync();
                var paginated = JsonSerializer.Deserialize<Pagination<List<PositionOption>>>(body, JsonOptions);
                positions = paginated?.Data ?? [];
            }
        }
        catch
        {
            states = [];
            positions = [];
        }
    }

    private void ResetForm() => add = new EmployeeFormModel();

    private void LoadForm(EmployeeDto? item)
    {
        edit = item is null
            ? new EmployeeFormModel()
            : new EmployeeFormModel
            {
                Name = item.Name,
                Email = item.Email,
                PhoneNumber = item.PhoneNumber,
                Document = item.Document,
                PositionId = item.PositionId,
                Street = item.Address?.Street,
                Number = item.Address?.Number,
                Complement = item.Address?.Complement,
                Neighborhood = item.Address?.Neighborhood,
                ZipCode = item.Address?.ZipCode,
                City = item.Address?.City,
                StateId = item.Address is { StateId: var sid } && sid != Guid.Empty ? sid : null,
                Country = item.Address?.Country
            };
    }

    private object CreatePayload(CrudModalContext<EmployeeDto> ctx)
    {
        var model = ctx.IsAdd ? add : edit;
        return new
        {
            Id = ctx.IsAdd ? Guid.NewGuid() : ctx.Id,
            PositionId = model.PositionId,
            Name = model.Name ?? string.Empty,
            Email = model.Email,
            Document = model.Document,
            PhoneNumber = model.PhoneNumber,
            Address = BuildAddress(model)
        };
    }

    private static object? BuildAddress(EmployeeFormModel model)
    {
        if (string.IsNullOrWhiteSpace(model.Street)
            || string.IsNullOrWhiteSpace(model.Number)
            || string.IsNullOrWhiteSpace(model.ZipCode)
            || string.IsNullOrWhiteSpace(model.City)
            || model.StateId is null)
        {
            return null;
        }

        return new
        {
            Street = model.Street,
            Number = model.Number,
            Complement = model.Complement,
            Neighborhood = model.Neighborhood,
            ZipCode = model.ZipCode,
            City = model.City,
            StateId = model.StateId.Value,
            Country = model.Country
        };
    }
}
