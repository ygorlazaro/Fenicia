@page "/basic/product"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext
@using Fenicia.Web.Components.Shared
@using Fenicia.Web.Components.Pages.Basic.Elementary
@using System.Text.Json

<CrudPage TItem="GetAllProductResponse"
          PageTitle="Produtos"
          PageSubtitle="Gerencie o catálogo de produtos da sua empresa"
          EntityNamePlural="produtos"
          EntityNameSingular="Produto"
          Endpoint="product"
          ColumnCount="7"
          AddButtonLabel="Adicionar Produto"
          AddDialogTitle="Adicionar Produto"
          EditDialogTitle="Editar Produto"
          CreateButtonLabel="Criar"
          UpdateButtonLabel="Atualizar"
          DeleteDialogTitle="Excluir Produto"
          CreatePayloadFactory="CreatePayload"
          OnAdd="ResetForm"
          OnEdit="LoadForm">
    <HeaderContent>
        <ProductHeader />
    </HeaderContent>
    <RowTemplate>
        <ProductRow Item="context.Item"
                    OnEdit="@(() => context.Page.OpenEditModal(context.Item))"
                    OnDelete="@(() => context.Page.RequestDelete(context.Item))" />
    </RowTemplate>
    <AddModalBody>
        <ProductForm Model="add" Categories="categories" Suppliers="suppliers" />
    </AddModalBody>
    <EditModalBody>
        <ProductForm Model="edit" Categories="categories" Suppliers="suppliers" />
    </EditModalBody>
</CrudPage>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    private List<CategoryOption> categories = new();
    private List<SupplierOption> suppliers = new();
    private ProductFormModel add = new();
    private ProductFormModel edit = new();

    protected override Task OnInitializedAsync()
    {
        return LoadOptionsAsync();
    }

    private async Task LoadOptionsAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("FeniciaBasic");
            var token = await CompanyContext.GetTokenAsync();
            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }
            var companyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (companyId.HasValue)
            {
                client.DefaultRequestHeaders.Remove("CompanyId");
                client.DefaultRequestHeaders.Add("CompanyId", companyId.Value.ToString());
            }
            var categoriesTask = client.GetAsync("datasource/productcategory");
            var suppliersTask = client.GetAsync("datasource/supplier");
            await Task.WhenAll(categoriesTask, suppliersTask);
            if (categoriesTask.Result.IsSuccessStatusCode)
            {
                var body = await categoriesTask.Result.Content.ReadAsStringAsync();
                categories = JsonSerializer.Deserialize<List<CategoryOption>>(body, JsonOptions) ?? new();
            }
            if (suppliersTask.Result.IsSuccessStatusCode)
            {
                var body = await suppliersTask.Result.Content.ReadAsStringAsync();
                suppliers = JsonSerializer.Deserialize<List<SupplierOption>>(body, JsonOptions) ?? new();
            }
        }
        catch
        {
            categories = new();
            suppliers = new();
        }
    }

    private void ResetForm() => add = new ProductFormModel();

    private void LoadForm(GetAllProductResponse item)
    {
        edit = item is null
            ? new ProductFormModel()
            : new ProductFormModel
            {
                Name = item.Name,
                SKU = item.SKU,
                Barcode = item.Barcode,
                CostPrice = item.CostPrice,
                SalesPrice = item.SalesPrice,
                Quantity = item.Quantity,
                MinStockLevel = item.MinStockLevel,
                MaxStockLevel = item.MaxStockLevel,
                UnitOfMeasure = item.UnitOfMeasure,
                Weight = item.Weight,
                Dimensions = item.Dimensions,
                ImageUrl = item.ImageUrl,
                Description = item.Description,
                CategoryId = item.CategoryId,
                SupplierId = item.SupplierId
            };
    }

    private object CreatePayload(CrudModalContext<GetAllProductResponse> ctx)
    {
        var model = ctx.IsAdd ? add : edit;
        return new
        {
            Id = ctx.IsAdd ? Guid.NewGuid() : ctx.Id,
            Name = model.Name ?? string.Empty,
            SKU = model.SKU,
            Barcode = model.Barcode,
            Description = model.Description,
            CostPrice = model.CostPrice,
            SalesPrice = model.SalesPrice,
            Quantity = model.Quantity,
            MinStockLevel = model.MinStockLevel,
            MaxStockLevel = model.MaxStockLevel,
            ImageUrl = model.ImageUrl,
            Weight = model.Weight,
            Dimensions = model.Dimensions,
            UnitOfMeasure = model.UnitOfMeasure,
            CategoryId = model.CategoryId,
            SupplierId = model.SupplierId
        };
    }
}
