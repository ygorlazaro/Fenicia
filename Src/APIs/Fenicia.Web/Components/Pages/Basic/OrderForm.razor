@page "/basic/order/new"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext
@inject IAuthStateService AuthState
@inject ISnackbar Snackbar
@using Fenicia.Web.Components.Shared
@using Fenicia.Web.Components.Pages.Basic.Models
@using Fenicia.Web.Components.Pages.Basic.Elementary
@using System.Text.Json
@using Fenicia.Common.Enums.Auth
@using Fenicia.Common.Enums.Basic

<PageTitle>Pedidos - Fenicia</PageTitle>

<MainLayout>
    @if (!isLoggedIn)
    {
        <MudAlert Severity="Severity.Error">Faça login para gerenciar pedidos.</MudAlert>
    }
    else
    {
        <MudGrid Spacing="3">
            <MudItem xs="12">
                <OrderFormHeader Loading="_isLoading"
                                 HasCartItems="_cart.Any()"
                                 OnRefresh="LoadAllAsync"
                                 OnClearCart="ClearCart" />
            </MudItem>

            <MudItem xs="12" md="7" lg="8">
                <OrderFormProductSearch Products="_products"
                                        Search="_search"
                                        Loading="_isLoading"
                                        OnSearchKeyDown="OnSearchKeyDown"
                                        OnProductClick="AddToCart" />
            </MudItem>

            <MudItem xs="12" md="5" lg="4">
                <OrderFormCart Cart="_cart"
                               CartCustomerId="_cartCustomerId"
                               CartEmployeeId="_cartEmployeeId"
                               CartPaymentMethod="_cartPaymentMethod"
                               CartStatus="_cartStatus"
                               CartDiscount="_cartDiscount"
                               CartNotes="_cartNotes"
                               Customers="_customers"
                               Employees="_employees"
                               RecentOrders="_recentOrders"
                               IsSubmitting="_isSubmitting"
                                OnRemove="RemoveFromCart"
                                OnUpdateQty="@((payload) => UpdateQty(payload.ProductId, payload.Qty))"
                                OnIncrease="IncreaseQty"
                                OnDecrease="DecreaseQty"
                                OnFinalize="FinalizeSaleAsync" />
            </MudItem>
        </MudGrid>

        <OrderFormSuccessDialog Visible="_showSuccessDialog"
                                LastOrderNumber="_lastOrderNumber"
                                LastOrderTotal="_lastOrderTotal"
                                LastOrderId="_lastOrderId"
                                OnStartNewSale="StartNewSale" />
    }
</MainLayout>

<style>
    .pdv-product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 12px;
        max-height: calc(100vh - 340px);
        overflow-y: auto;
        padding: 4px;
    }

    .pdv-product-card {
        cursor: pointer;
        transition: transform 0.12s ease, box-shadow 0.12s ease;
    }

    .pdv-product-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 14px rgba(94, 53, 177, 0.18) !important;
    }

    .pdv-product-disabled {
        opacity: 0.55;
        cursor: not-allowed;
    }

    .pdv-product-disabled:hover {
        transform: none;
        box-shadow: none !important;
    }

    .pdv-product-name {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 36px;
        line-height: 1.2;
    }

    .pdv-cart {
        position: sticky;
        top: 80px;
    }

    .pdv-cart-items {
        max-height: 320px;
        overflow-y: auto;
    }

    .pdv-cart-item-name {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.2;
        flex: 1;
    }

    .pdv-recent-orders {
        max-height: 260px;
        overflow-y: auto;
    }
</style>

@code {
    #pragma warning disable CS0169, CS0649

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true,
        Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() }
    };

    private bool isLoggedIn;
    private bool _isLoading = true;
    private bool _isSubmitting;

    private string? _search;

    private List<OrderFormDashboardProductDto> _products = [];
    private List<OrderFormCustomerOption> _customers = [];
    private List<OrderFormEmployeeOption> _employees = [];
    private List<OrderFormRecentOrderDto>? _recentOrders;

    private List<OrderFormCartItem> _cart = [];

    private Guid _cartCustomerId;
    private Guid? _cartEmployeeId;
    private PaymentMethod _cartPaymentMethod = PaymentMethod.Cash;
    private OrderStatus _cartStatus = OrderStatus.Approved;
    private decimal _cartDiscount;
    private string? _cartNotes;

    private bool _showSuccessDialog;
    private string? _lastOrderNumber;
    private decimal _lastOrderTotal;
    private Guid _lastOrderId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            isLoggedIn = await AuthState.IsAuthenticatedAsync();
        }
        catch
        {
            isLoggedIn = false;
        }

        if (isLoggedIn)
        {
            await LoadAllAsync();
        }
        else
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadAllAsync()
    {
        try
        {
            _isLoading = true;
            StateHasChanged();

            var client = HttpClientFactory.CreateClient("FeniciaBasic");
            var token = await CompanyContext.GetTokenAsync();
            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var companyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (companyId.HasValue)
            {
                client.DefaultRequestHeaders.Remove("CompanyId");
                client.DefaultRequestHeaders.Add("CompanyId", companyId.Value.ToString());
            }

            var productsTask = client.GetAsync("datasource/dashboard/product");
            var customersTask = client.GetAsync("datasource/customer");
            var employeesTask = client.GetAsync("datasource/employee");
            var recentOrdersTask = client.GetAsync("order?page=1&perPage=5");

            await Task.WhenAll(productsTask, customersTask, employeesTask, recentOrdersTask);

            if (productsTask.Result.IsSuccessStatusCode)
            {
                var body = await productsTask.Result.Content.ReadAsStringAsync();
                _products = JsonSerializer.Deserialize<List<OrderFormDashboardProductDto>>(body, JsonOptions) ?? [];
            }

            if (customersTask.Result.IsSuccessStatusCode)
            {
                var body = await customersTask.Result.Content.ReadAsStringAsync();
                _customers = JsonSerializer.Deserialize<List<OrderFormCustomerOption>>(body, JsonOptions) ?? [];
            }

            if (employeesTask.Result.IsSuccessStatusCode)
            {
                var body = await employeesTask.Result.Content.ReadAsStringAsync();
                _employees = JsonSerializer.Deserialize<List<OrderFormEmployeeOption>>(body, JsonOptions) ?? [];
            }

            _recentOrders = [];
            if (recentOrdersTask.Result.IsSuccessStatusCode)
            {
                var body = await recentOrdersTask.Result.Content.ReadAsStringAsync();
                var paginated = JsonSerializer.Deserialize<OrderFormPaginationWrapper<OrderFormRecentOrderDto>>(body, JsonOptions);
                _recentOrders = paginated?.Data ?? [];
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar dados: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            StateHasChanged();
        }
    }

    private void AddToCart(OrderFormDashboardProductDto product)
    {
        if (product.Quantity <= 0)
        {
            Snackbar.Add("Produto sem estoque.", Severity.Warning);
            return;
        }

        var existing = _cart.FirstOrDefault(c => c.ProductId == product.Id);
        if (existing is not null)
        {
            if (existing.Quantity + 1 > product.Quantity)
            {
                Snackbar.Add($"Estoque insuficiente. Disponível: {product.Quantity:0.##}", Severity.Warning);
                return;
            }

            existing.Quantity += 1;
            existing.Subtotal = existing.UnitPrice * (decimal)existing.Quantity - existing.DiscountAmount;
        }
        else
        {
            _cart.Add(new OrderFormCartItem
            {
                ProductId = product.Id,
                Name = product.Name,
                UnitPrice = product.SalesPrice,
                Quantity = 1,
                DiscountAmount = 0,
                Subtotal = product.SalesPrice
            });
        }

        StateHasChanged();
    }

    private void RemoveFromCart(Guid productId)
    {
        _cart.RemoveAll(c => c.ProductId == productId);
        StateHasChanged();
    }

    private void IncreaseQty(Guid productId)
    {
        var item = _cart.FirstOrDefault(c => c.ProductId == productId);
        if (item is null)
        {
            return;
        }

        var product = _products.FirstOrDefault(p => p.Id == productId);
        if (product is not null && item.Quantity + 1 > product.Quantity)
        {
            Snackbar.Add($"Estoque insuficiente. Disponível: {product.Quantity:0.##}", Severity.Warning);
            return;
        }

        item.Quantity += 1;
        item.Subtotal = item.UnitPrice * (decimal)item.Quantity - item.DiscountAmount;
        StateHasChanged();
    }

    private void DecreaseQty(Guid productId)
    {
        var item = _cart.FirstOrDefault(c => c.ProductId == productId);
        if (item is null)
        {
            return;
        }

        item.Quantity -= 1;
        if (item.Quantity <= 0)
        {
            _cart.RemoveAll(c => c.ProductId == productId);
        }
        else
        {
            item.Subtotal = item.UnitPrice * (decimal)item.Quantity - item.DiscountAmount;
        }

        StateHasChanged();
    }

    private void UpdateQty(Guid productId, double newQty)
    {
        var item = _cart.FirstOrDefault(c => c.ProductId == productId);
        if (item is null)
        {
            return;
        }

        if (newQty <= 0)
        {
            _cart.RemoveAll(c => c.ProductId == productId);
            StateHasChanged();
            return;
        }

        var product = _products.FirstOrDefault(p => p.Id == productId);
        if (product is not null && newQty > product.Quantity)
        {
            Snackbar.Add($"Estoque insuficiente. Disponível: {product.Quantity:0.##}", Severity.Warning);
            item.Quantity = product.Quantity;
        }
        else
        {
            item.Quantity = newQty;
        }

        item.Subtotal = item.UnitPrice * (decimal)item.Quantity - item.DiscountAmount;
        StateHasChanged();
    }

    private void ClearCart()
    {
        _cart.Clear();
        _cartDiscount = 0;
        _cartNotes = null;
        StateHasChanged();
    }

    private void StartNewSale()
    {
        _showSuccessDialog = false;
        ClearCart();
        _ = LoadRecentOrdersAsync();
    }

    private async Task LoadRecentOrdersAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("FeniciaBasic");
            var token = await CompanyContext.GetTokenAsync();
            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var companyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (companyId.HasValue)
            {
                client.DefaultRequestHeaders.Remove("CompanyId");
                client.DefaultRequestHeaders.Add("CompanyId", companyId.Value.ToString());
            }

            var response = await client.GetAsync("order?page=1&perPage=5");
            if (response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                var paginated = JsonSerializer.Deserialize<OrderFormPaginationWrapper<OrderFormRecentOrderDto>>(body, JsonOptions);
                _recentOrders = paginated?.Data ?? [];
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
            // best-effort
        }
    }

    private async Task FinalizeSaleAsync()
    {
        if (!_cart.Any() || _cartCustomerId == Guid.Empty)
        {
            return;
        }

        try
        {
            _isSubmitting = true;
            StateHasChanged();

            var userId = await CompanyContext.GetUserIdAsync();

            var client = HttpClientFactory.CreateClient("FeniciaBasic");

            var token = await CompanyContext.GetTokenAsync();
            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var companyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (companyId.HasValue)
            {
                client.DefaultRequestHeaders.Remove("CompanyId");
                client.DefaultRequestHeaders.Add("CompanyId", companyId.Value.ToString());
            }

            var payload = new
            {
                UserId = userId,
                CustomerId = _cartCustomerId,
                SaleDate = DateTime.UtcNow,
                Status = _cartStatus,
                PaymentMethod = _cartPaymentMethod,
                EmployeeId = _cartEmployeeId,
                Notes = _cartNotes,
                DiscountAmount = _cartDiscount,
                Details = _cart.Select(c => new
                {
                    ProductId = c.ProductId,
                    Price = c.UnitPrice,
                    Quantity = c.Quantity,
                    DiscountAmount = c.DiscountAmount
                }).ToList()
            };

            var response = await client.PostAsJsonAsync("order", payload, JsonOptions);

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Falha ao criar pedido: {(int)response.StatusCode} - {body}", Severity.Error);
                return;
            }

            var json = await response.Content.ReadAsStringAsync();
            var created = JsonSerializer.Deserialize<OrderFormCreateOrderResponseDto>(json, JsonOptions);
            if (created is not null)
            {
                _lastOrderId = created.Id;
                _lastOrderNumber = created.OrderNumber;
                _lastOrderTotal = created.TotalAmount;
            }

            _showSuccessDialog = true;
            Snackbar.Add("Pedido criado com sucesso!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
