@page "/basic/order/{Id:guid}"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext
@inject IAuthStateService AuthState
@inject ISnackbar Snackbar
@using Fenicia.Web.Components.Shared
@using Fenicia.Web.Components.Pages.Basic.Models
@using Fenicia.Web.Components.Pages.Basic.Elementary
@using System.Text.Json
@using Fenicia.Common.Enums.Basic

<PageTitle>Pedido @(_order?.OrderNumber ?? "...") - Fenicia</PageTitle>

<MainLayout>
    @if (!isLoggedIn)
    {
        <MudAlert Severity="Severity.Error">Faça login para visualizar pedidos.</MudAlert>
    }
    else if (_isLoading)
    {
        <div class="d-flex justify-center my-16">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        </div>
    }
    else if (_order is null)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            Pedido não encontrado.
            <MudLink Href="/basic/order" Class="ml-2">Voltar para pedidos</MudLink>
        </MudAlert>
    }
    else
    {
        <MudGrid Spacing="3">
            <MudItem xs="12">
                <OrderDetailHeader Order="_order" OnPrint="PrintInvoice" />
            </MudItem>

            <MudItem xs="12" md="8">
                <OrderDetailItemsTable Items="_details" />
            </MudItem>

            <MudItem xs="12" md="4">
                <OrderDetailSummary Order="_order" />
            </MudItem>
        </MudGrid>
    }
</MainLayout>

<style>
    .invoice-section {
        min-height: 200px;
    }

    .invoice-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    @@media print {
        .mud-appbar, .mud-drawer, .fenicia-footer, .mud-button, .mud-icon-button {
            display: none !important;
        }

        .invoice-section {
            box-shadow: none !important;
            border: 1px solid #ddd;
        }
    }
</style>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true,
        Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() }
    };

    [Parameter] public Guid Id { get; set; }

    private bool isLoggedIn;
    private bool _isLoading = true;
    private OrderDetailOrderDto? _order;
    private List<OrderDetailItemDto> _details = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            isLoggedIn = await AuthState.IsAuthenticatedAsync();
        }
        catch
        {
            isLoggedIn = false;
        }

        if (isLoggedIn)
        {
            await LoadOrderAsync();
        }
        else
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override void OnParametersSet()
    {
        if (_order is not null && _order.Id != Id)
        {
            _order = null;
            _details = [];
        }
    }

    private async Task LoadOrderAsync()
    {
        try
        {
            _isLoading = true;
            StateHasChanged();

            var client = HttpClientFactory.CreateClient("FeniciaBasic");
            var token = await CompanyContext.GetTokenAsync();
            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var companyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (companyId.HasValue)
            {
                client.DefaultRequestHeaders.Remove("CompanyId");
                client.DefaultRequestHeaders.Add("CompanyId", companyId.Value.ToString());
            }

            var orderTask = client.GetAsync($"order/{Id}");
            var detailsTask = client.GetAsync($"order/{Id}/orderdetail");

            await Task.WhenAll(orderTask, detailsTask);

            if (orderTask.Result.IsSuccessStatusCode)
            {
                var body = await orderTask.Result.Content.ReadAsStringAsync();
                _order = JsonSerializer.Deserialize<OrderDetailOrderDto>(body, JsonOptions);
            }

            if (detailsTask.Result.IsSuccessStatusCode)
            {
                var body = await detailsTask.Result.Content.ReadAsStringAsync();
                _details = JsonSerializer.Deserialize<List<OrderDetailItemDto>>(body, JsonOptions) ?? [];
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar pedido: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void PrintInvoice()
    {
        NavigationManager.NavigateTo("javascript:window.print()", false);
    }
}
