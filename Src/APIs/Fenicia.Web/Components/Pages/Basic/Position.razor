@page "/basic/position"
@rendermode InteractiveServer
@using Fenicia.Web.Components.Shared
@using Fenicia.Web.Components.Pages.Basic.Models
@using Fenicia.Web.Components.Pages.Basic.Elementary

<CrudPage TItem="PositionDto"
          PageTitle="Cargos"
          PageSubtitle="Gerencie os cargos da sua empresa"
          EntityNamePlural="cargos"
          EntityNameSingular="Cargo"
          Endpoint="position"
          ColumnCount="3"
          AddButtonLabel="Adicionar Cargo"
          AddDialogTitle="Adicionar Cargo"
          EditDialogTitle="Editar Cargo"
          CreateButtonLabel="Criar"
          UpdateButtonLabel="Atualizar"
          DeleteDialogTitle="Excluir Cargo"
          CreatePayloadFactory="CreatePayload"
          OnAdd="ResetForm"
          OnEdit="LoadForm">
    <HeaderContent>
        <PositionHeader />
    </HeaderContent>
    <RowTemplate>
        <PositionRow Item="context.Item" Page="context.Page" />
    </RowTemplate>
    <AddModalBody>
        <MudTextField @bind-Value="addName" Label="Nome do Cargo" Variant="Variant.Outlined" Required="true" RequiredError="Nome é obrigatório!" />
    </AddModalBody>
    <EditModalBody>
        <MudTextField @bind-Value="editName" Label="Nome do Cargo" Variant="Variant.Outlined" Required="true" RequiredError="Nome é obrigatório!" />
    </EditModalBody>
</CrudPage>

@code {
    private string addName = string.Empty;
    private string editName = string.Empty;

    private void ResetForm() => addName = string.Empty;

    private void LoadForm(PositionDto item) => editName = item?.Name ?? string.Empty;

    private object CreatePayload(CrudModalContext<PositionDto> ctx)
    {
        var name = ctx.IsAdd ? addName : editName;
        return new
        {
            Name = name
        };
    }
}
