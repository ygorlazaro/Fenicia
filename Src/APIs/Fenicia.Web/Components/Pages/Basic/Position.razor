@page "/basic/position"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@using Fenicia.Web.Services
@using Fenicia.Web.Components.Shared
@using System.Web
@inject NavigationManager Navigation

<CrudPage @ref="_crudPage" TItem="PositionDto"
          PageTitle="Cargos"
          PageSubtitle="Gerencie os cargos da sua empresa"
          EntityNamePlural="cargos"
          EntityNameSingular="Cargo"
          Endpoint="position"
           ColumnCount="3"
          AddButtonLabel="Adicionar Cargo"
          AddDialogTitle="Adicionar Cargo"
          EditDialogTitle="Editar Cargo"
          CreateButtonLabel="Criar"
          UpdateButtonLabel="Atualizar"
          DeleteDialogTitle="Excluir Cargo"
           CreatePayloadFactory="CreatePayload"
            OnAdd="ResetForm"
            OnEdit="LoadForm">
    <HeaderContent>
        <MudTh Style="text-align: left; min-width: 120px; width: 120px">Ações</MudTh>
        <MudTh Sortable="true" SortLabel="Name">Nome</MudTh>
        <MudTh Style="text-align: left; min-width: 140px; width: 140px">Funcionários</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Ações" Style="text-align: left; min-width: 120px; width: 120px">
            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                           Color="Color.Info"
                           Size="Size.Small"
                           OnClick="@(() => context.Page.OpenEditModal(context.Item))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           Color="Color.Error"
                           Size="Size.Small"
                           OnClick="@(() => context.Page.RequestDelete(context.Item))" />
        </MudTd>
        <MudTd DataLabel="Nome">@context.Item.Name</MudTd>
        <MudTd DataLabel="Funcionários" Style="text-align: left">
            <MudLink Href="@($"/basic/employee?filters%5BPositionId%5D={context.Item.Id}")" Typo="Typo.body2" Underline="Underline.Always">Ver funcionários</MudLink>
        </MudTd>
    </RowTemplate>
    <AddModalBody>
        <MudTextField @bind-Value="_addName" Label="Nome do Cargo" Variant="Variant.Outlined" Required="true" RequiredError="Nome é obrigatório!" />
    </AddModalBody>
    <EditModalBody>
        <MudTextField @bind-Value="_editName" Label="Nome do Cargo" Variant="Variant.Outlined" Required="true" RequiredError="Nome é obrigatório!" />
    </EditModalBody>
</CrudPage>

@code {
    private string _addName = string.Empty;
    private string _editName = string.Empty;

    private CrudPage<PositionDto> _crudPage = default!;

    protected override Task OnInitializedAsync()
    {
        return Task.CompletedTask;
    }

    protected override void OnParametersSet()
    {
    }

    private void ResetForm() => _addName = string.Empty;

    private void LoadForm(PositionDto item) => _editName = item?.Name ?? string.Empty;

    private object CreatePayload(CrudModalContext<PositionDto> ctx)
    {
        var name = ctx.IsAdd ? _addName : _editName;
        return new
        {
            Name = name
        };
    }

    public class PositionDto : IEquatable<PositionDto>, ICrudItem
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;

        public bool Equals(PositionDto? other)
        {
            if (other is null) return false;
            return Id == other.Id && Name == other.Name;
        }

        public override bool Equals(object? obj) => Equals(obj as PositionDto);

        public override int GetHashCode() => HashCode.Combine(Id, Name);
    }
}