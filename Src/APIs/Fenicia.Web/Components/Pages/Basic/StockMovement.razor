@page "/basic/stockmovement"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext
@inject ISnackbar Snackbar
@using System.Net.Http.Json
@using System.Text.Json
@using Fenicia.Common.Enums.Basic

<MainLayout>
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">Movimentações de Estoque</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Registre entradas e saídas de estoque. Cada movimentação altera a quantidade atual do produto.
            </MudText>
        </MudStack>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Assessment" Href="/basic/inventory">
                Ver Inventário
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddModal">
                Nova Movimentação
            </MudButton>
        </MudStack>
    </MudStack>

    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudGrid Spacing="2" AlignItems="AlignItems.Center">
            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker @bind-Date="_startDate" Label="Data inicial" Variant="Variant.Outlined" Clearable="true" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker @bind-Date="_endDate" Label="Data final" Variant="Variant.Outlined" Clearable="true" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="TypeFilter" @bind-Value="_typeFilter" Label="Tipo" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                    <MudSelectItem T="TypeFilter" Value="TypeFilter.All">Todos</MudSelectItem>
                    <MudSelectItem T="TypeFilter" Value="TypeFilter.In">Entrada</MudSelectItem>
                    <MudSelectItem T="TypeFilter" Value="TypeFilter.Out">Saída</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FilterList" OnClick="LoadMovementsAsync" Disabled="_loading" FullWidth="true">
                    Filtrar
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4" Elevation="2">
        @if (_loading)
        {
            <MudStack AlignItems="AlignItems.Center" Class="my-6">
                <MudProgressCircular Indeterminate="true" />
                <MudText Typo="Typo.body2">Carregando movimentações...</MudText>
            </MudStack>
        }
        else if (_movements.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                Nenhuma movimentação encontrada no período selecionado.
            </MudAlert>
        }
        else
        {
            <MudTable T="StockMovementDto" Items="@_movements" Dense="true" Hover="true" Bordered="false" Elevation="0" SortLabel="Ordenar por">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortLabel="date" T="StockMovementDto">Data</MudTableSortLabel></MudTh>
                    <MudTh>Tipo</MudTh>
                    <MudTh>Produto</MudTh>
                    <MudTh Style="text-align: right">Quantidade</MudTh>
                    <MudTh Style="text-align: right">Preço</MudTh>
                    <MudTh>Origem</MudTh>
                    <MudTh>Motivo</MudTh>
                    <MudTh Style="text-align: right">Ações</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Data">@(context.Date?.ToString("dd/MM/yyyy HH:mm") ?? "—")</MudTd>
                    <MudTd DataLabel="Tipo">
                        @if (context.Type == StockMovementType.In)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.ArrowDownward">Entrada</MudChip>
                        }
                        else if (context.Type == StockMovementType.Out)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" Icon="@Icons.Material.Filled.ArrowUpward">Saída</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">—</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Produto">@context.ProductName</MudTd>
                    <MudTd DataLabel="Quantidade" Style="text-align: right">@context.Quantity.ToString("N2")</MudTd>
                    <MudTd DataLabel="Preço" Style="text-align: right">@((context.Price ?? 0).ToString("C"))</MudTd>
                    <MudTd DataLabel="Origem">@ResolveOrigin(context)</MudTd>
                    <MudTd DataLabel="Motivo">@(string.IsNullOrEmpty(context.Reason) ? "—" : context.Reason)</MudTd>
                    <MudTd DataLabel="Ações" Style="text-align: right">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Info"
                                       Size="Size.Small"
                                       OnClick="@(() => OpenEditModal(context))" />
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 10, 20, 50, 100 }" RowsPerPageString="Itens por página:" InfoFormat="{first_item}-{last_item} de {all_items}" AllItemsText="Todos" />
                </PagerContent>
            </MudTable>
        }
    </MudPaper>
</MudContainer>
</MainLayout>

<MudDialog @bind-Visible="_modalOpen" Options="@_modalOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isEdit ? "Editar Movimentação" : "Nova Movimentação")</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="8">
                <MudSelect T="Guid" @bind-Value="_form.ProductId" Label="Produto" Variant="Variant.Outlined" Required="true" RequiredError="Selecione um produto!">
                    @foreach (var p in _products)
                    {
                        <MudSelectItem T="Guid" Value="@p.Id">@p.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="StockMovementType" @bind-Value="_form.Type" Label="Tipo" Variant="Variant.Outlined" Required="true">
                    <MudSelectItem T="StockMovementType" Value="StockMovementType.In">Entrada</MudSelectItem>
                    <MudSelectItem T="StockMovementType" Value="StockMovementType.Out">Saída</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField T="double" @bind-Value="_form.Quantity" Label="Quantidade" Variant="Variant.Outlined" Min="0" Required="true" RequiredError="Quantidade é obrigatória!" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField T="decimal" @bind-Value="_form.Price" Label="Preço unitário" Variant="Variant.Outlined" Min="0" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudDatePicker @bind-Date="_form.Date" Label="Data" Variant="Variant.Outlined" />
            </MudItem>
            @if (_form.Type == StockMovementType.In)
            {
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" @bind-Value="_form.SupplierId" Label="Fornecedor" Variant="Variant.Outlined" Clearable="true">
                        @foreach (var s in _suppliers)
                        {
                            <MudSelectItem T="Guid?" Value="@s.Id">@s.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            else
            {
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" @bind-Value="_form.CustomerId" Label="Cliente" Variant="Variant.Outlined" Clearable="true">
                        @foreach (var c in _customers)
                        {
                            <MudSelectItem T="Guid?" Value="@c.Id">@c.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid?" @bind-Value="_form.EmployeeId" Label="Funcionário" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var e in _employees)
                    {
                        <MudSelectItem T="Guid?" Value="@e.Id">@e.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_form.Reason" Label="Motivo" Variant="Variant.Outlined" Lines="2" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseModal" Variant="Variant.Text">Cancelar</MudButton>
        <MudButton OnClick="SubmitAsync" Variant="Variant.Filled" Color="Color.Primary" Disabled="_modalLoading">
            @if (_modalLoading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Default" Class="mr-2" />
            }
            @(_isEdit ? "Atualizar" : "Registrar")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private enum TypeFilter { All, In, Out }

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true,
        Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() }
    };

    private static readonly DialogOptions _modalOptions = new()
    {
        CloseButton = true,
        BackdropClick = false,
        MaxWidth = MaxWidth.Medium,
        FullWidth = true
    };

    private DateTime? _startDate = DateTime.Today.AddDays(-30);
    private DateTime? _endDate = DateTime.Today.AddDays(1);
    private TypeFilter _typeFilter = TypeFilter.All;

    private bool _loading = true;
    private bool _modalLoading;
    private bool _modalOpen;
    private bool _isEdit;

    private List<StockMovementDto> _movements = [];

    private List<DatasourceItem> _products = [];
    private List<DatasourceItem> _customers = [];
    private List<DatasourceItem> _suppliers = [];
    private List<DatasourceItem> _employees = [];

    private MovementFormModel _form = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadOptionsAsync();
            await LoadMovementsAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadOptionsAsync()
    {
        try
        {
            var client = await BuildClientAsync();

            var productsTask = client.GetAsync("datasource/product");
            var customersTask = client.GetAsync("datasource/customer");
            var suppliersTask = client.GetAsync("datasource/supplier");
            var employeesTask = client.GetAsync("datasource/employee");

            await Task.WhenAll(productsTask, customersTask, suppliersTask, employeesTask);

            _products = await ReadDatasourceAsync(productsTask);
            _customers = await ReadDatasourceAsync(customersTask);
            _suppliers = await ReadDatasourceAsync(suppliersTask);
            _employees = await ReadDatasourceAsync(employeesTask);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar opções: {ex.Message}", Severity.Error);
        }
    }

    private static async Task<List<DatasourceItem>> ReadDatasourceAsync(Task<HttpResponseMessage> task)
    {
        var response = await task;
        if (!response.IsSuccessStatusCode)
        {
            return [];
        }

        var body = await response.Content.ReadAsStringAsync();
        return JsonSerializer.Deserialize<List<DatasourceItem>>(body, JsonOptions) ?? [];
    }

    private async Task LoadMovementsAsync()
    {
        _loading = true;
        try
        {
            var client = await BuildClientAsync();

            var query = new List<string>();
            if (_startDate.HasValue)
            {
                query.Add($"startDate={_startDate.Value:yyyy-MM-dd}");
            }
            if (_endDate.HasValue)
            {
                query.Add($"endDate={_endDate.Value:yyyy-MM-dd}");
            }
            if (_typeFilter != TypeFilter.All)
            {
                query.Add($"type={MapType(_typeFilter)}");
            }
            query.Add("page=1");
            query.Add("perPage=200");

            var qs = query.Count == 0 ? string.Empty : "?" + string.Join("&", query);
            var response = await client.GetAsync($"stockmovement{qs}");

            if (response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                _movements = JsonSerializer.Deserialize<List<StockMovementDto>>(body, JsonOptions) ?? [];
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Falha ao carregar: {(int)response.StatusCode} - {error}", Severity.Error);
                _movements = [];
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar movimentações: {ex.Message}", Severity.Error);
            _movements = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<HttpClient> BuildClientAsync()
    {
        var client = HttpClientFactory.CreateClient("FeniciaBasic");

        var token = await CompanyContext.GetTokenAsync();
        if (!string.IsNullOrEmpty(token))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }

        var companyId = await CompanyContext.GetSelectedCompanyIdAsync();
        if (companyId.HasValue)
        {
            client.DefaultRequestHeaders.Remove("CompanyId");
            client.DefaultRequestHeaders.Add("CompanyId", companyId.Value.ToString());
        }

        return client;
    }

    private static StockMovementType MapType(TypeFilter filter) => filter switch
    {
        TypeFilter.In => StockMovementType.In,
        TypeFilter.Out => StockMovementType.Out,
        _ => StockMovementType.None
    };

    private static string ResolveOrigin(StockMovementDto m)
    {
        if (!string.IsNullOrEmpty(m.SupplierName))
        {
            return $"Fornecedor: {m.SupplierName}";
        }
        if (!string.IsNullOrEmpty(m.CustomerName))
        {
            return $"Cliente: {m.CustomerName}";
        }
        if (!string.IsNullOrEmpty(m.EmployeeName))
        {
            return $"Funcionário: {m.EmployeeName}";
        }
        return "—";
    }

    private void OpenAddModal()
    {
        if (_products.Count == 0)
        {
            Snackbar.Add("Nenhum produto disponível para movimentação.", Severity.Warning);
            return;
        }

        _isEdit = false;
        _form = new MovementFormModel
        {
            Date = DateTime.Now,
            Type = StockMovementType.In
        };
        _modalOpen = true;
    }

    private void OpenEditModal(StockMovementDto item)
    {
        _isEdit = true;
        _form = new MovementFormModel
        {
            Id = item.Id,
            ProductId = item.ProductId,
            Type = item.Type,
            Quantity = item.Quantity,
            Price = item.Price ?? 0,
            Date = item.Date ?? DateTime.Now,
            CustomerId = item.CustomerId,
            SupplierId = item.SupplierId,
            EmployeeId = item.EmployeeId,
            Reason = item.Reason
        };
        _modalOpen = true;
    }

    private void CloseModal() => _modalOpen = false;

    private async Task SubmitAsync()
    {
        if (_modalLoading || _form.ProductId == Guid.Empty || _form.Quantity <= 0)
        {
            Snackbar.Add("Preencha produto e quantidade.", Severity.Warning);
            return;
        }

        _modalLoading = true;
        try
        {
            var client = await BuildClientAsync();

            object payload = _form.Id is null
                ? new
                {
                    Id = Guid.NewGuid(),
                    Quantity = _form.Quantity,
                    Date = _form.Date,
                    Price = (decimal?)_form.Price,
                    Type = _form.Type,
                    ProductId = _form.ProductId,
                    CustomerId = _form.Type == StockMovementType.Out ? _form.CustomerId : null,
                    SupplierId = _form.Type == StockMovementType.In ? _form.SupplierId : null,
                    EmployeeId = _form.EmployeeId,
                    OrderId = (Guid?)null,
                    Reason = _form.Reason
                }
                : new
                {
                    Id = _form.Id.Value,
                    Quantity = _form.Quantity,
                    Date = _form.Date,
                    Price = _form.Price,
                    Type = _form.Type,
                    ProductId = _form.ProductId,
                    CustomerId = _form.Type == StockMovementType.Out ? _form.CustomerId : null,
                    SupplierId = _form.Type == StockMovementType.In ? _form.SupplierId : null,
                    EmployeeId = _form.EmployeeId,
                    OrderId = (Guid?)null,
                    Reason = _form.Reason
                };

            HttpResponseMessage response;
            string successMessage;

            if (_form.Id is null)
            {
                response = await client.PostAsJsonAsync("stockmovement", payload, JsonOptions);
                successMessage = "Movimentação registrada.";
            }
            else
            {
                var json = JsonSerializer.Serialize(payload, JsonOptions);
                var request = new HttpRequestMessage(HttpMethod.Patch, $"stockmovement/{_form.Id.Value}")
                {
                    Content = new StringContent(json, System.Text.Encoding.UTF8, "application/json")
                };
                response = await client.SendAsync(request);
                successMessage = "Movimentação atualizada.";
            }

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(successMessage, Severity.Success);
                _modalOpen = false;
                await LoadMovementsAsync();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Erro: {(int)response.StatusCode} - {body}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
        }
        finally
        {
            _modalLoading = false;
        }
    }

    private sealed class DatasourceItem
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    private sealed class StockMovementDto
    {
        public Guid Id { get; set; }
        public Guid ProductId { get; set; }
        public string ProductName { get; set; } = string.Empty;
        public double Quantity { get; set; }
        public DateTime? Date { get; set; }
        public decimal? Price { get; set; }
        public StockMovementType Type { get; set; }
        public Guid? CustomerId { get; set; }
        public string? CustomerName { get; set; }
        public Guid? SupplierId { get; set; }
        public string? SupplierName { get; set; }
        public Guid? EmployeeId { get; set; }
        public string? EmployeeName { get; set; }
        public Guid? OrderId { get; set; }
        public string? Reason { get; set; }
    }

    private sealed class MovementFormModel
    {
        public Guid? Id { get; set; }
        public Guid ProductId { get; set; }
        public StockMovementType Type { get; set; }
        public double Quantity { get; set; }
        public decimal Price { get; set; }
        public DateTime? Date { get; set; }
        public Guid? CustomerId { get; set; }
        public Guid? SupplierId { get; set; }
        public Guid? EmployeeId { get; set; }
        public string? Reason { get; set; }
    }
}
