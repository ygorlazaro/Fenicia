@page "/basic/stockmovement"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext
@inject ISnackbar Snackbar
@using Fenicia.Web.Components.Pages.Basic.Models
@using Fenicia.Web.Components.Pages.Basic.Elementary
@using System.Text.Json
@using Fenicia.Common.Enums.Basic

<MainLayout>
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2">
        <MudPaper Class="pa-6">
            <StockMovementHeader OnNewMovement="OpenAddModal" />

            <StockMovementFilters SearchText="searchText"
                                  SearchTextChanged="OnSearchTextChanged"
                                  StartDate="startDate"
                                  StartDateChanged="OnStartDateChanged"
                                  EndDate="endDate"
                                  EndDateChanged="OnEndDateChanged"
                                  TypeFilter="typeFilter"
                                  TypeFilterChanged="OnTypeFilterChanged"
                                  Loading="loading"
                                  OnFilter="LoadMovementsAsync" />

            <StockMovementKpiCards Kpi="kpi" />

            <StockMovementTable Items="movements" Loading="loading" OnEdit="OpenEditModal" />
        </MudPaper>
    </MudContainer>
</MainLayout>

<StockMovementModal Visible="modalOpen"
                    VisibleChanged="OnModalVisibleChanged"
                    Model="form"
                    IsEdit="isEdit"
                    IsSubmitting="modalLoading"
                    Products="products"
                    Customers="customers"
                    Suppliers="suppliers"
                    Employees="employees"
                    OnClose="CloseModal"
                    OnSubmit="SubmitAsync" />

@code {
    private enum TypeFilter { All, In, Out }

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true,
        Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() }
    };

    private DateTime? startDate = DateTime.Today.AddDays(-30);
    private DateTime? endDate = DateTime.Today.AddDays(1);
    private TypeFilter typeFilter = TypeFilter.All;
    private string? searchText;

    private bool loading = true;
    private bool modalLoading;
    private bool modalOpen;
    private bool isEdit;

    private List<StockMovementDto> movements = [];
    private StockMovementKpi kpi = new();

    private List<DatasourceItem> products = [];
    private List<DatasourceItem> customers = [];
    private List<DatasourceItem> suppliers = [];
    private List<DatasourceItem> employees = [];

    private MovementFormModel form = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadOptionsAsync();
            await LoadMovementsAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadOptionsAsync()
    {
        try
        {
            var client = await BuildClientAsync();
            var productsTask = client.GetAsync("datasource/product");
            var customersTask = client.GetAsync("datasource/customer");
            var suppliersTask = client.GetAsync("datasource/supplier");
            var employeesTask = client.GetAsync("datasource/employee");
            await Task.WhenAll(productsTask, customersTask, suppliersTask, employeesTask);
            products = await ReadDatasourceAsync(productsTask);
            customers = await ReadDatasourceAsync(customersTask);
            suppliers = await ReadDatasourceAsync(suppliersTask);
            employees = await ReadDatasourceAsync(employeesTask);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar opções: {ex.Message}", Severity.Error);
        }
    }

    private static async Task<List<DatasourceItem>> ReadDatasourceAsync(Task<HttpResponseMessage> task)
    {
        var response = await task;
        if (!response.IsSuccessStatusCode) return [];
        var body = await response.Content.ReadAsStringAsync();
        return JsonSerializer.Deserialize<List<DatasourceItem>>(body, JsonOptions) ?? [];
    }

    private async Task LoadMovementsAsync()
    {
        loading = true;
        try
        {
            var client = await BuildClientAsync();
            var query = new List<string>();
            if (startDate.HasValue) query.Add($"startDate={startDate.Value:yyyy-MM-dd}");
            if (endDate.HasValue) query.Add($"endDate={endDate.Value:yyyy-MM-dd}");
            if (typeFilter != TypeFilter.All) query.Add($"type={MapType(typeFilter)}");
            query.Add("page=1");
            query.Add("perPage=200");
            if (!string.IsNullOrWhiteSpace(searchText)) query.Add($"query={Uri.EscapeDataString(searchText)}");
            var qs = query.Count == 0 ? string.Empty : "?" + string.Join("&", query);
            var response = await client.GetAsync($"stockmovement{qs}");
            if (response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                movements = JsonSerializer.Deserialize<List<StockMovementDto>>(body, JsonOptions) ?? [];
                ComputeKpi();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Falha ao carregar: {(int)response.StatusCode} - {error}", Severity.Error);
                movements = [];
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar movimentações: {ex.Message}", Severity.Error);
            movements = [];
        }
        finally
        {
            loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<HttpClient> BuildClientAsync()
    {
        var client = HttpClientFactory.CreateClient("FeniciaBasic");
        var token = await CompanyContext.GetTokenAsync();
        if (!string.IsNullOrEmpty(token))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }
        var companyId = await CompanyContext.GetSelectedCompanyIdAsync();
        if (companyId.HasValue)
        {
            client.DefaultRequestHeaders.Remove("CompanyId");
            client.DefaultRequestHeaders.Add("CompanyId", companyId.Value.ToString());
        }
        return client;
    }

    private static StockMovementType MapType(TypeFilter filter) => filter switch
    {
        TypeFilter.In => StockMovementType.In,
        TypeFilter.Out => StockMovementType.Out,
        _ => StockMovementType.None
    };

    private void ComputeKpi()
    {
        kpi = new StockMovementKpi();
        foreach (var m in movements)
        {
            if (m.Type == StockMovementType.In)
            {
                kpi.TotalInQuantity += m.Quantity;
                kpi.TotalInEvents++;
                kpi.TotalInValue += (m.Price ?? 0) * (decimal)m.Quantity;
            }
            else if (m.Type == StockMovementType.Out)
            {
                kpi.TotalOutQuantity += m.Quantity;
                kpi.TotalOutEvents++;
                kpi.TotalOutValue += (m.Price ?? 0) * (decimal)m.Quantity;
            }
        }
    }

    private void OpenAddModal()
    {
        if (products.Count == 0)
        {
            Snackbar.Add("Nenhum produto disponível para movimentação.", Severity.Warning);
            return;
        }
        isEdit = false;
        form = new MovementFormModel { Date = DateTime.Now, Type = StockMovementType.In };
        modalOpen = true;
    }

    private void OpenEditModal(StockMovementDto item)
    {
        isEdit = true;
        form = new MovementFormModel
        {
            Id = item.Id,
            ProductId = item.ProductId,
            Type = item.Type,
            Quantity = item.Quantity,
            Price = item.Price ?? 0,
            Date = item.Date ?? DateTime.Now,
            CustomerId = item.CustomerId,
            SupplierId = item.SupplierId,
            EmployeeId = item.EmployeeId,
            Reason = item.Reason
        };
        modalOpen = true;
    }

    private void CloseModal() => modalOpen = false;

    private async Task SubmitAsync()
    {
        if (modalLoading || form.ProductId == Guid.Empty || form.Quantity <= 0)
        {
            Snackbar.Add("Preencha produto e quantidade.", Severity.Warning);
            return;
        }
        modalLoading = true;
        try
        {
            var client = await BuildClientAsync();
            object payload = form.Id is null
                ? new
                {
                    Id = Guid.NewGuid(),
                    Quantity = form.Quantity,
                    Date = form.Date,
                    Price = (decimal?)form.Price,
                    Type = form.Type,
                    ProductId = form.ProductId,
                    CustomerId = form.Type == StockMovementType.Out ? form.CustomerId : null,
                    SupplierId = form.Type == StockMovementType.In ? form.SupplierId : null,
                    EmployeeId = form.EmployeeId,
                    OrderId = (Guid?)null,
                    Reason = form.Reason
                }
                : new
                {
                    Id = form.Id.Value,
                    Quantity = form.Quantity,
                    Date = form.Date,
                    Price = form.Price,
                    Type = form.Type,
                    ProductId = form.ProductId,
                    CustomerId = form.Type == StockMovementType.Out ? form.CustomerId : null,
                    SupplierId = form.Type == StockMovementType.In ? form.SupplierId : null,
                    EmployeeId = form.EmployeeId,
                    OrderId = (Guid?)null,
                    Reason = form.Reason
                };
            HttpResponseMessage response;
            string successMessage;
            if (form.Id is null)
            {
                response = await client.PostAsJsonAsync("stockmovement", payload, JsonOptions);
                successMessage = "Movimentação registrada.";
            }
            else
            {
                var json = JsonSerializer.Serialize(payload, JsonOptions);
                var request = new HttpRequestMessage(HttpMethod.Patch, $"stockmovement/{form.Id.Value}")
                {
                    Content = new StringContent(json, System.Text.Encoding.UTF8, "application/json")
                };
                response = await client.SendAsync(request);
                successMessage = "Movimentação atualizada.";
            }
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(successMessage, Severity.Success);
                modalOpen = false;
                await LoadMovementsAsync();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Erro: {(int)response.StatusCode} - {body}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
        }
        finally
        {
            modalLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnSearchTextChanged(string? value)
    {
        searchText = value;
        _ = LoadMovementsAsync();
    }

    private void OnStartDateChanged(DateTime? value)
    {
        startDate = value;
    }

    private void OnEndDateChanged(DateTime? value)
    {
        endDate = value;
    }

    private void OnTypeFilterChanged(TypeFilter value)
    {
        typeFilter = value;
    }

    private void OnModalVisibleChanged(bool value)
    {
        modalOpen = value;
    }
}

<style>
    .kpi-card {
        height: 100%;
        border-left: 4px solid transparent;
    }

    .kpi-success {
        border-left-color: var(--mud-palette-success);
    }

    .kpi-error {
        border-left-color: var(--mud-palette-error);
    }

    .kpi-info {
        border-left-color: var(--mud-palette-info);
    }
</style>
