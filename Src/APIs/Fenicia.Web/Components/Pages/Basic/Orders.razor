@page "/basic/order"
@rendermode InteractiveServer
@using Fenicia.Web.Components.Shared
@using Fenicia.Web.Components.Pages.Basic.Elementary

<CrudPage TItem="GetAllOrderResponse"
          PageTitle="Pedidos"
          PageSubtitle="Gerencie os pedidos da sua empresa"
          EntityNamePlural="pedidos"
          EntityNameSingular="pedido"
          Endpoint="order"
          ColumnCount="6"
          AddButtonLabel="Novo Pedido"
          AddButtonHref="/basic/order/new"
          FormatForDelete="FormatForDelete">
    <HeaderContent>
        <OrderHeader />
    </HeaderContent>
    <RowTemplate>
        <OrderRow Item="context.Item" />
    </RowTemplate>
    <AddModalBody>
        <MudText Typo="Typo.body2">Use o botão "Novo Pedido" para criar um novo pedido.</MudText>
    </AddModalBody>
    <EditModalBody>
        <MudText Typo="Typo.body2">Edição de pedidos não está disponível.</MudText>
    </EditModalBody>
</CrudPage>

@code {
    private static string FormatForDelete(GetAllOrderResponse item) => item.OrderNumber;
}
