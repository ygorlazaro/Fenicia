@page "/socialnetwork/feed"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IAuthStateService AuthState
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext
@inject ISnackbar Snackbar

<PageTitle>Feed - Fenicia Social</PageTitle>

<MainLayout>
    <MudGrid>
        <MudItem xs="12" md="8" Class="mx-auto">
            <MudPaper Elevation="2" Class="pa-4 mb-4">
                <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                    <MudAvatar Color="Color.Primary" Size="Size.Medium">@GetUserInitial()</MudAvatar>
                    <div class="flex-grow-1">
                        <MudTextField @bind-Value="newPostText"
                                      Placeholder="O que está acontecendo?"
                                      Variant="Variant.Outlined"
                                      Lines="3"
                                      MaxLength="512"
                                      Counter="512"
                                      Immediate="true"
                                      FullWidth="true" />
                    </div>
                </MudStack>
                <MudStack Row="true" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Class="mt-3">
                    <MudText Typo="Typo.caption" Color="@(remainingChars < 0 ? Color.Error : Color.Default)">
                        @remainingChars
                    </MudText>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Send"
                               OnClick="PostAsync"
                               Disabled="@(string.IsNullOrWhiteSpace(newPostText) || newPostText.Length > 512 || isPosting)">
                        @if (isPosting)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Default" Class="mr-2" />
                        }
                        Postar
                    </MudButton>
                </MudStack>
            </MudPaper>

            <MudPaper Elevation="0" Class="pa-0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="px-4 py-2">
                    <MudText Typo="Typo.h6">Feed</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="LoadFeedAsync" />
                </MudStack>
                <MudDivider />

                @if (isLoading && posts.Count == 0)
                {
                    <div class="d-flex justify-content-center pa-8">
                        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                    </div>
                }
                else if (!string.IsNullOrEmpty(errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="ma-4">@errorMessage</MudAlert>
                }
                else if (posts.Count == 0)
                {
                    <div class="pa-8 text-center">
                        <MudIcon Icon="@Icons.Material.Filled.Forum" Size="Size.Large" Color="Color.Default" />
                        <MudText Typo="Typo.h6" Class="mt-2">Nenhuma postagem ainda</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Default">Seja o primeiro a postar algo!</MudText>
                    </div>
                }
                else
                {
                    @foreach (var post in posts)
                    {
                        <MudPaper Elevation="0" Class="pa-4 post-card">
                            <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                                <MudAvatar Color="Color.Primary" Size="Size.Medium" Style="cursor:pointer" @onclick="@(() => NavigateToProfile(post.ProfileId))">
                                    @GetPostInitial(post)
                                </MudAvatar>
                                <div class="flex-grow-1">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                                                <MudLink Href="@($"/socialnetwork/profile/{post.ProfileId}")" Color="Color.Default" Underline="Underline.None">
                                                    <MudText Typo="Typo.subtitle2"><b>@GetPostDisplayName(post)</b></MudText>
                                                </MudLink>
                                                @if (!string.IsNullOrEmpty(post.AuthorUserName))
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Default">@@@post.AuthorUserName</MudText>
                                                }
                                                <MudText Typo="Typo.caption" Color="Color.Default">· @FormatRelativeTime(post.Date)</MudText>
                                            </MudStack>
                                            @if (post.OriginalFeedId.HasValue)
                                            {
                                                <MudPaper Elevation="0" Class="pa-2 mb-2" Style="background-color: rgba(0,0,0,0.03); border-left: 3px solid var(--mud-palette-primary); border-radius: 8px;">
                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                                                        <MudIcon Icon="@Icons.Material.Outlined.Repeat" Size="Size.Small" Color="Color.Default" />
                                                        <MudText Typo="Typo.caption" Color="Color.Default">compartilhou um post</MudText>
                                                    </MudStack>
                                                    <MudLink Href="@($"/socialnetwork/feed/{post.OriginalFeedId}")" Color="Color.Default" Underline="Underline.None">
                                                        <MudText Typo="Typo.body2" Style="white-space: pre-wrap; word-wrap: break-word;">Ver post original →</MudText>
                                                    </MudLink>
                                                </MudPaper>
                                            }
                                    <MudLink Href="@($"/socialnetwork/feed/{post.Id}")" Color="Color.Default" Underline="Underline.None">
                                        <MudText Typo="Typo.body1" Class="mb-3" Style="white-space: pre-wrap; word-wrap: break-word;">@post.Text</MudText>
                                    </MudLink>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                                        <MudButton Size="Size.Small"
                                                                   Variant="Variant.Text"
                                                                   Color="Color.Default"
                                                                   StartIcon="@Icons.Material.Outlined.ChatBubbleOutline"
                                                                   OnClick="@(() => NavigateToFeedDetail(post.Id))">
                                                            @post.TotalComments
                                                        </MudButton>
                                                        <MudButton Size="Size.Small"
                                                                   Variant="Variant.Text"
                                                                   Color="@(post.IsLikedByMe ? Color.Error : Color.Default)"
                                                                   StartIcon="@(post.IsLikedByMe ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.FavoriteBorder)"
                                                                   OnClick="@(() => ToggleLikeAsync(post))"
                                                                   Disabled="@(likingFeedId == post.Id)">
                                                            @post.TotalLikes
                                                        </MudButton>
                                                        <MudButton Size="Size.Small"
                                                                   Variant="Variant.Text"
                                                                   Color="Color.Default"
                                                                   StartIcon="@Icons.Material.Outlined.Repeat"
                                                                   OnClick="@(() => OpenShareDialog(post))">
                                                            @post.TotalShares
                                                        </MudButton>
                                    </MudStack>
                                </div>
                            </MudStack>
                        </MudPaper>
                        <MudDivider />
                    }

                    @if (hasMore)
                    {
                        <div class="d-flex justify-content-center pa-4">
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Primary"
                                       OnClick="LoadMoreAsync"
                                       Disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Default" Class="mr-2" />
                                }
                                Carregar mais
                            </MudButton>
                        </div>
                    }
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MainLayout>

@code {
    private List<PostDto> posts = [];
    private string newPostText = string.Empty;
    private bool isLoading = false;
    private bool isPosting = false;
    private string? errorMessage;
    private int currentPage = 1;
    private const int PageSize = 20;
    private bool hasMore = true;
    private Guid? likingFeedId;
    private string currentUserName = string.Empty;
    private Guid currentUserId;
    private Guid currentProfileId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var isAuthenticated = await AuthState.IsAuthenticatedAsync();
            if (!isAuthenticated)
            {
                NavigationManager.NavigateTo("/login");
                return;
            }

            currentUserId = await CompanyContext.GetUserIdAsync();
            currentUserName = await GetCurrentUserNameAsync();
            await EnsureCurrentProfileIdAsync();
            await LoadFeedAsync();
        }
    }

    private async Task EnsureCurrentProfileIdAsync()
    {
        if (currentProfileId != Guid.Empty) return;
        var client = await CreateClientAsync();
        var response = await client.GetAsync("/profile");
        if (response.IsSuccessStatusCode)
        {
            var json = await response.Content.ReadAsStringAsync();
            var profile = System.Text.Json.JsonSerializer.Deserialize<CurrentProfileDto>(json,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (profile is not null && profile.Id != Guid.Empty)
            {
                currentProfileId = profile.Id;
            }
        }
    }

    private int remainingChars => 512 - newPostText.Length;

    private async Task<string> GetCurrentUserNameAsync()
    {
        var token = await CompanyContext.GetTokenAsync();
        if (string.IsNullOrEmpty(token)) return string.Empty;
        try
        {
            var parts = token.Split('.');
            if (parts.Length < 2) return string.Empty;
            var payload = parts[1].Replace('-', '+').Replace('_', '/');
            switch (payload.Length % 4)
            {
                case 2: payload += "=="; break;
                case 3: payload += "="; break;
            }
            using var doc = System.Text.Json.JsonDocument.Parse(System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(payload)));
            if (doc.RootElement.TryGetProperty("unique_name", out var n))
            {
                return n.GetString() ?? string.Empty;
            }
        }
        catch
        {
        }
        return string.Empty;
    }

    private async Task<HttpClient> CreateClientAsync()
    {
        var client = HttpClientFactory.CreateClient("FeniciaSocialNetwork");
        var token = await CompanyContext.GetTokenAsync();
        if (!string.IsNullOrEmpty(token))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }

        var companyId = await CompanyContext.GetSelectedCompanyIdAsync();
        if (companyId.HasValue)
        {
            client.DefaultRequestHeaders.Remove("CompanyId");
            client.DefaultRequestHeaders.Add("CompanyId", companyId.Value.ToString());
        }

        return client;
    }

    private async Task LoadFeedAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            currentPage = 1;
            hasMore = true;

            var client = await CreateClientAsync();
            var response = await client.GetAsync($"/feed?page={currentPage}&perPage={PageSize}");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var items = System.Text.Json.JsonSerializer.Deserialize<List<PostDto>>(json,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                posts = items ?? [];
                hasMore = posts.Count >= PageSize;
                await CheckLikesAsync();
            }
            else
            {
                errorMessage = $"Falha ao carregar feed: {(int)response.StatusCode} {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadMoreAsync()
    {
        try
        {
            isLoading = true;
            currentPage++;

            var client = await CreateClientAsync();
            var response = await client.GetAsync($"/feed?page={currentPage}&perPage={PageSize}");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var items = System.Text.Json.JsonSerializer.Deserialize<List<PostDto>>(json,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (items is not null && items.Count > 0)
                {
                    posts.AddRange(items);
                    hasMore = items.Count >= PageSize;
                    await CheckLikesAsync();
                }
                else
                {
                    hasMore = false;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CheckLikesAsync()
    {
        if (currentProfileId == Guid.Empty) return;
        var client = await CreateClientAsync();
        foreach (var post in posts.Where(p => !p.IsLikedByMe))
        {
            try
            {
                var response = await client.GetAsync($"/like/isfollowed/{currentProfileId}/{post.Id}");
                if (response.IsSuccessStatusCode)
                {
                    var json = await response.Content.ReadAsStringAsync();
                    if (bool.TryParse(json, out var liked))
                    {
                        post.IsLikedByMe = liked;
                    }
                }
            }
            catch
            {
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task PostAsync()
    {
        if (string.IsNullOrWhiteSpace(newPostText) || newPostText.Length > 512) return;
        if (currentProfileId == Guid.Empty)
        {
            await EnsureCurrentProfileIdAsync();
            if (currentProfileId == Guid.Empty)
            {
                Snackbar.Add("Não foi possível identificar o seu perfil social.", Severity.Error);
                return;
            }
        }
        try
        {
            isPosting = true;

            var client = await CreateClientAsync();
            var command = new
            {
                Id = Guid.NewGuid(),
                Date = DateTime.UtcNow,
                Text = newPostText,
                ProfileId = currentProfileId,
            };

            var json = System.Text.Json.JsonSerializer.Serialize(command);
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
            var response = await client.PostAsync("/feed", content);

            if (response.IsSuccessStatusCode)
            {
                newPostText = string.Empty;
                Snackbar.Add("Post publicado!", Severity.Success);
                await LoadFeedAsync();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Falha ao publicar: {(int)response.StatusCode} {body}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
        }
        finally
        {
            isPosting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleLikeAsync(PostDto post)
    {
        if (likingFeedId == post.Id) return;
        try
        {
            likingFeedId = post.Id;
            var client = await CreateClientAsync();

            if (post.IsLikedByMe)
            {
                var response = await client.DeleteAsync($"/like/{post.Id}");
                if (response.IsSuccessStatusCode)
                {
                    post.IsLikedByMe = false;
                    post.TotalLikes = Math.Max(0, post.TotalLikes - 1);
                }
            }
            else
            {
                var command = new { FeedId = post.Id };
                var json = System.Text.Json.JsonSerializer.Serialize(command);
                var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
                var response = await client.PostAsync("/like", content);
                if (response.IsSuccessStatusCode)
                {
                    post.IsLikedByMe = true;
                    post.TotalLikes++;
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao curtir: {ex.Message}", Severity.Error);
        }
        finally
        {
            likingFeedId = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool shareDialogVisible;
    private PostDto? shareTarget;
    private string shareText = string.Empty;
    private bool isSharing;

    private readonly DialogOptions shareDialogOptions = new()
    {
        CloseOnEscapeKey = true,
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
    };

    private void OpenShareDialog(PostDto post)
    {
        shareTarget = post;
        shareText = string.Empty;
        shareDialogVisible = true;
    }

    private void CloseShareDialog()
    {
        shareDialogVisible = false;
        shareTarget = null;
        shareText = string.Empty;
    }

    private async Task ConfirmShareAsync()
    {
        if (shareTarget is null) return;
        try
        {
            isSharing = true;
            var client = await CreateClientAsync();
            var command = new
            {
                Id = Guid.NewGuid(),
                OriginalFeedId = shareTarget.Id,
                Text = string.IsNullOrWhiteSpace(shareText) ? null : shareText,
            };
            var json = System.Text.Json.JsonSerializer.Serialize(command);
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
            var response = await client.PostAsync("/share", content);
            if (response.IsSuccessStatusCode)
            {
                shareTarget.TotalShares++;
                Snackbar.Add("Post compartilhado!", Severity.Success);
                CloseShareDialog();
                await LoadFeedAsync();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Falha ao compartilhar: {(int)response.StatusCode} {body}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSharing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void NavigateToFeedDetail(Guid feedId)
    {
        NavigationManager.NavigateTo($"/socialnetwork/feed/{feedId}");
    }

    private void NavigateToProfile(Guid userId)
    {
        NavigationManager.NavigateTo($"/socialnetwork/profile/{userId}");
    }

    private string GetUserInitial()
    {
        if (string.IsNullOrEmpty(currentUserName)) return "?";
        return currentUserName[..1].ToUpper();
    }

    private static string GetPostDisplayName(PostDto post)
    {
        if (!string.IsNullOrEmpty(post.AuthorUserName)) return "@" + post.AuthorUserName;
        return post.DisplayName ?? "Usuário";
    }

    private static string GetPostInitial(PostDto post)
    {
        var name = post.AuthorUserName ?? post.DisplayName ?? post.Text ?? "";
        if (string.IsNullOrEmpty(name)) return "?";
        return name.TrimStart('@')[..1].ToUpper();
    }

    private static string FormatRelativeTime(DateTime date)
    {
        var diff = DateTime.UtcNow - date.ToUniversalTime();
        if (diff.TotalSeconds < 60) return "agora";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}min";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d";
        return date.ToString("dd MMM yyyy");
    }

    private class PostDto
    {
        public Guid Id { get; set; }
        public DateTime Date { get; set; }
        public string Text { get; set; } = string.Empty;
        public Guid ProfileId { get; set; }
        public Guid CompanyId { get; set; }
        public int TotalLikes { get; set; }
        public int TotalComments { get; set; }
        public int TotalShares { get; set; }
        public Guid? OriginalFeedId { get; set; }
        public string? AuthorUserName { get; set; }
        public string? DisplayName { get; set; }
        public bool IsLikedByMe { get; set; }
    }

    private class CurrentProfileDto
    {
        public Guid Id { get; set; }
        public Guid UserId { get; set; }
    }
}

<MudDialog @bind-Visible="shareDialogVisible" Options="shareDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Compartilhar post</MudText>
    </TitleContent>
    <DialogContent>
        @if (shareTarget is not null)
        {
            <MudPaper Elevation="0" Class="pa-3 mb-3" Style="background-color: rgba(0,0,0,0.03); border-radius: 8px;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                    <MudText Typo="Typo.caption"><b>@GetPostDisplayName(shareTarget)</b></MudText>
                    <MudText Typo="Typo.caption" Color="Color.Default">· @FormatRelativeTime(shareTarget.Date)</MudText>
                </MudStack>
                <MudText Typo="Typo.body2" Style="white-space: pre-wrap; word-wrap: break-word;">@shareTarget.Text</MudText>
            </MudPaper>
        }
        <MudTextField @bind-Value="shareText"
                      Label="Adicione um comentário (opcional)"
                      Variant="Variant.Outlined"
                      Lines="3"
                      MaxLength="512"
                      Counter="512"
                      Immediate="true"
                      FullWidth="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseShareDialog" Variant="Variant.Text">Cancelar</MudButton>
        <MudButton OnClick="ConfirmShareAsync" Variant="Variant.Filled" Color="Color.Primary" Disabled="@isSharing">
            @if (isSharing)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Default" Class="mr-2" />
            }
            Compartilhar
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .post-card {
        transition: background-color 0.15s ease;
    }
    .post-card:hover {
        background-color: rgba(0, 0, 0, 0.02);
    }
</style>
