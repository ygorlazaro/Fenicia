@page "/socialnetwork/profile/{Id:guid}"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IAuthStateService AuthState
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext
@inject ISnackbar Snackbar

<PageTitle>Perfil - Fenicia Social</PageTitle>

<MainLayout>
    <MudGrid>
        <MudItem xs="12">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => NavigationManager.NavigateTo("/socialnetwork/profile"))" />
                <MudText Typo="Typo.h5">Perfil</MudText>
            </MudStack>
        </MudItem>

        @if (isLoading)
        {
            <MudItem xs="12">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            </MudItem>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
            </MudItem>
        }
        else if (profile is not null)
        {
            <MudItem xs="12" md="4">
                <MudPaper Elevation="2" Class="pa-6">
                    <MudStack AlignItems="AlignItems.Center" Spacing="3">
                        <MudAvatar Size="Size.Large" Style="height:120px;width:120px;font-size:3rem;">
                            @GetInitial()
                        </MudAvatar>
                        <MudText Typo="Typo.h5" Align="Align.Center">@GetDisplayName()</MudText>
                        @if (!string.IsNullOrEmpty(profile.UserName))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Default">@@@profile.UserName</MudText>
                        }
                        @if (!string.IsNullOrEmpty(profile.Location))
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Color="Color.Default" />
                                <MudText Typo="Typo.body2" Color="Color.Default">@profile.Location</MudText>
                            </MudStack>
                        }
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Color="Color.Default" />
                            <MudText Typo="Typo.caption" Color="Color.Default">
                                Membro desde @(profile.Created.ToString("MMMM yyyy"))
                            </MudText>
                        </MudStack>
                        <MudDivider FlexItem="true" Class="my-2" Style="width:100%" />
                        <MudStack Row="true" Justify="Justify.SpaceEvenly" Style="width:100%">
                            <MudStack AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.h6">@posts.Count</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Default">Posts</MudText>
                            </MudStack>
                            <MudStack AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.h6">@followerCount</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Default">Seguidores</MudText>
                            </MudStack>
                            <MudStack AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.h6">@followingCount</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Default">Seguindo</MudText>
                            </MudStack>
                        </MudStack>
                        <MudDivider FlexItem="true" Class="my-2" Style="width:100%" />
                        @if (isOwnProfile)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Edit"
                                       OnClick="@(() => NavigationManager.NavigateTo("/socialnetwork/profile?edit=" + profile.Id))"
                                       FullWidth="true">
                                Editar Perfil
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="@(isFollowing ? Variant.Outlined : Variant.Filled)"
                                       Color="Color.Primary"
                                       StartIcon="@(isFollowing ? Icons.Material.Filled.Check : Icons.Material.Filled.PersonAdd)"
                                       OnClick="ToggleFollowAsync"
                                       Disabled="@(currentProfileId == Guid.Empty || followBusy)"
                                       FullWidth="true">
                                @(isFollowing ? "Seguindo" : "Seguir")
                            </MudButton>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="8">
                <MudPaper Elevation="2" Class="pa-6">
                    <MudTabs Elevation="0" Rounded="true" Centered="false" ApplyEffectsToContainer="true" KeepPanelsAlive="true">
                        <MudTabPanel Text="Sobre" Icon="@Icons.Material.Filled.Person">
                            <MudGrid Class="mt-3">
                                <MudItem xs="12">
                                    <MudText Typo="Typo.subtitle2" Color="Color.Default">Biografia</MudText>
                                    <MudText Typo="Typo.body1" Class="mb-3">@(string.IsNullOrEmpty(profile.Bio) ? "Sem biografia." : profile.Bio)</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.subtitle2" Color="Color.Default">Website</MudText>
                                    @if (!string.IsNullOrEmpty(profile.Website))
                                    {
                                        <MudLink Href="@profile.Website" Target="_blank" Color="Color.Primary">@profile.Website</MudLink>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Default">—</MudText>
                                    }
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.subtitle2" Color="Color.Default">Localização</MudText>
                                    <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(profile.Location) ? "—" : profile.Location)</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.subtitle2" Color="Color.Default">Data de Nascimento</MudText>
                                    <MudText Typo="Typo.body2">@(profile.BirthDate?.ToString("dd/MM/yyyy") ?? "—")</MudText>
                                </MudItem>
                            </MudGrid>
                        </MudTabPanel>
                        <MudTabPanel Text="Posts" Icon="@Icons.Material.Filled.Article">
                            @if (isLoadingPosts)
                            {
                                <div class="d-flex justify-content-center pa-8">
                                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                                </div>
                            }
                            else if (posts.Count == 0)
                            {
                                <MudAlert Severity="Severity.Info" Class="mt-3">Nenhuma postagem ainda.</MudAlert>
                            }
                            else
                            {
                                <div class="mt-3">
                                    @foreach (var post in posts)
                                    {
                                        <MudPaper Elevation="0" Class="pa-4 post-card">
                                            <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                                                <MudAvatar Color="Color.Primary" Size="Size.Medium" Style="cursor:pointer" @onclick="@(() => NavigationManager.NavigateTo("/socialnetwork/profile/" + post.ProfileId))">
                                                    @GetPostInitial()
                                                </MudAvatar>
                                                <div class="flex-grow-1">
                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                                                        <MudText Typo="Typo.subtitle2"><b>Usuário</b></MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Default">· @FormatRelativeTime(post.Date)</MudText>
                                                    </MudStack>
                                                    <MudText Typo="Typo.body1" Class="mb-3" Style="white-space: pre-wrap; word-wrap: break-word;">@post.Text</MudText>
                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                                        <MudButton Size="Size.Small"
                                                                   Variant="Variant.Text"
                                                                   Color="Color.Default"
                                                                   StartIcon="@Icons.Material.Outlined.ChatBubbleOutline"
                                                                   OnClick="@(() => NavigateToFeedDetail(post.Id))">
                                                            @post.TotalComments
                                                        </MudButton>
                                                        <MudButton Size="Size.Small"
                                                                   Variant="Variant.Text"
                                                                   Color="@(post.IsLikedByMe ? Color.Error : Color.Default)"
                                                                   StartIcon="@(post.IsLikedByMe ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.FavoriteBorder)"
                                                                   OnClick="@(() => ToggleLikeAsync(post))"
                                                                   Disabled="@(likingFeedId == post.Id || currentProfileId == Guid.Empty)">
                                                            @post.TotalLikes
                                                        </MudButton>
                                                        <MudButton Size="Size.Small"
                                                                   Variant="Variant.Text"
                                                                   Color="Color.Default"
                                                                   StartIcon="@Icons.Material.Outlined.Repeat"
                                                                   Disabled="true">
                                                            @post.TotalShares
                                                        </MudButton>
                                                    </MudStack>
                                                </div>
                                            </MudStack>
                                        </MudPaper>
                                        <MudDivider />
                                    }
                                </div>
                            }
                        </MudTabPanel>
                        <MudTabPanel Text="Mídia" Icon="@Icons.Material.Filled.Image">
                            <MudAlert Severity="Severity.Info" Class="mt-3">Nenhuma mídia ainda.</MudAlert>
                        </MudTabPanel>
                        <MudTabPanel Text="Curtidas" Icon="@Icons.Material.Filled.Favorite">
                            @if (isLoadingLiked)
                            {
                                <div class="d-flex justify-content-center pa-6">
                                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                                </div>
                            }
                            else if (likedPosts.Count == 0)
                            {
                                <MudAlert Severity="Severity.Info" Class="mt-3">Nenhuma curtida ainda.</MudAlert>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-3 mt-3">
                                    @foreach (var post in likedPosts)
                                    {
                                        <MudPaper Elevation="1" Class="pa-3 post-card" @onclick="@(() => NavigateToFeedDetail(post.Id))" Style="cursor:pointer">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                                                <MudText Typo="Typo.caption" Color="Color.Default">@FormatRelativeTime(post.Date)</MudText>
                                            </MudStack>
                                            <MudText Typo="Typo.body1" Class="mb-2" Style="white-space: pre-wrap; word-wrap: break-word;">@post.Text</MudText>
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Outlined.ChatBubbleOutline">
                                                    @post.TotalComments
                                                </MudButton>
                                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Favorite">
                                                    @post.TotalLikes
                                                </MudButton>
                                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Outlined.Repeat" Disabled="true">
                                                    @post.TotalShares
                                                </MudButton>
                                            </MudStack>
                                        </MudPaper>
                                    }
                                </div>
                            }
                        </MudTabPanel>
                    </MudTabs>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
</MainLayout>

@code {
    [Parameter] public Guid Id { get; set; }

    private bool isLoading = true;
    private bool isLoadingPosts = false;
    private bool isLoadingLiked = false;
    private string? errorMessage;
    private ProfileDto? profile;
    private bool isOwnProfile;
    private List<PostDto> posts = [];
    private List<PostDto> likedPosts = [];
    private Guid currentProfileId;
    private Guid? likingFeedId;
    private bool isFollowing;
    private bool followBusy;
    private int followerCount;
    private int followingCount;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var isAuthenticated = await AuthState.IsAuthenticatedAsync();
            if (!isAuthenticated)
            {
                NavigationManager.NavigateTo("/login");
                return;
            }

            await LoadProfileAsync();
            await LoadPostsAsync();
            await LoadLikedPostsAsync();
            await LoadFollowStateAsync();
            await LoadFollowCountsAsync();
        }
    }

    private async Task<HttpClient> CreateClientAsync()
    {
        var client = HttpClientFactory.CreateClient("FeniciaSocialNetwork");
        var token = await CompanyContext.GetTokenAsync();
        if (!string.IsNullOrEmpty(token))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }

        var companyId = await CompanyContext.GetSelectedCompanyIdAsync();
        if (companyId.HasValue)
        {
            client.DefaultRequestHeaders.Remove("CompanyId");
            client.DefaultRequestHeaders.Add("CompanyId", companyId.Value.ToString());
        }

        return client;
    }

    private async Task LoadProfileAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            var client = await CreateClientAsync();

            var currentProfileResponse = await client.GetAsync("/profile");
            if (currentProfileResponse.IsSuccessStatusCode)
            {
                var currentProfileJson = await currentProfileResponse.Content.ReadAsStringAsync();
                var currentProfile = System.Text.Json.JsonSerializer.Deserialize<ProfileDto>(currentProfileJson,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (currentProfile is not null)
                {
                    currentProfileId = currentProfile.Id;
                    isOwnProfile = currentProfile.Id == Id;
                }
            }

            var response = await client.GetAsync($"/profile/{Id}");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                profile = System.Text.Json.JsonSerializer.Deserialize<ProfileDto>(json,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                errorMessage = "Perfil não encontrado.";
            }
            else
            {
                errorMessage = $"Falha ao carregar perfil: {(int)response.StatusCode} {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadPostsAsync()
    {
        try
        {
            isLoadingPosts = true;
            var client = await CreateClientAsync();
            var response = await client.GetAsync($"/feed/profile/{Id}?page=1&perPage=20");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var items = System.Text.Json.JsonSerializer.Deserialize<List<PostDto>>(json,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                posts = items ?? [];

                if (currentProfileId != Guid.Empty)
                {
                    foreach (var post in posts)
                    {
                        try
                        {
                            var likeResponse = await client.GetAsync($"/like/isfollowed/{currentProfileId}/{post.Id}");
                            if (likeResponse.IsSuccessStatusCode)
                            {
                                var likeJson = await likeResponse.Content.ReadAsStringAsync();
                                if (bool.TryParse(likeJson, out var liked))
                                {
                                    post.IsLikedByMe = liked;
                                }
                            }
                        }
                        catch
                        {
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar posts: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoadingPosts = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleLikeAsync(PostDto post)
    {
        if (likingFeedId == post.Id || currentProfileId == Guid.Empty) return;
        try
        {
            likingFeedId = post.Id;
            var client = await CreateClientAsync();

            if (post.IsLikedByMe)
            {
                var response = await client.DeleteAsync($"/like/{post.Id}");
                if (response.IsSuccessStatusCode)
                {
                    post.IsLikedByMe = false;
                    post.TotalLikes = Math.Max(0, post.TotalLikes - 1);
                }
                else
                {
                    Snackbar.Add($"Falha ao descurtir: {(int)response.StatusCode}", Severity.Error);
                }
            }
            else
            {
                var command = new { FeedId = post.Id };
                var json = System.Text.Json.JsonSerializer.Serialize(command);
                var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
                var response = await client.PostAsync("/like", content);
                if (response.IsSuccessStatusCode)
                {
                    post.IsLikedByMe = true;
                    post.TotalLikes++;
                }
                else
                {
                    var body = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Falha ao curtir: {(int)response.StatusCode} {body}", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
        }
        finally
        {
            likingFeedId = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void NavigateToFeedDetail(Guid feedId)
    {
        NavigationManager.NavigateTo($"/socialnetwork/feed/{feedId}");
    }

    private async Task LoadLikedPostsAsync()
    {
        try
        {
            isLoadingLiked = true;
            var client = await CreateClientAsync();
            var response = await client.GetAsync($"/like/profile/{Id}?page=1&perPage=20");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var items = System.Text.Json.JsonSerializer.Deserialize<List<PostDto>>(json,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                likedPosts = items ?? [];
                foreach (var lp in likedPosts)
                {
                    lp.IsLikedByMe = true;
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar curtidas: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoadingLiked = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void FollowUser()
    {
        Snackbar.Add("Funcionalidade de seguir em breve!", Severity.Info);
    }

    private async Task LoadFollowStateAsync()
    {
        if (isOwnProfile || currentProfileId == Guid.Empty) return;
        try
        {
            var client = await CreateClientAsync();
            var response = await client.GetAsync($"/friendship/isfollowing/{currentProfileId}/{Id}");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                if (bool.TryParse(json, out var following))
                {
                    isFollowing = following;
                }
            }
        }
        catch
        {
        }
    }

    private async Task LoadFollowCountsAsync()
    {
        try
        {
            var client = await CreateClientAsync();
            var followersTask = client.GetAsync($"/friendship/followers/{Id}?page=1&perPage=1");
            var followingTask = client.GetAsync($"/friendship/following/{Id}?page=1&perPage=1");
            await Task.WhenAll(followersTask, followingTask);
            var followersResp = await followersTask;
            var followingResp = await followingTask;
            followerCount = ExtractTotal(followersResp);
            followingCount = ExtractTotal(followingResp);
        }
        catch
        {
        }
    }

    private static int ExtractTotal(HttpResponseMessage response)
    {
        if (!response.IsSuccessStatusCode) return 0;
        var json = response.Content.ReadAsStringAsync().Result;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.TryGetProperty("total", out var total))
            {
                return total.GetInt32();
            }
        }
        catch
        {
        }
        return 0;
    }

    private async Task ToggleFollowAsync()
    {
        if (isOwnProfile || currentProfileId == Guid.Empty || followBusy) return;
        try
        {
            followBusy = true;
            var client = await CreateClientAsync();
            if (isFollowing)
            {
                var response = await client.DeleteAsync($"/friendship/unfollow/{Id}");
                if (response.IsSuccessStatusCode)
                {
                    isFollowing = false;
                    followerCount = Math.Max(0, followerCount - 1);
                    Snackbar.Add("Deixou de seguir.", Severity.Success);
                }
                else
                {
                    var body = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Falha: {(int)response.StatusCode} {body}", Severity.Error);
                }
            }
            else
            {
                var command = new { TargetProfileId = Id };
                var json = System.Text.Json.JsonSerializer.Serialize(command);
                var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
                var response = await client.PostAsync("/friendship/follow", content);
                if (response.IsSuccessStatusCode)
                {
                    isFollowing = true;
                    followerCount++;
                    Snackbar.Add("Seguindo!", Severity.Success);
                }
                else
                {
                    var body = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Falha: {(int)response.StatusCode} {body}", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
        }
        finally
        {
            followBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string GetInitial()
    {
        if (profile is null) return "?";
        var source = profile.UserName ?? profile.Bio ?? "";
        if (string.IsNullOrEmpty(source)) return "?";
        return source.TrimStart('@')[..1].ToUpper();
    }

    private string GetDisplayName()
    {
        if (profile is null) return "Usuário";
        if (!string.IsNullOrEmpty(profile.UserName)) return "@" + profile.UserName;
        return "Usuário";
    }

    private string GetPostInitial() => "?";

    private static string FormatRelativeTime(DateTime date)
    {
        var diff = DateTime.UtcNow - date.ToUniversalTime();
        if (diff.TotalSeconds < 60) return "agora";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}min";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d";
        return date.ToString("dd MMM yyyy");
    }

    private class ProfileDto
    {
        public Guid Id { get; set; }
        public Guid UserId { get; set; }
        public string? UserName { get; set; }
        public string? Bio { get; set; }
        public string? ImageUrl { get; set; }
        public string? Website { get; set; }
        public string? Location { get; set; }
        public string? Phone { get; set; }
        public DateTime? BirthDate { get; set; }
        public DateTime Created { get; set; }
        public DateTime? Updated { get; set; }
    }

    private class PostDto
    {
        public Guid Id { get; set; }
        public DateTime Date { get; set; }
        public string Text { get; set; } = string.Empty;
        public Guid ProfileId { get; set; }
        public Guid CompanyId { get; set; }
        public int TotalLikes { get; set; }
        public int TotalComments { get; set; }
        public int TotalShares { get; set; }
        public bool IsLikedByMe { get; set; }
    }
}

<style>
    .post-card {
        transition: background-color 0.15s ease;
    }
    .post-card:hover {
        background-color: rgba(0, 0, 0, 0.02);
    }
</style>
