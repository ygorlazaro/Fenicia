@page "/resetpassword"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>Redefinir senha - Fenicia</PageTitle>

<div class="auth-page">
    <MudPaper Class="auth-card" Elevation="0">
        <div class="d-flex flex-column align-center">
            <img src="/images/logo.svg" alt="Fenicia" class="auth-logo" />
        </div>
        <MudText Typo="Typo.h4" Align="Align.Center" Class="auth-title">Redefinir senha</MudText>
        <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="auth-subtitle">Informe o código recebido por e-mail e sua nova senha</MudText>

        <EditForm Model="model" OnSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <MudTextField @bind-Value="model.Email" Label="Email" Variant="Variant.Outlined" Class="mb-4" Required="true" RequiredError="Email é obrigatório!" InputType="InputType.Email" autocomplete="username" Immediate="true" />
            <MudTextField @bind-Value="model.Code" Label="Código de recuperação" Variant="Variant.Outlined" Class="mb-4" Required="true" RequiredError="Código é obrigatório!" autocomplete="off" Immediate="true" />
            <MudTextField @bind-Value="model.Password" Label="Nova senha" Variant="Variant.Outlined" Class="mb-4" Required="true" RequiredError="Senha é obrigatória!" InputType="InputType.Password" autocomplete="new-password" Immediate="true" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Disabled="@isLoading" Type="Submit" Class="mt-2">
                @if (isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Inherit" Class="mr-2" />
                    <span>Redefinindo...</span>
                }
                else
                {
                    <span>Redefinir senha</span>
                }
            </MudButton>
        </EditForm>

        @if (!string.IsNullOrEmpty(message))
        {
            <MudAlert Severity="@(isSuccess ? Severity.Success : Severity.Error)" Class="mt-4" Dense="true" Variant="Variant.Filled">@message</MudAlert>
        }

        <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-6">
            Lembrou a senha? <MudLink Href="/login" Color="Color.Primary" Underline="Underline.Always">Entrar</MudLink>
        </MudText>
    </MudPaper>
</div>

@code {
    private ResetPasswordModel model = new();
    private string? message;
    private bool isSuccess;
    private bool isLoading;

    private async Task HandleSubmit(EditContext editContext)
    {
        if (isLoading || !editContext.Validate())
        {
            return;
        }

        message = null;
        isLoading = true;
        StateHasChanged();

        try
        {
            var client = HttpClientFactory.CreateClient("FeniciaAuth");
            var request = new
            {
                email = model.Email,
                password = model.Password,
                code = model.Code
            };

            var response = await client.PatchAsJsonAsync("/forgotpassword", request);
            var body = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                isSuccess = true;
                message = "Senha redefinida com sucesso! Você já pode fazer login.";
                Snackbar.Add("Senha redefinida com sucesso!", Severity.Success);
            }
            else
            {
                isSuccess = false;
                message = $"Falha ao redefinir senha ({(int)response.StatusCode}): {body}";
                Snackbar.Add($"Falha ao redefinir senha ({(int)response.StatusCode})", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            message = $"Erro: {ex.Message}";
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private class ResetPasswordModel
    {
        [Required]
        [EmailAddress]
        [MaxLength(200)]
        public string Email { get; set; } = string.Empty;

        [Required]
        [MaxLength(200)]
        public string Code { get; set; } = string.Empty;

        [Required]
        [MaxLength(200)]
        public string Password { get; set; } = string.Empty;
    }
}
