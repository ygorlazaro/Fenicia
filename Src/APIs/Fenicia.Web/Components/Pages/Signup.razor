@page "/signup"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager

<PageTitle>Criar conta - Fenicia</PageTitle>

<nav class="navbar is-link" role="navigation" aria-label="main navigation">
    <div class="container">
        <div class="navbar-brand">
            <a class="navbar-item" href="/">
                <div class="logo-placeholder">
                    <span class="logo-text">FENICIA</span>
                </div>
            </a>
        </div>
    </div>
</nav>

<section class="hero is-link is-small">
    <div class="hero-body">
        <div class="container has-text-centered">
            <h1 class="title is-3 has-text-white">Criar minha conta</h1>
            <p class="subtitle is-6 has-text-white-ter">Monte o sistema que sua empresa merece</p>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="columns is-centered">
            <div class="column is-half">
                <div class="card">
                    <div class="card-content">
                        <h3 class="title is-4 has-text-centered">Cadastro</h3>

                        <EditForm Model="@model" OnValidSubmit="HandleSubmit" FormName="signup-form">
                            <DataAnnotationsValidator />

                            <div class="field">
                                <label class="label">Nome completo</label>
                                <div class="control has-icons-left">
                                    <input class="input" @bind="model.Name" placeholder="João Silva" />
                                    <span class="icon is-small is-left"><i class="fas fa-user"></i></span>
                                </div>
                                <ValidationMessage For="@(() => model.Name)" />
                            </div>

                            <div class="field">
                                <label class="label">Email</label>
                                <div class="control has-icons-left">
                                    <input class="input" @bind="model.Email" placeholder="seu@email.com" type="email" />
                                    <span class="icon is-small is-left"><i class="fas fa-envelope"></i></span>
                                </div>
                                <ValidationMessage For="@(() => model.Email)" />
                            </div>

                            <div class="field">
                                <label class="label">Senha</label>
                                <div class="control has-icons-left">
                                    <input class="input" @bind="model.Password" placeholder="••••••••" type="password" />
                                    <span class="icon is-small is-left"><i class="fas fa-lock"></i></span>
                                </div>
                                <ValidationMessage For="@(() => model.Password)" />
                            </div>

                            <hr />

                            <div class="field">
                                <label class="label">Nome da empresa</label>
                                <div class="control has-icons-left">
                                    <input class="input" @bind="model.CompanyName" placeholder="Minha Empresa Ltda" />
                                    <span class="icon is-small is-left"><i class="fas fa-building"></i></span>
                                </div>
                                <ValidationMessage For="@(() => model.CompanyName)" />
                            </div>

                            <div class="field">
                                <label class="label">CNPJ</label>
                                <div class="control has-icons-left">
                                    <input class="input" @bind="model.Cnpj" placeholder="00.000.000/0000-00" />
                                    <span class="icon is-small is-left"><i class="fas fa-id-card"></i></span>
                                </div>
                                <ValidationMessage For="@(() => model.Cnpj)" />
                            </div>

                            <div class="field mt-5">
                                <div class="control">
                                    <button type="submit" class="button is-link is-fullwidth" disabled="@isLoading">
                                        @if (isLoading)
                                        {
                                            <text>Criando conta...</text>
                                        }
                                        else
                                        {
                                            <text>Criar minha conta</text>
                                        }
                                    </button>
                                </div>
                            </div>
                        </EditForm>

                        @if (!string.IsNullOrEmpty(message))
                        {
                            <div class="notification mt-4 @(isSuccess ? "is-success" : "is-danger")">
                                @message
                            </div>
                        }

                        <p class="has-text-centered mt-5">
                            Já tem conta? <a href="/login" class="has-text-link"><strong>Entrar</strong></a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<footer class="footer">
    <div class="content has-text-centered">
        <p><strong>Fenicia</strong> &copy; @DateTime.Now.Year — O Sistema Modular Open Source para sua Empresa.</p>
    </div>
</footer>

<style>
    .logo-placeholder {
        width: 48px;
        height: 48px;
        border: 2px solid #ffffff;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(4px);
    }

    .logo-text {
        color: #ffffff;
        font-weight: 900;
        font-size: 0.7rem;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        line-height: 1.1;
        text-align: center;
    }
</style>

@code {
    private SignupModel model = new();
    private string? message;
    private bool isSuccess;
    private bool isLoading;

    private async Task HandleSubmit()
    {
        message = null;
        isLoading = true;
        StateHasChanged();

        try
        {
            var client = HttpClientFactory.CreateClient("FeniciaAuth");
            var request = new
            {
                email = model.Email,
                password = model.Password,
                name = model.Name,
                company = new { cnpj = model.Cnpj, name = model.CompanyName }
            };

            var response = await client.PostAsJsonAsync("/register", request);
            var body = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                isSuccess = true;
                message = "Account created successfully! You can now log in.";
                model = new SignupModel();
            }
            else
            {
                isSuccess = false;
                message = $"Registration failed ({(int)response.StatusCode}): {body}";
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            message = $"Erro: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private class SignupModel
    {
        [Required]
        [MaxLength(48)]
        public string Name { get; set; } = string.Empty;

        [Required]
        [EmailAddress]
        [MaxLength(48)]
        public string Email { get; set; } = string.Empty;

        [Required]
        [MaxLength(200)]
        public string Password { get; set; } = string.Empty;

        [Required]
        [MaxLength(200)]
        public string CompanyName { get; set; } = string.Empty;

        [Required]
        [MaxLength(200)]
        public string Cnpj { get; set; } = string.Empty;
    }
}