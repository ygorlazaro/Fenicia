@page "/signup"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager

<PageTitle>Sign Up - Fenicia</PageTitle>

<div style="max-width: 500px; margin: 50px auto; padding: 0 20px;">
    <div style="padding: 20px; border: 1px solid #e0e0e0; border-radius: 4px; background: white;">
        <h3 style="margin-top: 0;">Create Account</h3>

        <EditForm Model="@model" OnValidSubmit="HandleSubmit" FormName="signup-form">
            <DataAnnotationsValidator />

            <div style="margin-bottom: 15px;">
                <input class="form-control" @bind="model.Name" placeholder="Full Name" />
                <ValidationMessage For="@(() => model.Name)" />
            </div>

            <div style="margin-bottom: 15px;">
                <input class="form-control" @bind="model.Email" placeholder="Email" type="email" />
                <ValidationMessage For="@(() => model.Email)" />
            </div>

            <div style="margin-bottom: 15px;">
                <input class="form-control" @bind="model.Password" placeholder="Password" type="password" />
                <ValidationMessage For="@(() => model.Password)" />
            </div>

            <div style="margin-bottom: 15px;">
                <input class="form-control" @bind="model.CompanyName" placeholder="Company Name" />
                <ValidationMessage For="@(() => model.CompanyName)" />
            </div>

            <div style="margin-bottom: 20px;">
                <input class="form-control" @bind="model.Cnpj" placeholder="CNPJ" />
                <ValidationMessage For="@(() => model.Cnpj)" />
            </div>

            <button type="submit" class="btn btn-primary" style="width:100%;" disabled="@isLoading">
                @if (isLoading)
                {
                    <text>Submitting...</text>
                }
                else
                {
                    <text>Sign Up</text>
                }
            </button>
        </EditForm>

        @if (!string.IsNullOrEmpty(message))
        {
            <div style="margin-top: 15px; padding: 10px; border-radius: 4px; background-color: @(isSuccess ? "#d4edda" : "#f8d7da"); color: @(isSuccess ? "#155724" : "#721c24");">
                @message
            </div>
        }
    </div>
</div>

@code {
    private SignupModel model = new();
    private string? message;
    private bool isSuccess;
    private bool isLoading;

    private async Task HandleSubmit()
    {
        message = null;
        isLoading = true;
        StateHasChanged();

        try
        {
            var client = HttpClientFactory.CreateClient("FeniciaAuth");
            var request = new
            {
                email = model.Email,
                password = model.Password,
                name = model.Name,
                company = new { cnpj = model.Cnpj, name = model.CompanyName }
            };

            var response = await client.PostAsJsonAsync("/register", request);
            var body = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                isSuccess = true;
                message = "Account created successfully! You can now log in.";
                model = new SignupModel();
            }
            else
            {
                isSuccess = false;
                message = $"Registration failed ({(int)response.StatusCode}): {body}";
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            message = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private class SignupModel
    {
        [Required]
        [MaxLength(48)]
        public string Name { get; set; } = string.Empty;

        [Required]
        [EmailAddress]
        [MaxLength(48)]
        public string Email { get; set; } = string.Empty;

        [Required]
        [MaxLength(200)]
        public string Password { get; set; } = string.Empty;

        [Required]
        [MaxLength(200)]
        public string CompanyName { get; set; } = string.Empty;

        [Required]
        [MaxLength(200)]
        public string Cnpj { get; set; } = string.Empty;
    }
}
