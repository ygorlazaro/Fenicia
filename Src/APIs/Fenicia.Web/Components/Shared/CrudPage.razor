@typeparam TItem where TItem : ICrudItem
@inject ICrudClient CrudClient
@inject IAuthStateService AuthState
@inject ISnackbar Snackbar
@inject ICompanyContextService CompanyContext
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory

@using System.Threading
@using System.Web
@using Fenicia.Web.Services

<PageTitle>@PageTitle - Fenicia</PageTitle>

<MainLayout>
    <MudGrid>
        <MudItem xs="12">
            @if (!_isLoggedIn)
            {
                <MudAlert Severity="Severity.Error">Faça login para gerenciar @EntityNamePlural.</MudAlert>
            }
            else if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
            }
            else
            {
                <MudPaper Elevation="2" Class="pa-6">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
                        <div>
                            <MudText Typo="Typo.h5">@PageTitle</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Default">@PageSubtitle</MudText>
                        </div>
                        @if (!string.IsNullOrEmpty(AddButtonHref))
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                   Href="@AddButtonHref">
                            @AddButtonLabel
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenAddModal">
                            @AddButtonLabel
                        </MudButton>
                    }
                    </MudStack>

                    <MudTextField Value="_searchText" ValueChanged="@((string? v) => OnSearchChanged(v))" Label="Pesquisar"
                                  Placeholder="Digite para pesquisar..." Variant="Variant.Outlined" Size="Size.Small" Immediate="true"
                                  DebounceInterval="300" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Class="mb-4" />

                    <MudTable @ref="_table" T="TItem" FixedHeader="true" Height="400px" Striped="true" Hover="true"
                                 Dense="true" Loading="_isLoading" ServerData="ServerReload"
                              Sortable="true">
                        <HeaderContent>
                            @HeaderContent
                        </HeaderContent>
                        <RowTemplate>
                            @RowTemplate(new CrudRowContext<TItem>(context, this))
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new int[] { 10, 20, 50, 100 }"
                                           RowsPerPageString="Itens por página:" InfoFormat="{first_item}-{last_item} de {all_items}"
                                           AllItemsText="Todos" />
                        </PagerContent>
                    </MudTable>
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
</MainLayout>

<MudDialog @bind-Visible="_showModal" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_activeTab == 0 ? AddDialogTitle : EditDialogTitle)</MudText>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_modalError))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">@_modalError</MudAlert>
        }
        @if (_activeTab == 0)
        {
            @AddModalBody(new CrudModalContext<TItem>(CrudModalMode.Add, _editingItem, this))
        }
        else
        {
            @EditModalBody(new CrudModalContext<TItem>(CrudModalMode.Edit, _editingItem, this))
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseModal">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveFromModal" Disabled="_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Default" Class="mr-2" />
            }
            @(_activeTab == 0 ? CreateButtonLabel : UpdateButtonLabel)
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_showDeleteConfirm" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@DeleteDialogTitle</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Tem certeza que deseja excluir <strong>@FormatForDelete(_itemToDelete)</strong>?</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseDeleteModal">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmDelete" Disabled="_isDeleting">
            @if (_isDeleting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Default" Class="mr-2" />
            }
            Excluir
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public string PageTitle { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string PageSubtitle { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string EntityNamePlural { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string EntityNameSingular { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Endpoint { get; set; } = string.Empty;
    [Parameter, EditorRequired] public int ColumnCount { get; set; } = 2;

    [Parameter, EditorRequired] public RenderFragment HeaderContent { get; set; } = null!;
    [Parameter, EditorRequired] public RenderFragment<CrudRowContext<TItem>> RowTemplate { get; set; } = null!;
    [Parameter, EditorRequired] public RenderFragment<CrudModalContext<TItem>> AddModalBody { get; set; } = null!;
    [Parameter, EditorRequired] public RenderFragment<CrudModalContext<TItem>> EditModalBody { get; set; } = null!;

    [Parameter] public string AddButtonLabel { get; set; } = "Adicionar";
    [Parameter] public string? AddButtonHref { get; set; }
    [Parameter] public string AddTabText { get; set; } = "Novo";
    [Parameter] public string EditTabText { get; set; } = "Editar";
    [Parameter] public string AddDialogTitle { get; set; } = "Adicionar";
    [Parameter] public string EditDialogTitle { get; set; } = "Editar";
    [Parameter] public string DeleteDialogTitle { get; set; } = "Excluir";
    [Parameter] public string CreateButtonLabel { get; set; } = "Criar";
    [Parameter] public string UpdateButtonLabel { get; set; } = "Atualizar";
    [Parameter] public Func<TItem?, string> FormatForDelete { get; set; } = item => item?.ToString() ?? string.Empty;
    [Parameter] public Func<CrudModalContext<TItem>, object>? CreatePayloadFactory { get; set; }
    [Parameter] public Action? OnAdd { get; set; }
    [Parameter] public Action<TItem>? OnEdit { get; set; }

    private bool _isLoggedIn;
    private bool _isLoading;
    private bool _isSaving;
    private bool _isDeleting;
    private string? _errorMessage;
    private string? _modalError;
    private bool _showModal;
    private int _activeTab;
    private TItem? _editingItem;
    public TItem? EditingItem => _editingItem;
    private bool _showDeleteConfirm;
    private TItem? _itemToDelete;
    private bool _autoOpenEditHandled;
    private string? _searchText;

    private MudTable<TItem> _table = default!;
    private string? _querySort;
    private bool _isApplyingQueryParams;
    private bool _urlSyncInitialized;
    private Dictionary<string, string> _filters = new();

    private DialogOptions _dialogOptions = new() { FullWidth = true, MaxWidth = MaxWidth.Small };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoggedIn = await AuthState.IsAuthenticatedAsync();
        }
        catch
        {
            _isLoggedIn = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_autoOpenEditHandled)
        {
            return;
        }

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var editIdRaw = query["edit"];
        if (!string.IsNullOrEmpty(editIdRaw) && Guid.TryParse(editIdRaw, out var editId))
        {
            _autoOpenEditHandled = true;
            await TryAutoOpenEditAsync(editId);
        }

        if (_isApplyingQueryParams)
        {
            return;
        }

        if (_urlSyncInitialized)
        {
            return;
        }

        _urlSyncInitialized = true;

        var search = query["query"];
        var sort = query["sort"];

        var parsedFilters = new Dictionary<string, string>();
        const string prefix = "filters[";
        foreach (var key in query.AllKeys)
        {
            if (string.IsNullOrEmpty(key) || !key.StartsWith(prefix, StringComparison.Ordinal))
            {
                continue;
            }

            var closeIdx = key.LastIndexOf(']');
            if (closeIdx <= prefix.Length)
            {
                continue;
            }

            var filterKey = key.Substring(prefix.Length, closeIdx - prefix.Length);
            var filterValue = query[key];
            if (!string.IsNullOrEmpty(filterValue))
            {
                parsedFilters[filterKey] = filterValue;
            }
        }

        var needsReload = !string.Equals(sort, _querySort, StringComparison.Ordinal)
            || search != _searchText
            || !DictionaryEqual(_filters, parsedFilters);

        if (needsReload)
        {
            _querySort = sort;
            _searchText = search;
            _filters = parsedFilters;
            if (_table is not null)
            {
                await _table.ReloadServerData();
            }
        }
    }

    private static bool DictionaryEqual(Dictionary<string, string> a, Dictionary<string, string> b)
    {
        if (a.Count != b.Count)
        {
            return false;
        }

        foreach (var kvp in a)
        {
            if (!b.TryGetValue(kvp.Key, out var value) || value != kvp.Value)
            {
                return false;
            }
        }

        return true;
    }

    private async Task TryAutoOpenEditAsync(Guid id)
    {
        try
        {
            var client = await CreateClientForLookupAsync();
            var response = await client.GetAsync($"{Endpoint}/{id}");
            if (response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                var item = System.Text.Json.JsonSerializer.Deserialize<TItem>(body, new System.Text.Json.JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });

                if (item is not null)
                {
                    OpenEditModal(item);
                    return;
                }
            }

            _errorMessage = $"Item {id} não encontrado.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erro ao carregar item: {ex.Message}";
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<HttpClient> CreateClientForLookupAsync()
    {
        var client = HttpClientFactory.CreateClient("FeniciaBasic");
        var token = await CompanyContext.GetTokenAsync();
        if (!string.IsNullOrEmpty(token))
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }

        var companyId = await CompanyContext.GetSelectedCompanyIdAsync();
        if (companyId.HasValue)
        {
            client.DefaultRequestHeaders.Remove("CompanyId");
            client.DefaultRequestHeaders.Add("CompanyId", companyId.Value.ToString());
        }

        return client;
    }

    private async Task<TableData<TItem>> ServerReload(TableState state, CancellationToken ct)
    {
        try
        {
            _isLoading = true;
            _errorMessage = null;
            StateHasChanged();

            var tableSort = state.SortLabel;
            var tableDirection = state.SortDirection == SortDirection.Descending ? "desc" : "asc";

            if (!string.IsNullOrWhiteSpace(tableSort))
            {
                var prefix = tableDirection == "desc" ? "-" : string.Empty;
                _querySort = $"{prefix}{tableSort}";
            }
            else
            {
                _querySort = null;
            }

            await UpdateUrlAsync();

            return await CrudClient.GetPageAsync<TItem>(Endpoint, state, _searchText, _filters, ct);
        }
        catch (OperationCanceledException)
        {
            return new TableData<TItem> { TotalItems = 0, Items = new List<TItem>() };
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erro: {ex.Message}";
            return new TableData<TItem> { TotalItems = 0, Items = new List<TItem>() };
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task UpdateUrlAsync()
    {
        try
        {
            _isApplyingQueryParams = true;
            var uri = new Uri(Navigation.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

            if (!string.IsNullOrEmpty(_querySort))
            {
                query["sort"] = _querySort;
            }
            else
            {
                query.Remove("sort");
            }

            if (!string.IsNullOrEmpty(_searchText))
            {
                query["query"] = _searchText;
            }
            else
            {
                query.Remove("query");
            }

            var newQuery = query.ToString();
            if (!string.IsNullOrEmpty(newQuery))
            {
                newQuery = $"?{newQuery}";
            }

            var newQuerySb = new System.Text.StringBuilder(newQuery);
            foreach (var filter in _filters)
            {
                if (string.IsNullOrWhiteSpace(filter.Value))
                {
                    continue;
                }

                newQuerySb.Append(newQuerySb.Length > 1 ? '&' : '?');
                newQuerySb.Append($"filters[{Uri.EscapeDataString(filter.Key)}]={Uri.EscapeDataString(filter.Value)}");
            }

            var newUri = $"{uri.GetLeftPart(UriPartial.Path)}{newQuerySb}";
            if (newUri != uri.ToString())
            {
                Navigation.NavigateTo(newUri, false);
            }
        }
        catch
        {
        }
        finally
        {
            _isApplyingQueryParams = false;
        }
    }

    private void OnSearchChanged(string? value)
    {
        _searchText = value;
        _ = _table.ReloadServerData();
    }

    private void OpenAddModal()
    {
        _activeTab = 0;
        _editingItem = default;
        _modalError = null;
        OnAdd?.Invoke();
        _showModal = true;
        StateHasChanged();
    }

    public void OpenEditModal(TItem item)
    {
        _activeTab = 1;
        _editingItem = item;
        _modalError = null;
        OnEdit?.Invoke(item);
        _showModal = true;
        StateHasChanged();
    }

    private void CloseModal()
    {
        _showModal = false;
        _editingItem = default;
        StateHasChanged();
    }

    private async Task SaveFromModal()
    {
        try
        {
            _isSaving = true;
            _modalError = null;
            StateHasChanged();

            if (CreatePayloadFactory is null)
            {
                throw new InvalidOperationException("CreatePayloadFactory must be supplied to support add/edit operations.");
            }

            var ctx = new CrudModalContext<TItem>(
                _activeTab == 0 ? CrudModalMode.Add : CrudModalMode.Edit,
                _editingItem,
                this);

            var payload = CreatePayloadFactory(ctx);

            if (_activeTab == 0)
            {
                await CrudClient.PostAsync(Endpoint, payload, CancellationToken.None);
                Snackbar.Add($"{EntityNameSingular} criado(a) com sucesso!", Severity.Success);
            }
            else
            {
                if (_editingItem is null)
                {
                    throw new InvalidOperationException("No item selected for edit.");
                }

                await CrudClient.PatchAsync(Endpoint, _editingItem.Id, payload, CancellationToken.None);
                Snackbar.Add($"{EntityNameSingular} atualizado(a) com sucesso!", Severity.Success);
            }

            CloseModal();
            await _table.ReloadServerData();
        }
        catch (Exception ex)
        {
            _modalError = ex.Message;
            Snackbar.Add($"Falha ao salvar {EntityNameSingular.ToLowerInvariant()}.", Severity.Error);
        }
        finally
        {
            _isSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void RequestDelete(TItem item)
    {
        _itemToDelete = item;
        _showDeleteConfirm = true;
        StateHasChanged();
    }

    private void CloseDeleteModal()
    {
        _showDeleteConfirm = false;
        _itemToDelete = default;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (_itemToDelete is null) return;

        try
        {
            _isDeleting = true;
            StateHasChanged();

            await CrudClient.DeleteAsync(Endpoint, _itemToDelete.Id, CancellationToken.None);
            Snackbar.Add($"{EntityNameSingular} excluído(a) com sucesso!", Severity.Success);

            CloseDeleteModal();
            await _table.ReloadServerData();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            Snackbar.Add($"Falha ao excluir {EntityNameSingular.ToLowerInvariant()}.", Severity.Error);
        }
        finally
        {
            _isDeleting = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
