@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext
@inject ICompanySelectionState CompanyState
@inject ISnackbar Snackbar

<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider Position="MudBlazor.SnackbarPosition.TopRight" Timeout="5000" ShowCloseIcon="true" />

<MudLayout>
    <MudAppBar Elevation="0" Class="fenicia-appbar" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@ToggleDrawer" Class="mr-2" />
        <MudLink Href="/dashboard" Underline="Underline.None" Color="Color.Inherit" Class="d-flex align-center">
            <img src="/images/logo.svg" alt="Fenicia" class="logo-img" />
        </MudLink>
        <MudSpacer />
        <MudHidden Breakpoint="Breakpoint.MdAndDown">
            @if (isLoggedIn)
            {
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="topbar-actions">
                    <MudButton Variant="Variant.Text" Color="Color.Inherit"
                               OnClick="@OpenCompanyModal"
                               Disabled="@(companies.Count == 0)">
                        @(string.IsNullOrEmpty(selectedCompanyName) ? "Selecionar Empresa" : selectedCompanyName)
                    </MudButton>
                    <MudDivider Vertical="true" FlexItem="true" Class="topbar-divider" />
                    <MudLink Href="/profile" Underline="Underline.None" Color="Color.Inherit">
                        <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Person">
                            @userName@(!string.IsNullOrEmpty(userRole) ? $" ({userRole})" : "")
                        </MudButton>
                    </MudLink>
                    <MudDivider Vertical="true" FlexItem="true" Class="topbar-divider" />
                    <MudLink Href="/logout" Underline="Underline.None" Color="Color.Inherit">
                        <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Logout">
                            Sair
                        </MudButton>
                    </MudLink>
                </MudStack>
            }
            else
            {
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudLink Href="/signup" Underline="Underline.None" Color="Color.Inherit">
                        <MudButton Variant="Variant.Text" Color="Color.Inherit"
                                   StartIcon="@Icons.Material.Filled.PersonAdd">Criar Conta</MudButton>
                    </MudLink>
                    <MudLink Href="/login" Underline="Underline.None" Color="Color.Inherit">
                        <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Login">
                            Entrar</MudButton>
                    </MudLink>
                </MudStack>
            }
        </MudHidden>
    </MudAppBar>

    <MudDrawer @bind-Open="drawerOpen" Anchor="Anchor.Left" Variant="DrawerVariant.Temporary"
               Breakpoint="Breakpoint.Md">
        <MudNavMenu>
            @if (isLoggedIn)
            {
                <MudNavLink Href="/dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Painel</MudNavLink>
                <MudNavLink Href="/shop" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ShoppingCart">Loja</MudNavLink>
                <MudNavGroup Title="Básico" Icon="@Icons.Material.Filled.Category" Expanded="true">
                    <MudNavLink Href="/basic/productcategory" Match="NavLinkMatch.All"
                                Icon="@Icons.Material.Filled.Category">Categorias de Produtos</MudNavLink>
                    <MudNavLink Href="/basic/position" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.WorkOutline">
                        Cargos</MudNavLink>
                    <MudNavLink Href="/basic/supplier" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.LocalShipping">
                        Fornecedores</MudNavLink>
                    <MudNavLink Href="/basic/customer" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.People">
                        Clientes</MudNavLink>
                    <MudNavLink Href="/basic/employee" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Badge">
                        Funcionários</MudNavLink>
                    <MudNavLink Href="/basic/product" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Inventory">
                        Produtos</MudNavLink>
                    <MudNavLink Href="/basic/stockmovement" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.SwapVert">
                        Movimentações</MudNavLink>
                    <MudNavLink Href="/basic/inventory" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Assessment">
                        Inventário</MudNavLink>
                    <MudNavLink Href="/basic/order" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.PointOfSale">
                        Pedidos</MudNavLink>
                </MudNavGroup>
                <MudNavGroup Title="Rede Social" Icon="@Icons.Material.Filled.Share" Expanded="true">
                    <MudNavLink Href="/socialnetwork/feed" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Feed</MudNavLink>
                    <MudNavLink Href="/profile" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Person">
                        Meu Perfil</MudNavLink>
                </MudNavGroup>
                <MudNavGroup Title="Projetos" Icon="@Icons.Material.Filled.Folder" Expanded="true">
                    <MudNavLink Href="/project" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ViewModule">Quadros</MudNavLink>
                </MudNavGroup>
            }
            else
            {
                <MudNavLink Href="/signup" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.PersonAdd">Criar Conta</MudNavLink>
                <MudNavLink Href="/login" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Login">Entrar</MudNavLink>
            }
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
            @ChildContent
        </MudContainer>
    </MudMainContent>

    <MudPaper Class="pa-4 fenicia-footer" Elevation="0">
        <MudText Typo="Typo.caption" Align="Align.Right">
            <strong>Fenicia</strong> &copy; @DateTime.Now.Year — O Sistema Modular Open Source para sua Empresa.
        </MudText>
    </MudPaper>
</MudLayout>

<MudDialog @bind-Visible="showCompanyModal" Options="companyDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Selecione uma empresa</MudText>
    </TitleContent>
    <DialogContent>
        @if (companiesLoading)
        {
            <MudStack AlignItems="AlignItems.Center" Class="pa-4">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.body2" Class="mt-2">Carregando empresas...</MudText>
            </MudStack>
        }
        else if (companies.Count == 0)
        {
            <MudStack AlignItems="AlignItems.Center" Class="pa-4">
                <MudText Typo="Typo.body2" Color="Color.Error">Nenhuma empresa disponível.</MudText>
                <MudButton OnClick="RetryLoadCompanies" Variant="Variant.Text" Color="Color.Primary" Class="mt-2">
                    Tentar novamente
                </MudButton>
            </MudStack>
        }
        else
        {
            <MudStack Spacing="0">
                @foreach (var company in companies)
                {
                    var isCurrent = selectedCompanyId.HasValue && company.Id == selectedCompanyId.Value;
                    <MudButton OnClick="@(() => SelectCompanyAsync(company))"
                               Variant="Variant.Text"
                               FullWidth="true"
                               Class="pa-2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="width:100%">
                            <MudIcon Icon="@(isCurrent ? Icons.Material.Filled.Check : Icons.Material.Filled.Circle)"
                                     Color="@(isCurrent ? Color.Success : Color.Default)"
                                     Size="Size.Small" />
                            <div class="d-flex flex-column flex-grow-1" style="min-width:0">
                                <MudText Typo="Typo.body2"
                                         Style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                    <strong>@company.CompanyName</strong>
                                </MudText>
                                @if (!string.IsNullOrEmpty(company.Role))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Default"
                                             Style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                        @company.CompanyName @company.Role · @FormatCnpj(company.Cnpj)
                                    </MudText>
                                }
                            </div>
                        </MudStack>
                    </MudButton>
                }
            </MudStack>
        }
    </DialogContent>
</MudDialog>

<style>
    .logo-img {
        height: 40px;
        width: auto;
    }

    .topbar-actions {
        color: white;
    }

    .topbar-company {
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: white !important;
    }

    .topbar-company-name {
        max-width: 200px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        display: inline-block;
        vertical-align: middle;
    }

    .topbar-divider {
        height: 28px;
        margin: 0 4px;
        border-color: rgba(255, 255, 255, 0.35) !important;
        background-color: rgba(255, 255, 255, 0.35);
    }
</style>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private bool isLoggedIn;
    private string userName = string.Empty;
    private string userRole = string.Empty;
    private bool jsAvailable;
    private bool drawerOpen;
    private bool showCompanyModal;
    private bool companiesLoading;
    private bool companiesLoaded;
    private List<UserCompanyItem> companies = [];
    private Guid? selectedCompanyId;
    private string selectedCompanyName = string.Empty;

    private static readonly DialogOptions companyDialogOptions = new()
    {
        CloseButton = false,
        BackdropClick = false,
        CloseOnEscapeKey = false,
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (jsAvailable)
        {
            await RefreshAuthAsync();
            if (companiesLoaded)
            {
                return;
            }
            companiesLoaded = true;
            if (isLoggedIn)
            {
                showCompanyModal = true;
            }
            await LoadCompaniesAsync();
            return;
        }

        try
        {
            await JSRuntime.InvokeAsync<string>("storageHelper.get", "auth_token");
            jsAvailable = true;
            await RefreshAuthAsync();
            if (!companiesLoaded)
            {
                companiesLoaded = true;
                if (isLoggedIn)
                {
                    showCompanyModal = true;
                }
                await LoadCompaniesAsync();
            }
        }
        catch (Exception ex)
        {
            var message = ex.InnerException?.Message ?? ex.Message;
            if (message.Contains("statically rendered"))
            {
                return;
            }
            Console.WriteLine($"[MainLayout] OnAfterRenderAsync error: {ex.GetType().Name}: {message}");
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (jsAvailable)
        {
            _ = RefreshAuthAsync();
        }
    }

    private void ToggleDrawer()
    {
        drawerOpen = !drawerOpen;
    }

    private async Task RefreshAuthAsync()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("storageHelper.get", "auth_token");
            var loggedIn = !string.IsNullOrEmpty(token);
            if (loggedIn != isLoggedIn)
            {
                isLoggedIn = loggedIn;
                if (loggedIn)
                {
                    userName = ParseUserName(token) ?? string.Empty;
                    userRole = ParseUserRole(token) ?? string.Empty;
                }
                else
                {
                    userName = string.Empty;
                    userRole = string.Empty;
                    selectedCompanyId = null;
                    selectedCompanyName = string.Empty;
                    companies = [];
                    companiesLoaded = false;
                    showCompanyModal = false;
                    companiesLoading = false;
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Auth check error: {ex.GetType().Name}: {ex.Message}");
        }
    }

    private async Task LoadCompaniesAsync()
    {
        if (!isLoggedIn || companies.Count > 0)
        {
            return;
        }

        companiesLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var userId = await CompanyContext.GetUserIdAsync();
            var token = await CompanyContext.GetTokenAsync();
            var client = HttpClientFactory.CreateClient("FeniciaAuth");
            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var storedCompanyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (storedCompanyId.HasValue)
            {
                client.DefaultRequestHeaders.Remove("CompanyId");
                client.DefaultRequestHeaders.Add("CompanyId", storedCompanyId.Value.ToString());
            }

            var response = await client.GetAsync($"/user/{userId}/company");

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var items = System.Text.Json.JsonSerializer.Deserialize<List<UserCompanyItem>>(json,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                if (items is not null)
                {
                    companies = items;
                    await LoadSelectedCompanyAsync();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Load error: {ex.Message}");
        }
        finally
        {
            companiesLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadSelectedCompanyAsync()
    {
        try
        {
            var companyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (companyId.HasValue)
            {
                selectedCompanyId = companyId;
                var match = companies.FirstOrDefault(c => c.Id == companyId.Value);
                if (match is not null)
                {
                    selectedCompanyName = match.CompanyName;
                    CompanyState.Set(match.Id, match.CompanyName);
                    await JSRuntime.InvokeVoidAsync("storageHelper.setCookie", "selected_company_id", companyId.Value.ToString(), 7);
                    showCompanyModal = false;
                }
                else
                {
                    selectedCompanyName = CompanyState.SelectedCompanyId == companyId && !string.IsNullOrEmpty(CompanyState.SelectedCompanyName)
                        ? CompanyState.SelectedCompanyName
                        : string.Empty;
                    showCompanyModal = true;
                }
            }
            else
            {
                showCompanyModal = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Load selected error: {ex.Message}");
        }
    }

    private async Task SelectCompanyAsync(UserCompanyItem company)
    {
        try
        {
            await CompanyContext.SetSelectedCompanyIdAsync(company.Id);
            await JSRuntime.InvokeVoidAsync("storageHelper.setCookie", "selected_company_id", company.Id.ToString(), 7);

            selectedCompanyId = company.Id;
            selectedCompanyName = company.CompanyName;
            CompanyState.Set(company.Id, company.CompanyName);

            showCompanyModal = false;
            await InvokeAsync(StateHasChanged);

            Snackbar.Add($"Empresa \"{company.CompanyName}\" selecionada.", Severity.Success);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Select company error: {ex.Message}");
            Snackbar.Add($"Erro ao selecionar empresa: {ex.Message}", Severity.Error);
        }
    }

    private void OpenCompanyModal()
    {
        if (companies.Count > 0 && !showCompanyModal)
        {
            showCompanyModal = true;
        }
    }

    private void RetryLoadCompanies()
    {
        companiesLoaded = false;
    }

    private static string? ParseUserName(string token)
    {
        try
        {
            var parts = token.Split('.');
            if (parts.Length < 2) return null;
            var payload = parts[1].Replace('-', '+').Replace('_', '/');
            switch (payload.Length % 4)
            {
                case 2: payload += "=="; break;
                case 3: payload += "="; break;
            }
            using var doc =
                System.Text.Json.JsonDocument.Parse(System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(payload)));
            return doc.RootElement.TryGetProperty("unique_name", out var n) ? n.GetString() : null;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Parse error: {ex.Message}");
            return null;
        }
    }

    private static string? ParseUserRole(string token)
    {
        try
        {
            var parts = token.Split('.');
            if (parts.Length < 2) return null;
            var payload = parts[1].Replace('-', '+').Replace('_', '/');
            switch (payload.Length % 4)
            {
                case 2: payload += "=="; break;
                case 3: payload += "="; break;
            }
            using var doc =
                System.Text.Json.JsonDocument.Parse(System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(payload)));
            if (doc.RootElement.TryGetProperty("role", out var roleElement))
            {
                var roleJson = roleElement.GetString();
                if (!string.IsNullOrEmpty(roleJson))
                {
                    if (roleJson.StartsWith("["))
                    {
                        var roles = System.Text.Json.JsonSerializer.Deserialize<List<string>>(roleJson);
                        return roles is { Count: > 0 } ? roles[0] : null;
                    }
                    return roleJson;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Parse role error: {ex.Message}");
        }
        return null;
    }

    private static string FormatCnpj(string cnpj)
    {
        if (string.IsNullOrEmpty(cnpj))
        {
            return string.Empty;
        }
        return cnpj.Length == 14 ? $"{cnpj[..2]}.{cnpj[2..5]}.{cnpj[5..8]}/{cnpj[8..12]}-{cnpj[12..]}" : cnpj;
    }

    public class UserCompanyItem
    {
        public Guid Id { get; set; }
        public string CompanyName { get; set; } = string.Empty;
        public string Cnpj { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}