@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext
@inject NotificationService NotificationService
@inject ISnackbar Snackbar

<MudLayout>
    <MudAppBar Elevation="0" Class="fenicia-appbar" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" Class="mr-2" />
        <MudLink Href="/dashboard" Underline="Underline.None" Color="Color.Inherit" Class="d-flex align-center">
            <img src="/images/logo.svg" alt="Fenicia" class="logo-img" />
        </MudLink>
        <MudSpacer />
        <MudHidden Breakpoint="Breakpoint.MdAndDown" Invert="true">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                @if (isLoggedIn)
                {
                    <MudMenu Label="@(string.IsNullOrEmpty(selectedCompanyName) ? "Selecionar Empresa" : selectedCompanyName)" Color="Color.Inherit" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowDropDown">
                        <MudMenuItem>
                            @if (companies.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Error">Nenhuma empresa encontrada.</MudText>
                            }
                            else
                            {
                                @foreach (var company in companies)
                                {
                                    <MudMenuItem OnClick="@(() => SelectCompany(company))">
                                        <div>
                                            <MudText Typo="Typo.body1">@company.Name</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Default">@company.Role</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Default">@FormatCnpj(company.Cnpj)</MudText>
                                        </div>
                                    </MudMenuItem>
                                }
                            }
                        </MudMenuItem>
                        <MudDivider />
                        <MudMenuItem Href="/profile">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-2" />Meu Perfil (@userName)
                        </MudMenuItem>
                        <MudMenuItem Href="/dashboard">
                            <MudIcon Icon="@Icons.Material.Filled.Dashboard" Class="mr-2" />Painel
                        </MudMenuItem>
                        <MudMenuItem Href="/shop">
                            <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Class="mr-2" />Loja
                        </MudMenuItem>
                        <MudDivider />
                        <MudMenuItem Href="/logout">
                            <MudIcon Icon="@Icons.Material.Filled.Logout" Class="mr-2" />Sair
                        </MudMenuItem>
                    </MudMenu>
                }
                else
                {
                    <MudLink Href="/signup" Underline="Underline.None" Color="Color.Inherit">
                        <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.PersonAdd">Criar Conta</MudButton>
                    </MudLink>
                    <MudLink Href="/login" Underline="Underline.None" Color="Color.Inherit">
                        <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Login">Entrar</MudButton>
                    </MudLink>
                }
            </MudStack>
        </MudHidden>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Anchor="Anchor.Left" Variant="DrawerVariant.Temporary" Breakpoint="Breakpoint.Md">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Início</MudNavLink>
            @if (isLoggedIn)
            {
                <MudNavGroup Title="Básico" Icon="@Icons.Material.Filled.Category" Expanded="false">
                    <MudNavLink Href="/productcategories" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Category">Categorias de Produtos</MudNavLink>
                </MudNavGroup>
                <MudNavLink Href="/profile" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Person">Meu Perfil (@userName)</MudNavLink>
                <MudNavLink Href="/dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Painel</MudNavLink>
                <MudNavLink Href="/shop" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ShoppingCart">Loja</MudNavLink>
                <MudNavLink Href="/logout" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Logout">Sair</MudNavLink>
            }
            else
            {
                <MudNavLink Href="/signup" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.PersonAdd">Criar Conta</MudNavLink>
                <MudNavLink Href="/login" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Login">Entrar</MudNavLink>
            }
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
            @ChildContent
        </MudContainer>
    </MudMainContent>

    <MudPaper Class="pa-4" Elevation="0" Style="background: #1a237e; color: white; border-radius: 0;">
        <MudText Typo="Typo.caption" Align="Align.Center" Style="color: rgba(255,255,255,0.7);">
            <strong style="color: white;">Fenicia</strong> &copy; @DateTime.Now.Year — O Sistema Modular Open Source para sua Empresa.
        </MudText>
    </MudPaper>
</MudLayout>

@if (showCompanyModal)
{
    <MudDialogProvider />
}

<style>
    .logo-img {
        height: 40px;
        width: auto;
    }
</style>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private bool isLoggedIn = false;
    private string userName = string.Empty;
    private bool _jsAvailable;
    private bool _drawerOpen;
    private string selectedCompanyName = string.Empty;
    private Guid? selectedCompanyId;
    private string companyError = string.Empty;
    private List<UserCompanyItem> companies = [];
    private bool _companiesLoaded;
    private bool showCompanyModal;
    private Guid? selectedCompanyIdModal;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        NotificationService.OnChange += HandleNotificationChange;
    }

    private void HandleNotificationChange()
    {
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_jsAvailable)
        {
            await RefreshAuthAsync();
            if (!_companiesLoaded)
            {
                _companiesLoaded = true;
                await LoadCompaniesAsync();
            }
            return;
        }

        try
        {
            await JSRuntime.InvokeAsync<string>("storageHelper.get", "auth_token");
            _jsAvailable = true;
            await RefreshAuthAsync();
            if (!_companiesLoaded)
            {
                _companiesLoaded = true;
                await LoadCompaniesAsync();
            }
        }
        catch (Exception ex)
        {
            var message = ex.InnerException?.Message ?? ex.Message;
            if (message.Contains("statically rendered"))
            {
                return;
            }
            Console.WriteLine($"[MainLayout] OnAfterRenderAsync error: {ex.GetType().Name}: {message}");
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_jsAvailable)
        {
            _ = RefreshAuthAsync();
        }
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task RefreshAuthAsync()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("storageHelper.get", "auth_token");
            var loggedIn = !string.IsNullOrEmpty(token);
            if (loggedIn != isLoggedIn)
            {
                isLoggedIn = loggedIn;
                userName = loggedIn ? ParseUserName(token) ?? string.Empty : string.Empty;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Auth check error: {ex.GetType().Name}: {ex.Message}");
        }
    }

    private async Task LoadCompaniesAsync()
    {
        try
        {
            var userId = await CompanyContext.GetUserIdAsync();
            var token = await CompanyContext.GetTokenAsync();
            var client = HttpClientFactory.CreateClient("FeniciaAuth");
            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var selectedCompanyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (selectedCompanyId.HasValue)
            {
                client.DefaultRequestHeaders.Remove("CompanyId");
                client.DefaultRequestHeaders.Add("CompanyId", selectedCompanyId.Value.ToString());
            }

            var response = await client.GetAsync($"/user/{userId}/company");

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var items = System.Text.Json.JsonSerializer.Deserialize<List<UserCompanyItem>>(json,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                if (items is not null)
                {
                    companies = items;
                    await LoadSelectedCompanyAsync();
                }
            }
            else
            {
                companyError = $"Erro: {(int)response.StatusCode} {response.StatusCode}";
            }

            if (isLoggedIn && companies.Count > 0 && !selectedCompanyId.HasValue)
            {
                showCompanyModal = true;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Load error: {ex.Message}");
            companyError = ex.Message;
        }
    }

    private async Task LoadSelectedCompanyAsync()
    {
        try
        {
            var companyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (companyId.HasValue)
            {
                selectedCompanyId = companyId;
                var match = companies.FirstOrDefault(c => c.Id == companyId.Value);
                if (match is not null)
                {
                    selectedCompanyName = match.Name;
                    showCompanyModal = false;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Load selected error: {ex.Message}");
        }
    }

    private async Task SelectCompany(UserCompanyItem company)
    {
        try
        {
            await CompanyContext.SetSelectedCompanyIdAsync(company.Id);
            await JSRuntime.InvokeVoidAsync("storageHelper.setCookie", "selected_company_id", company.Id.ToString(), 7);
            selectedCompanyId = company.Id;
            selectedCompanyName = company.Name;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Select error: {ex.Message}");
        }
    }

    private async Task ConfirmCompanySelection()
    {
        if (!selectedCompanyIdModal.HasValue) return;

        try
        {
            StateHasChanged();

            var company = companies.FirstOrDefault(c => c.Id == selectedCompanyIdModal.Value);
            if (company != null)
            {
                await SelectCompany(company);
                showCompanyModal = false;
                selectedCompanyIdModal = null;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Confirm company error: {ex.Message}");
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string? ParseUserName(string token)
    {
        try
        {
            var parts = token.Split('.');
            if (parts.Length < 2) return null;
            var payload = parts[1].Replace('-', '+').Replace('_', '/');
            switch (payload.Length % 4)
            {
                case 2: payload += "=="; break;
                case 3: payload += "="; break;
            }
            using var doc = System.Text.Json.JsonDocument.Parse(System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(payload)));
            return doc.RootElement.TryGetProperty("unique_name", out var n) ? n.GetString() : null;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Parse error: {ex.Message}");
            return null;
        }
    }

    private static string FormatCnpj(string cnpj)
    {
        if (cnpj.Length == 14)
        {
            return $"{cnpj[..2]}.{cnpj[2..5]}.{cnpj[5..8]}/{cnpj[8..12]}-{cnpj[12..]}";
        }
        return cnpj;
    }

    private class UserCompanyItem
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Cnpj { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        NotificationService.OnChange -= HandleNotificationChange;
    }
}
