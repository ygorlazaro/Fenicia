@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext
@inject ICompanySelectionState CompanyState
@inject IUserProfileNotifier UserProfileNotifier
@inject ILoadingService LoadingService

<MudProgressLinear Indeterminate="true" Visible="@isLoading" Absolute="true" Top="true" Striped="true" Color="Color.Primary" Size="Size.Small" />

<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider Position="MudBlazor.SnackbarPosition.TopRight" Timeout="5000" ShowCloseIcon="true" />

<MudLayout>
    <AppBar IsLoggedIn="@isLoggedIn"
            UserName="@userName"
            UserRole="@userRole"
            UserImageUrl="@userImageUrl"
            SelectedCompanyName="@selectedCompanyName"
            Companies="@companies"
            OnToggleDrawer="ToggleDrawer" />

    <SideDrawer @bind-Open="drawerOpen" IsLoggedIn="@isLoggedIn" />

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
            @ChildContent
        </MudContainer>
    </MudMainContent>

    <Footer />
</MudLayout>

<style>
    .logo-img {
        height: 40px;
        width: auto;
    }

    .topbar-actions {
        color: white;
    }

    .topbar-divider {
        height: 28px;
        margin: 0 4px;
        border-color: rgba(255, 255, 255, 0.35) !important;
        background-color: rgba(255, 255, 255, 0.35);
    }
</style>
