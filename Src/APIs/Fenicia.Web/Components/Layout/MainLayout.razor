@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext
@inject ICompanySelectionState CompanyState
@inject ICompanyChangeNotifier CompanyNotifier
@inject ISnackbar Snackbar
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider Position="MudBlazor.SnackbarPosition.TopRight" Timeout="5000" ShowCloseIcon="true" />

<MudLayout>
        <MudAppBar Elevation="0" Class="fenicia-appbar" Dense="true">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" Class="mr-2" />
            <MudLink Href="/dashboard" Underline="Underline.None" Color="Color.Inherit" Class="d-flex align-center">
                <img src="/images/logo.svg" alt="Fenicia" class="logo-img" />
            </MudLink>
            <MudSpacer />
            <MudHidden Breakpoint="Breakpoint.MdAndDown">
                @if (isLoggedIn)
                {
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="topbar-actions">
                        <MudMenu AnchorOrigin="Origin.BottomRight"
                                 TransformOrigin="Origin.TopRight"
                                 OffsetY="4"
                                 Dense="true"
                                 Disabled="@(companies.Count == 0)"
                                 ActivationEvent="MouseEvent.LeftClick">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Inherit"
                                           StartIcon="@Icons.Material.Filled.Business"
                                           EndIcon="@Icons.Material.Filled.ArrowDropDown"
                                           OnClick="@(async () => await context.ToggleAsync())">
                                    <span class="topbar-company-name">
                                        @(string.IsNullOrEmpty(selectedCompanyName) ? "Selecionar Empresa" : selectedCompanyName)
                                    </span>
                                </MudButton>
                            </ActivatorContent>
                            <ChildContent>
                                <MudMenuItem Disabled="true">
                                    <MudText Typo="Typo.caption" Color="Color.Default">Selecione a empresa</MudText>
                                </MudMenuItem>
                                <MudDivider />
                                @if (companies.Count == 0)
                                {
                                    <MudMenuItem Disabled="true">
                                        <MudText Typo="Typo.body2">Nenhuma empresa disponível</MudText>
                                    </MudMenuItem>
                                }
                                else
                                {
                                    @foreach (var company in companies)
                                    {
                                        var isCurrent = selectedCompanyId.HasValue && company.Id == selectedCompanyId.Value;
                                        <MudMenuItem OnClick="@(() => SelectCompanyAsync(company))">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="w-100">
                                                @if (isCurrent)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                                                }
                                                else
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Circle" Color="Color.Default" Size="Size.Small" Style="visibility:hidden" />
                                                }
                                                <div class="d-flex flex-column flex-grow-1" style="min-width:0">
                                                    <MudText Typo="Typo.body2" Style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                                        <strong>@company.Name</strong>
                                                    </MudText>
                                                    @if (!string.IsNullOrEmpty(company.Role))
                                                    {
                                                        <MudText Typo="Typo.caption" Color="Color.Default" Style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                                            @company.Role · @FormatCnpj(company.Cnpj)
                                                        </MudText>
                                                    }
                                                </div>
                                            </MudStack>
                                        </MudMenuItem>
                                    }
                                }
                            </ChildContent>
                        </MudMenu>
                        <MudDivider Vertical="true" FlexItem="true" Class="topbar-divider" />
                        <MudLink Href="/socialnetwork/profile" Underline="Underline.None" Color="Color.Inherit">
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Inherit"
                                       StartIcon="@Icons.Material.Filled.Person">
                                @userName
                            </MudButton>
                        </MudLink>
                        <MudDivider Vertical="true" FlexItem="true" Class="topbar-divider" />
                        <MudLink Href="/logout" Underline="Underline.None" Color="Color.Inherit">
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Inherit"
                                       StartIcon="@Icons.Material.Filled.Logout">
                                Sair
                            </MudButton>
                        </MudLink>
                    </MudStack>
                }
                else
                {
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudLink Href="/signup" Underline="Underline.None" Color="Color.Inherit">
                            <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.PersonAdd">Criar Conta</MudButton>
                        </MudLink>
                        <MudLink Href="/login" Underline="Underline.None" Color="Color.Inherit">
                            <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Login">Entrar</MudButton>
                        </MudLink>
                    </MudStack>
                }
            </MudHidden>
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen" Anchor="Anchor.Left" Variant="DrawerVariant.Temporary" Breakpoint="Breakpoint.Md">
            <MudNavMenu>
                <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Início</MudNavLink>
                @if (isLoggedIn)
                {
                    <MudNavGroup Title="Básico" Icon="@Icons.Material.Filled.Category" Expanded="true">
                        <MudNavLink Href="/basic/productcategory" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Category">Categorias de Produtos</MudNavLink>
                        <MudNavLink Href="/basic/position" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.WorkOutline">Cargos</MudNavLink>
                        <MudNavLink Href="/basic/supplier" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.LocalShipping">Fornecedores</MudNavLink>
                        <MudNavLink Href="/basic/customer" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.People">Clientes</MudNavLink>
                        <MudNavLink Href="/basic/employee" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Badge">Funcionários</MudNavLink>
                        <MudNavLink Href="/basic/product" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Inventory">Produtos</MudNavLink>
                        <MudNavLink Href="/basic/stockmovement" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.SwapVert">Movimentações</MudNavLink>
                        <MudNavLink Href="/basic/inventory" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Assessment">Inventário</MudNavLink>
                        <MudNavLink Href="/basic/order" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.PointOfSale">Pedidos</MudNavLink>
                    </MudNavGroup>
                    <MudNavGroup Title="Rede Social" Icon="@Icons.Material.Filled.Share" Expanded="true">
                        <MudNavLink Href="/socialnetwork/feed" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Feed</MudNavLink>
                        <MudNavLink Href="/socialnetwork/profile" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Person">Meu Perfil</MudNavLink>
                    </MudNavGroup>
                    <MudNavLink Href="/dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Painel</MudNavLink>
                    <MudNavLink Href="/shop" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ShoppingCart">Loja</MudNavLink>
                }
                else
                {
                    <MudNavLink Href="/signup" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.PersonAdd">Criar Conta</MudNavLink>
                    <MudNavLink Href="/login" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Login">Entrar</MudNavLink>
                }
            </MudNavMenu>
        </MudDrawer>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
                @ChildContent
            </MudContainer>
        </MudMainContent>

        <MudPaper Class="pa-4 fenicia-footer" Elevation="0">
            <MudText Typo="Typo.caption" Align="Align.Right">
                <strong>Fenicia</strong> &copy; @DateTime.Now.Year — O Sistema Modular Open Source para sua Empresa.
            </MudText>
        </MudPaper>
    </MudLayout>

<style>
    .logo-img {
        height: 40px;
        width: auto;
    }

    .topbar-actions {
        color: white;
    }

    .topbar-company {
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: white !important;
    }

    .topbar-company-name {
        max-width: 200px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        display: inline-block;
        vertical-align: middle;
    }

    .topbar-divider {
        height: 28px;
        margin: 0 4px;
        border-color: rgba(255, 255, 255, 0.35) !important;
        background-color: rgba(255, 255, 255, 0.35);
    }
</style>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private bool isLoggedIn = false;
    private string userName = string.Empty;
    private bool _jsAvailable;
    private bool _drawerOpen;
    private string selectedCompanyName = string.Empty;
    private Guid? selectedCompanyId;
    private List<UserCompanyItem> companies = [];
    private bool _companiesLoaded;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        CompanyNotifier.Changed += HandleCompanyChanged;
    }

    private async void HandleCompanyChanged()
    {
        try
        {
            var companyId = CompanyState.SelectedCompanyId ?? await CompanyContext.GetSelectedCompanyIdAsync();
            selectedCompanyId = companyId;
            if (companyId.HasValue)
            {
                selectedCompanyName = !string.IsNullOrEmpty(CompanyState.SelectedCompanyName)
                    ? CompanyState.SelectedCompanyName
                    : (companies.FirstOrDefault(c => c.Id == companyId.Value)?.Name ?? selectedCompanyName);
            }
            else
            {
                selectedCompanyName = string.Empty;
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Company change error: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_jsAvailable)
        {
            await RefreshAuthAsync();
            if (!_companiesLoaded)
            {
                _companiesLoaded = true;
                await LoadCompaniesAsync();
            }
            return;
        }

        try
        {
            await JSRuntime.InvokeAsync<string>("storageHelper.get", "auth_token");
            _jsAvailable = true;
            await RefreshAuthAsync();
            if (!_companiesLoaded)
            {
                _companiesLoaded = true;
                await LoadCompaniesAsync();
            }
        }
        catch (Exception ex)
        {
            var message = ex.InnerException?.Message ?? ex.Message;
            if (message.Contains("statically rendered"))
            {
                return;
            }
            Console.WriteLine($"[MainLayout] OnAfterRenderAsync error: {ex.GetType().Name}: {message}");
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_jsAvailable)
        {
            _ = RefreshAuthAsync();
        }
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task RefreshAuthAsync()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("storageHelper.get", "auth_token");
            var loggedIn = !string.IsNullOrEmpty(token);
            if (loggedIn != isLoggedIn)
            {
                isLoggedIn = loggedIn;
                userName = loggedIn ? ParseUserName(token) ?? string.Empty : string.Empty;
                if (!loggedIn)
                {
                    selectedCompanyId = null;
                    selectedCompanyName = string.Empty;
                    companies = [];
                    _companiesLoaded = false;
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Auth check error: {ex.GetType().Name}: {ex.Message}");
        }
    }

    private async Task LoadCompaniesAsync()
    {
        try
        {
            var userId = await CompanyContext.GetUserIdAsync();
            var token = await CompanyContext.GetTokenAsync();
            var client = HttpClientFactory.CreateClient("FeniciaAuth");
            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var storedCompanyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (storedCompanyId.HasValue)
            {
                client.DefaultRequestHeaders.Remove("CompanyId");
                client.DefaultRequestHeaders.Add("CompanyId", storedCompanyId.Value.ToString());
            }

            var response = await client.GetAsync($"/user/{userId}/company");

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var items = System.Text.Json.JsonSerializer.Deserialize<List<UserCompanyItem>>(json,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                if (items is not null)
                {
                    companies = items;
                    await LoadSelectedCompanyAsync();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Load error: {ex.Message}");
        }
    }

    private async Task LoadSelectedCompanyAsync()
    {
        try
        {
            var companyId = await CompanyContext.GetSelectedCompanyIdAsync();
if (companyId.HasValue)
                {
                    selectedCompanyId = companyId;
                    var match = companies.FirstOrDefault(c => c.Id == companyId.Value);
                    if (match is not null)
                    {
                        selectedCompanyName = match.Name;
                        CompanyState.Set(match.Id, match.Name);
                        await JSRuntime.InvokeVoidAsync("storageHelper.setCookie", "selected_company_id", companyId.Value.ToString(), 7);
                    }
                    else if (CompanyState.SelectedCompanyId == companyId && !string.IsNullOrEmpty(CompanyState.SelectedCompanyName))
                    {
                        selectedCompanyName = CompanyState.SelectedCompanyName;
                    }
                }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Load selected error: {ex.Message}");
        }
    }

    private static string? ParseUserName(string token)
    {
        try
        {
            var parts = token.Split('.');
            if (parts.Length < 2) return null;
            var payload = parts[1].Replace('-', '+').Replace('_', '/');
            switch (payload.Length % 4)
            {
                case 2: payload += "=="; break;
                case 3: payload += "="; break;
            }
            using var doc = System.Text.Json.JsonDocument.Parse(System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(payload)));
            return doc.RootElement.TryGetProperty("unique_name", out var n) ? n.GetString() : null;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Parse error: {ex.Message}");
            return null;
        }
    }

    private async Task SelectCompanyAsync(UserCompanyItem company)
    {
        try
        {
            await CompanyContext.SetSelectedCompanyIdAsync(company.Id);
            await JSRuntime.InvokeVoidAsync("storageHelper.setCookie", "selected_company_id", company.Id.ToString(), 7);

            selectedCompanyId = company.Id;
            selectedCompanyName = company.Name;
            CompanyState.Set(company.Id, company.Name);
            CompanyNotifier.Notify();

            Snackbar.Add($"Empresa \"{company.Name}\" selecionada.", Severity.Success);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Select company error: {ex.Message}");
            Snackbar.Add($"Erro ao selecionar empresa: {ex.Message}", Severity.Error);
        }
    }

    private static string FormatCnpj(string cnpj)
    {
        if (string.IsNullOrEmpty(cnpj))
        {
            return string.Empty;
        }
        if (cnpj.Length == 14)
        {
            return $"{cnpj[..2]}.{cnpj[2..5]}.{cnpj[5..8]}/{cnpj[8..12]}-{cnpj[12..]}";
        }
        return cnpj;
    }

    public class UserCompanyItem
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Cnpj { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
    }

public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        CompanyNotifier.Changed -= HandleCompanyChanged;
    }
}