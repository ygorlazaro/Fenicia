@inherits ComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory HttpClientFactory
@inject ICompanyContextService CompanyContext
@inject NotificationService NotificationService

<nav class="navbar is-link" role="navigation" aria-label="main navigation">
    <div class="container">
        <div class="navbar-brand">
            <a class="navbar-item" href="/dashboard">
                <img src="/images/logo.svg" alt="Fenicia" class="logo-img" />
            </a>
            <a role="button" class="navbar-burger" aria-label="menu" aria-expanded="false" data-target="navbarBasic" @onclick="ToggleNavbar">
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
            </a>
        </div>

        <div id="navbarBasic" class="navbar-menu @(isNavbarActive ? "is-active" : "")">
            <div class="navbar-start">
                <a class="navbar-item" href="/">
                    <span class="icon"><i class="fas fa-home"></i></span>
                    <span>Início</span>
                </a>

                @if (isLoggedIn)
                {
                    <div class="navbar-item has-dropdown is-hoverable">
                        <a class="navbar-link">
                            <span class="icon"><i class="fas fa-cubes"></i></span>
                            <span>Básico</span>
                        </a>
                        <div class="navbar-dropdown">
                            <a class="navbar-item" href="/productcategories">
                                <span class="icon"><i class="fas fa-tags"></i></span>
                                <span>Categorias de Produtos</span>
                            </a>
                        </div>
                    </div>

                    <div class="navbar-item has-dropdown is-hoverable">
                        <a class="navbar-link">
                            <span class="icon"><i class="fas fa-building"></i></span>
                            @if (!string.IsNullOrEmpty(selectedCompanyName))
                            {
                                <span>@selectedCompanyName</span>
                            }
                            else
                            {
                                <span>Selecionar Empresa</span>
                            }
                        </a>
                        <div class="navbar-dropdown">
                            @if (companies.Count == 0)
                            {
                                <a class="navbar-item">
                                    <span class="icon"><i class="fas fa-exclamation-circle"></i></span>
                                    <span>Nenhuma empresa encontrada.</span>
                                </a>
                            }
                            else
                            {
                                @foreach (var company in companies)
                                {
                                    <a class="navbar-item @(IsCompanySelected(company) ? "is-active" : "")" @onclick="() => SelectCompany(company)">
                                        <div>
                                            <strong>@company.Name</strong>
                                            <div class="is-size-7 has-text-grey">@company.Role</div>
                                            <div class="is-size-7 has-text-grey">@FormatCnpj(company.Cnpj)</div>
                                        </div>
                                    </a>
                                }
                            }
                        </div>
                    </div>
                    <a class="navbar-item" href="/profile">
                        <span class="icon"><i class="fas fa-user"></i></span>
                        <span>Meu Perfil (@userName)</span>
                    </a>
                    <a class="navbar-item" href="/dashboard">
                        <span class="icon"><i class="fas fa-chart-pie"></i></span>
                        <span>Painel</span>
                    </a>
                    <a class="navbar-item" href="/shop">
                        <span class="icon"><i class="fas fa-shopping-cart"></i></span>
                        <span>Loja</span>
                    </a>
                    <a class="navbar-item" href="/logout">
                        <span class="icon"><i class="fas fa-sign-out-alt"></i></span>
                        <span>Sair</span>
                    </a>
                }
                else
                {
                    <a class="navbar-item" href="/signup">
                        <span class="icon"><i class="fas fa-user-plus"></i></span>
                        <span>Criar Conta</span>
                    </a>
                    <a class="navbar-item" href="/login">
                        <span class="icon"><i class="fas fa-sign-in-alt"></i></span>
                        <span>Entrar</span>
                    </a>
                }
            </div>
        </div>
    </div>
</nav>

@if (notifications.Count > 0)
{
    <div class="notification-stack">
        @foreach (var notification in notifications)
        {
            <Notification Color="@notification.Color" HideCloseButton="false" @key="notification.Id">
                <div class="level is-mobile">
                    <div class="level-left">
                        <div class="level-item">
                            @notification.Message
                        </div>
                    </div>
                    <div class="level-right">
                        <div class="level-item">
                            <button class="delete" aria-label="close" @onclick="() => NotificationService.Remove(notification.Id)"></button>
                        </div>
                    </div>
                </div>
            </Notification>
        }
    </div>
}

@if (showCompanyModal)
{
    <Modal Title="Selecionar Empresa" BodyCssClass="has-text-centered" HideCloseButton="true">
        <p>Selecione uma empresa para continuar:</p>
        <div class="select is-fullwidth mt-4">
            <select @bind="selectedCompanyIdModal" class="select">
                <option value="">-- Selecione --</option>
                @foreach (var company in companies)
                {
                    <option value="@company.Id">@company.Name (@FormatCnpj(company.Cnpj))</option>
                }
            </select>
        </div>
    </Modal>
    <Modal FootCssClass="has-text-centered">
        <button class="button is-link" @onclick="ConfirmCompanySelection" disabled="@isSelectingCompany">
            @if (isSelectingCompany)
            {
                <span class="icon is-small">
                    <i class="fas fa-spinner fa-spin"></i>
                </span>
                <span>Selecionando...</span>
            }
            else
            {
                <span>Confirmar</span>
            }
        </button>
    </Modal>
}

@ChildContent

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro não tratado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private bool isLoggedIn = false;
    private string userName = string.Empty;
    private bool _jsAvailable;
    private bool isNavbarActive;
    private string selectedCompanyName = string.Empty;
    private Guid? selectedCompanyId;
    private string companyError = string.Empty;
    private List<UserCompanyItem> companies = [];
    private bool _companiesLoaded;
    private List<NotificationService.NotificationItem> notifications = [];
    private bool showCompanyModal;
    private Guid? selectedCompanyIdModal;
    private bool isSelectingCompany;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        NotificationService.OnChange += HandleNotificationChange;
    }

    private void HandleNotificationChange()
    {
        notifications = NotificationService.Notifications.ToList();
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_jsAvailable)
        {
            await RefreshAuthAsync();
            if (!_companiesLoaded)
            {
                _companiesLoaded = true;
                await LoadCompaniesAsync();
            }
            return;
        }

        try
        {
            await JSRuntime.InvokeAsync<string>("storageHelper.get", "auth_token");
            _jsAvailable = true;
            await RefreshAuthAsync();
            if (!_companiesLoaded)
            {
                _companiesLoaded = true;
                await LoadCompaniesAsync();
            }
        }
        catch (Exception ex)
        {
            var message = ex.InnerException?.Message ?? ex.Message;
            if (message.Contains("statically rendered"))
            {
                return;
            }
            Console.WriteLine($"[MainLayout] OnAfterRenderAsync error: {ex.GetType().Name}: {message}");
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_jsAvailable)
        {
            _ = RefreshAuthAsync();
        }
    }

    private void ToggleNavbar()
    {
        isNavbarActive = !isNavbarActive;
    }

    private async Task RefreshAuthAsync()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("storageHelper.get", "auth_token");
            var loggedIn = !string.IsNullOrEmpty(token);
            if (loggedIn != isLoggedIn)
            {
                isLoggedIn = loggedIn;
                userName = loggedIn ? ParseUserName(token) ?? string.Empty : string.Empty;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Auth check error: {ex.GetType().Name}: {ex.Message}");
        }
    }

    private async Task LoadCompaniesAsync()
    {
        try
        {
            var userId = await CompanyContext.GetUserIdAsync();
            var token = await CompanyContext.GetTokenAsync();
            var client = HttpClientFactory.CreateClient("FeniciaAuth");
            if (!string.IsNullOrEmpty(token))
            {
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var selectedCompanyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (selectedCompanyId.HasValue)
            {
                client.DefaultRequestHeaders.Remove("CompanyId");
                client.DefaultRequestHeaders.Add("CompanyId", selectedCompanyId.Value.ToString());
            }

            var response = await client.GetAsync($"/user/{userId}/company");

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var items = System.Text.Json.JsonSerializer.Deserialize<List<UserCompanyItem>>(json,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                if (items is not null)
                {
                    companies = items;
                    await LoadSelectedCompanyAsync();
                }
            }
            else
            {
                companyError = $"Erro: {(int)response.StatusCode} {response.StatusCode}";
            }

            if (isLoggedIn && companies.Count > 0 && !selectedCompanyId.HasValue)
            {
                showCompanyModal = true;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Load error: {ex.Message}");
            companyError = ex.Message;
        }
    }

    private async Task LoadSelectedCompanyAsync()
    {
        try
        {
            var companyId = await CompanyContext.GetSelectedCompanyIdAsync();
            if (companyId.HasValue)
            {
                selectedCompanyId = companyId;
                var match = companies.FirstOrDefault(c => c.Id == companyId.Value);
                if (match is not null)
                {
                    selectedCompanyName = match.Name;
                    showCompanyModal = false;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Load selected error: {ex.Message}");
        }
    }

    private bool IsCompanySelected(UserCompanyItem company)
    {
        return selectedCompanyId.HasValue && selectedCompanyId.Value == company.Id;
    }

    private async Task SelectCompany(UserCompanyItem company)
    {
        try
        {
            await CompanyContext.SetSelectedCompanyIdAsync(company.Id);
            await JSRuntime.InvokeVoidAsync("storageHelper.setCookie", "selected_company_id", company.Id.ToString(), 7);
            selectedCompanyId = company.Id;
            selectedCompanyName = company.Name;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Select error: {ex.Message}");
        }
    }

    private static string? ParseUserName(string token)
    {
        try
        {
            var parts = token.Split('.');
            if (parts.Length < 2) return null;
            var payload = parts[1].Replace('-', '+').Replace('_', '/');
            switch (payload.Length % 4)
            {
                case 2: payload += "=="; break;
                case 3: payload += "="; break;
            }
            using var doc = System.Text.Json.JsonDocument.Parse(System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(payload)));
            return doc.RootElement.TryGetProperty("unique_name", out var n) ? n.GetString() : null;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Parse error: {ex.Message}");
            return null;
        }
    }

    private static string FormatCnpj(string cnpj)
    {
        if (cnpj.Length == 14)
        {
            return $"{cnpj[..2]}.{cnpj[2..5]}.{cnpj[5..8]}/{cnpj[8..12]}-{cnpj[12..]}";
        }
        return cnpj;
    }

    private async Task ConfirmCompanySelection()
    {
        if (!selectedCompanyIdModal.HasValue) return;

        try
        {
            isSelectingCompany = true;
            StateHasChanged();

            var company = companies.FirstOrDefault(c => c.Id == selectedCompanyIdModal.Value);
            if (company != null)
            {
                await SelectCompany(company);
                showCompanyModal = false;
                selectedCompanyIdModal = null;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Confirm company error: {ex.Message}");
        }
        finally
        {
            isSelectingCompany = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private class UserCompanyItem
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Cnpj { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        NotificationService.OnChange -= HandleNotificationChange;
    }

}

<style>
    .logo-img {
        height: 40px;
        width: auto;
    }
</style>
