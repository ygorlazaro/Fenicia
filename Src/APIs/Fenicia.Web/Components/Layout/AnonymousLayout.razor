@inherits LayoutComponentBase

<MudLayout>
    <MudAppBar Elevation="0" Class="fenicia-appbar" Dense="true">
        <MudLink Href="/" Underline="Underline.None" Color="Color.Inherit" Class="d-flex align-center">
            <img src="/images/logo.svg" alt="Fenicia" class="fenicia-logo" />
        </MudLink>
        <MudSpacer />
        <MudHidden Breakpoint="Breakpoint.MdAndDown" Invert="true">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudLink Href="/login" Underline="Underline.None" Color="Color.Inherit">
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Login">Entrar</MudButton>
                </MudLink>
                <MudLink Href="/signup" Underline="Underline.None">
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PersonAdd">Criar Conta</MudButton>
                </MudLink>
            </MudStack>
        </MudHidden>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-6">
            @Body
        </MudContainer>
    </MudMainContent>

    <MudPaper Class="pa-4" Elevation="0" Style="background: #1a237e; color: white; border-radius: 0;">
        <MudText Typo="Typo.caption" Align="Align.Center" Style="color: rgba(255,255,255,0.7);">
            <strong style="color: white;">Fenicia</strong> &copy; @DateTime.Now.Year — O Sistema Modular Open Source para sua Empresa.
        </MudText>
    </MudPaper>
</MudLayout>
