<MudAppBar Elevation="0" Class="fenicia-appbar" Dense="true">
    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                   OnClick="HandleToggleDrawer" Class="mr-2" />
    <MudLink Href="/dashboard" Underline="Underline.None" Color="Color.Inherit" Class="d-flex align-center">
        <img src="/images/logo.svg" alt="Fenicia" class="logo-img" />
    </MudLink>
    <MudSpacer />
    <MudHidden Breakpoint="Breakpoint.MdAndDown">
        @if (IsLoggedIn)
        {
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="topbar-actions">
                <MudLink Href="/company" Underline="Underline.None" Color="Color.Inherit">
                    <MudButton Variant="Variant.Text" Color="Color.Inherit"
                               Disabled="@(Companies.Count == 0)">
                        @(string.IsNullOrEmpty(SelectedCompanyName) ? "Selecionar Empresa" : SelectedCompanyName)
                    </MudButton>
                </MudLink>
                <MudDivider Vertical="true" FlexItem="true" Class="topbar-divider" />
                <MudLink Href="/profile" Underline="Underline.None" Color="Color.Inherit">
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        @if (!string.IsNullOrEmpty(UserImageUrl))
                        {
                            <MudAvatar Size="Size.Small" Style="height:28px;width:28px;overflow:hidden;">
                                <img src="@UserImageUrl" alt="Perfil" style="width:100%;height:100%;object-fit:cover;" />
                            </MudAvatar>
                        }
                        else
                        {
                            <MudAvatar Color="Color.Primary" Size="Size.Small" Style="height:28px;width:28px;font-size:0.875rem;">
                                @GetInitials(UserName)
                            </MudAvatar>
                        }
                        <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Person">
                            @UserName@(!string.IsNullOrEmpty(UserRole) ? $" ({UserRole})" : "")
                        </MudButton>
                    </MudStack>
                </MudLink>
                <MudDivider Vertical="true" FlexItem="true" Class="topbar-divider" />
                <MudLink Href="/logout" Underline="Underline.None" Color="Color.Inherit">
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Logout">
                        Sair
                    </MudButton>
                </MudLink>
            </MudStack>
        }
        else
        {
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudLink Href="/signup" Underline="Underline.None" Color="Color.Inherit">
                    <MudButton Variant="Variant.Text" Color="Color.Inherit"
                               StartIcon="@Icons.Material.Filled.PersonAdd">Criar Conta</MudButton>
                </MudLink>
                <MudLink Href="/login" Underline="Underline.None" Color="Color.Inherit">
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Login">
                        Entrar</MudButton>
                </MudLink>
            </MudStack>
        }
    </MudHidden>
</MudAppBar>

@code {
    [Parameter] public bool IsLoggedIn { get; set; }
    [Parameter] public string UserName { get; set; } = string.Empty;
    [Parameter] public string UserRole { get; set; } = string.Empty;
    [Parameter] public string? UserImageUrl { get; set; }
    [Parameter] public string SelectedCompanyName { get; set; } = string.Empty;
    [Parameter] public List<UserCompanyItem> Companies { get; set; } = [];
    [Parameter] public EventCallback OnToggleDrawer { get; set; }

    private Task HandleToggleDrawer()
    {
        return OnToggleDrawer.InvokeAsync();
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrEmpty(name))
        {
            return "?";
        }

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1 ? parts[0][..1].ToUpper() : (parts[0][..1] + parts[^1][..1]).ToUpper();
    }
}
