        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <PackageReference Include="Scalar.AspNetCore" Version="2.17.1" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\Libs\Fenicia.Common.API\Fenicia.Common.API.csproj" />
        <ProjectReference Include="..\..\Libs\Fenicia.Common.Data\Fenicia.Common.Data.csproj" />
