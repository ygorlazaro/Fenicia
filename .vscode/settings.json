{
  "CodeGPT.apiKey": "Ollama",
  "csharp.suppressDotnetInstallWarning": true,
  "dotnet.enableTelemetry": false,
  "dotnet.showReferencesCodeLens.optOut": false,
  "dotnet.testExplorer.enableTelemetry": false,
  // ... previous exclusions ...
  "omnisharp.enableEditorConfigSupport": true,
  "omnisharp.enableRoslynAnalyzers": true,
  "omnisharp.sdkIncludePrereleases": true,
  "testing.defaultTestAdapter": "xUnit",
  "dotnet.defaultSolution": "Fenicia.sln",
  "dotnet.codeLens.enableReferencesCodeLens": false,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.wordWrap": "off",
  "prettier.configPath": "fenicia-web/.prettierrc.json",
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": [
    {
      "directory": "fenicia-web",
      "changeProcessCWD": true,
    },
  ],
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
}
