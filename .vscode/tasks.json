{
    "tasks": [
        {
            "args": [
                "build",
                "${workspaceFolder}/Fenicia.slnx",
                "--no-restore"
            ],
            "command": "dotnet",
            "group": {
                "isDefault": true,
                "kind": "build"
            },
            "label": ".NET: Build Solution",
            "problemMatcher": "$msCompile",
            "type": "process"
        },
        {
            "args": [
                "build",
                "${workspaceFolder}/Fenicia.slnx",
                "--configuration",
                "Debug",
                "--no-restore",
                "-warnaserror"
            ],
            "command": "dotnet",
            "group": {
                "isDefault": true,
                "kind": "test"
            },
            "label": "Fenicia: Full Build + Warnings",
            "problemMatcher": "$msCompile",
            "type": "process"
        }
    ],
    "version": "2.0.0"
}
