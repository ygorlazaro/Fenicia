@using Fenicia.Common.Enums.Basic
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar

<MudDialog @bind-Visible="Visible" Options="@DialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsEdit ? "Editar Movimentação" : "Nova Movimentação")</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="8">
                <MudSelect T="Guid" @bind-Value="Model.ProductId" Label="Produto" Variant="Variant.Outlined"
                           Required="true" RequiredError="Selecione um produto!">
                    @foreach (var p in Products)
                    {
                        <MudSelectItem T="Guid" Value="@p.Id">@p.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="EnumStockMovementType" @bind-Value="Model.Type" Label="Tipo" Variant="Variant.Outlined"
                           Required="true">
                    <MudSelectItem T="EnumStockMovementType" Value="EnumStockMovementType.In">Entrada</MudSelectItem>
                    <MudSelectItem T="EnumStockMovementType" Value="EnumStockMovementType.Out">Saída</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField T="double" @bind-Value="Model.Quantity" Label="Quantidade" Variant="Variant.Outlined"
                                 Min="0" Required="true" RequiredError="Quantidade é obrigatória!" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField T="decimal" @bind-Value="Model.Price" Label="Preço unitário" Variant="Variant.Outlined"
                                 Min="0" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudDatePicker @bind-Date="Model.Date" Label="Data" Variant="Variant.Outlined" />
            </MudItem>
            @if (Model.Type == EnumStockMovementType.In)
            {
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" @bind-Value="Model.SupplierId" Label="Fornecedor" Variant="Variant.Outlined"
                               Clearable="true">
                        @foreach (var s in Suppliers)
                        {
                            <MudSelectItem T="Guid?" Value="@s.Id">@s.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            else
            {
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" @bind-Value="Model.CustomerId" Label="Cliente" Variant="Variant.Outlined"
                               Clearable="true">
                        @foreach (var c in Customers)
                        {
                            <MudSelectItem T="Guid?" Value="@c.Id">@c.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid?" @bind-Value="Model.EmployeeId" Label="Funcionário" Variant="Variant.Outlined"
                           Clearable="true">
                    @foreach (var e in Employees)
                    {
                        <MudSelectItem T="Guid?" Value="@e.Id">@e.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="Model.Reason" Label="Motivo" Variant="Variant.Outlined" Lines="2" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnClose" Variant="Variant.Text">Cancel</MudButton>
        <MudButton OnClick="OnSubmit" Variant="Variant.Filled" Color="Color.Primary" Disabled="IsSubmitting">
            @if (IsSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Default" Class="mr-2" />
            }
            @(IsEdit ? "Atualizar" : "Registrar")
        </MudButton>
    </DialogActions>
</MudDialog>
