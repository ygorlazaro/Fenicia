<MudTextField @bind-Value="SearchText"
              Label="Pesquisar"
              Placeholder="Digite para pesificar..."
              Variant="Variant.Outlined"
              Size="Size.Small"
              DebounceInterval="300"
              Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search"
              Class="mb-4" />

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudGrid Spacing="2" AlignItems="AlignItems.Center">
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker @bind-Date="StartDate" Label="Data inicial" Variant="Variant.Outlined" Clearable="true" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker @bind-Date="EndDate" Label="Data final" Variant="Variant.Outlined" Clearable="true" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="TypeFilter" @bind-Value="TypeFilter" Label="Tipo" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                <MudSelectItem T="TypeFilter" Value="TypeFilter.All">Todos</MudSelectItem>
                <MudSelectItem T="TypeFilter" Value="TypeFilter.In">Entrada</MudSelectItem>
                <MudSelectItem T="TypeFilter" Value="TypeFilter.Out">Saída</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FilterList" OnClick="OnFilter" Disabled="Loading" FullWidth="true">
                Filtrar
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>
