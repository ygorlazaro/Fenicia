@code {
    [Parameter]
    public GetAllProductCategoryResponse Item { get; set; } = null!;

    [Parameter]
    public EventCallback OnEdit { get; set; }

    [Parameter]
    public EventCallback OnDelete { get; set; }
}

<MudTd DataLabel="Ações" Class="product-category-actions-cell">
    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small"
                   OnClick="@(() => OnEdit.InvokeAsync(Item))" />
    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                   OnClick="@(() => OnDelete.InvokeAsync(Item))" />
</MudTd>
<MudTd DataLabel="Nome">@Item.Name</MudTd>
<MudTd DataLabel="Produtos" Class="product-category-link-cell">
    <MudLink Href="@($"/basic/product?filters%5BCategoryId%5D={Item.Id}")" Typo="Typo.body2"
             Underline="Underline.Always">Ver produtos</MudLink>
</MudTd>
