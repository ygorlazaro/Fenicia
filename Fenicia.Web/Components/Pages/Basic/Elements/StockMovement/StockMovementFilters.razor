<MudTextField @bind-Value="SearchText"
              Label="Pesquisar"
              Placeholder="Digite para pesquisar..."
              Variant="Variant.Outlined"
              Size="Size.Small"
              DebounceInterval="300"
              Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search"
              Class="mb-4" />

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudGrid Spacing="2" AlignItems="AlignItems.Centered">
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker @bind-Date="StartDate" Label="Data inicial" Variant="Variant.Outlined" Clearable="true" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker @bind-Date="EndDate" Label="Data final" Variant="Variant.Outlined" Clearable="true" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="string" @bind-Value="Filter" Label="Tipo" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                <MudSelectItem T="string" Value="@("All")">Todos</MudSelectItem>
                <MudSelectItem T="string" Value="@("In")">Entrada</MudSelectItem>
                <MudSelectItem T="string" Value="@("Out")">Saída</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FilterList" OnClick="OnFilter" Disabled="Loading" FullWidth="true">
                Filtrar
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    [Parameter]
    public string SearchText { get; set; } = string.Empty;

    [Parameter]
    public DateTime? StartDate { get; set; }

    [Parameter]
    public DateTime? EndDate { get; set; }

    [Parameter]
    public string Filter { get; set; } = "All";

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public EventCallback OnFilter { get; set; }
}