@inject NavigationManager NavigationManager
@using Fenicia.Common.DTOs.Basic.Order
@using Fenicia.Common.Enums.Auth
@using Fenicia.Common.Enums.Basic
@using Fenicia.Web.Components.Shared

@code {
    [Parameter]
    public GetOrderByIdResponse Order { get; set; } = default!;

    public string StatusColor(string status) => "Info";

    [Parameter]
    public EventCallback OnPrint { get; set; }
}

<MudPaper Elevation="2" Class="pa-4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3 flex-wrap">
        <div>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                               Color="Color.Default"
                               OnClick="@(() => NavigationManager.NavigateTo("/basic/order"))" />
                <div>
                    <MudText Typo="Typo.h5">Pedido @Order.OrderNumber</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Default">
                        Realizado em @Order.SaleDate.ToString("dd/MM/yyyy HH:mm")
                    </MudText>
                </div>
            </MudStack>
        </div>
        <MudStack Row="true" Spacing="2">
            <MudChip T="string"
                     Color="Color.Info"
                     Variant="Variant.Filled"
                     Size="Size.Medium">
                @Order.Status
            </MudChip>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.Print"
                       OnClick="@OnPrint">
                Imprimir
            </MudButton>
        </MudStack>
    </MudStack>
</MudPaper>
