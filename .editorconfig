# .editorconfig raiz do monorepo Fenicia
# Vale para todos os projetos .NET abaixo desta pasta

root = true

[*.cs]

# ============================================================
# 1. ORDEM DE MÉTODOS/PROPRIEDADES POR ESCOPO DE VISIBILIDADE
# ============================================================
# SA1201: elementos devem seguir a ordem correta
#   (campos > construtores > propriedades > eventos > indexadores > métodos)
dotnet_diagnostic.SA1201.severity = error

# SA1202: dentro de cada tipo de elemento, ordenar por visibilidade
#   (public > internal > protected internal > protected > private)
dotnet_diagnostic.SA1202.severity = error

# SA1203: campos const devem vir antes de campos não-const
dotnet_diagnostic.SA1203.severity = error

# SA1214: campos static readonly antes de campos de instância
dotnet_diagnostic.SA1214.severity = error

# ============================================================
# 2. BLOQUEAR USING NÃO UTILIZADO
# ============================================================
# IDE0005: using directive desnecessária (nativo do Roslyn)
dotnet_diagnostic.IDE0005.severity = error

# ============================================================
# 3. ORDENAÇÃO DE NAMESPACES (using directives)
# ============================================================
# System.* sempre primeiro, resto em ordem alfabética
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# SA1208: usings de System devem vir antes dos demais
dotnet_diagnostic.SA1208.severity = error
# SA1210: usings devem estar em ordem alfabética
dotnet_diagnostic.SA1210.severity = error
# SA1211: usings estáticos depois dos usings normais
dotnet_diagnostic.SA1211.severity = error

# ============================================================
# 4. OBRIGAR CHAVES SEMPRE (mesmo if/for de uma linha só)
# ============================================================
# IDE0011: adicionar chaves (nativo do Roslyn)
csharp_prefer_braces = true:error
# SA1503: chaves não podem ser omitidas
dotnet_diagnostic.SA1503.severity = error
# SA1519: chaves devem ser usadas em blocos com múltiplas linhas (reforça o SA1503)
dotnet_diagnostic.SA1519.severity = error

# ============================================================
# 5. NAMESPACE DEVE BATER COM A ESTRUTURA DE PASTAS
# ============================================================
# IDE0130: "Namespace does not match folder structure" (nativo do Roslyn)
dotnet_diagnostic.IDE0130.severity = error

# ============================================================
# Regras de estilo StyleCop que geram muito ruído em projeto
# existente e não pediu — desligadas de propósito
# ============================================================
# SA1200 (using deve ficar DENTRO do namespace) — conflita com file-scoped
# namespaces (namespace X;), que vocês já usam no projeto. Desligado.
dotnet_diagnostic.SA1200.severity = none

# SA1600 (exigir XML doc em tudo) — desligado, muito verboso pra esse estágio
dotnet_diagnostic.SA1600.severity = none

# SA0001 (XML comment analysis disabled) — desligado, não queremos documentação XML obrigatória
dotnet_diagnostic.SA0001.severity = none

# IDE0005 (usings desnecessários) — desligado, depende de GenerateDocumentationFile
dotnet_diagnostic.IDE0005.severity = none

# ============================================================
# 6. CONSISTÊNCIA COM SEU ESTILO JÁ EM USO (novo, baseado no código atual)
# ============================================================

# IDE0161: obriga file-scoped namespace (namespace X;) em vez do formato
# tradicional com chaves — você já usa esse estilo, isso trava pra sempre
csharp_style_namespace_declarations = file_scoped:error

# IDE0290: sugere primary constructor quando o construtor só atribui campos
# — você já usa esse padrão (ex: CompanyContext), fica consistente
csharp_style_prefer_primary_constructors = true:error

# IDE0007/IDE0008: usar "var" sempre que o tipo for óbvio pelo lado direito
# — já é seu padrão em todo o código que vi
csharp_style_var_for_built_in_types = true:error
csharp_style_var_when_type_is_apparent = true:error
csharp_style_var_elsewhere = true:error

# CA1852: sela classes internas que não foram desenhadas pra herança
# — reduz superfície de API não intencional, sem custo nenhum
dotnet_diagnostic.CA1852.severity = error

# CA1031: não capturar Exception genérica sem tratamento específico
# — seu código já lança exceções específicas (InvalidOperationException,
# FileNotFoundException); reforça esse hábito nos catches também
dotnet_diagnostic.CA1031.severity = error

# CA2201: não lançar tipos de exceção reservados/genéricos demais
# (Exception, SystemException) direto — force um tipo mais específico
dotnet_diagnostic.CA2201.severity = error

# Nomeação de campos privados: força o padrão _camelCase
# (convenção moderna do .NET, combina com o restante do seu estilo)
dotnet_naming_rule.private_fields_underscore.severity = error
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
# SA1309 proibia underscore em campo privado — precisa desligar pra combinar
# com a regra acima (senão as duas regras se contradizem)
dotnet_diagnostic.SA1309.severity = none

# SA1413: exigiria vírgula "sobrando" após o último item em inicializadores
# multi-linha (arrays, objetos, enums). Explicitamente desligada — você não
# gosta de trailing comma.
dotnet_diagnostic.SA1413.severity = none

# Métodos assíncronos devem terminar com "Async" (convenção .NET oficial)
dotnet_naming_rule.async_methods_end_in_async.severity = error
dotnet_naming_rule.async_methods_end_in_async.symbols = async_methods
dotnet_naming_rule.async_methods_end_in_async.style = end_in_async
dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.end_in_async.required_suffix = Async
# SA1101 (prefixar chamadas com this.) — estilo pessoal, desligado
dotnet_diagnostic.SA1101.severity = none
# SA1633 (exigir cabeçalho de licença em cada arquivo) — desligado
dotnet_diagnostic.SA1633.severity = none

# ============================================================
# 7. EXCLUIR CÓDIGOS GERADOS (migrations, designers, snapshots)
# ============================================================

# SA1602: Enumeration items should be documented
dotnet_diagnostic.SA1602.severity = none

# Default severity for analyzer diagnostics with category 'StyleCop.CSharp.DocumentationRules'
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.DocumentationRules.severity = none

# Suppress noisy CA rules that conflict with EF Core or existing patterns
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA2227.severity = none
dotnet_diagnostic.CA1002.severity = none
dotnet_diagnostic.CA1056.severity = none
dotnet_diagnostic.CA1805.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1716.severity = none
